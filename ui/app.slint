                                        pointer-event(event) => { root.active-panel = 3; keys.focus(); if (event.kind == PointerEventKind.down) { root.timeline(0, 0, self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control); } if (event.kind == PointerEventKind.up) { root.timeline(0, 2, self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control); } if (event.kind == PointerEventKind.cancel) { root.timeline(0, 3, self.mouse-x / 1px, self.mouse-y / 1px, false, false); } }
                                        moved => { if (self.pressed) { root.timeline(0, 1, self.mouse-x / 1px, self.mouse-y / 1px, false, false); } }
                                        scroll-event(event) => { root.wheel(event.delta-y / 1px, self.mouse-x / 1px, event.modifiers.control); accept }
                                    }
                                    for note in root.review-markers: Rectangle {
                                        x: note.x * 1px - 3px; y: 13px; width: 6px; height: 7px;
                                        background: note.resolved ? Palette.text-disabled : Palette.accent; border-radius: 1px;
                                        LiveTouchArea { mouse-cursor: pointer; clicked => { root.command("review-jump:" + note.id); } }
                                    }
                                }
                            }
                            time-area := Rectangle {
                                vertical-stretch: 1; background: Palette.bg0; clip: true; min-height: 140px;
                                changed width => { root.time-w = self.width; root.resized(root.view-w / 1px, root.view-h / 1px, root.timeline-px, self.height / 1px); }
                                changed height => { root.resized(root.view-w / 1px, root.view-h / 1px, root.timeline-px, self.height / 1px); }
                                HorizontalLayout { spacing: 0;
                                    Rectangle { width: 160px; background: Palette.bg2; clip: true;
                                        LiveTouchArea { scroll-event(event) => { root.scroll-tracks(event.delta-y / 1px, event.delta-x / 1px, 0, event.modifiers.control, event.modifiers.shift); accept } }
                                        Rectangle { x: 159px; width: 1px; height: 100%; background: Palette.bg3; }
                                        for head in root.heads: Rectangle {
                                            y: (head.y - root.timeline-scroll-y) * 1px; height: max(head.h * 1px, 28px); width: 100%; background: head.selected ? Palette.accent-muted : Palette.bg2;
                                            head-touch := LiveTouchArea { clicked => { root.active-panel = 3; root.pick("track", head.index); keys.focus(); } scroll-event(event) => { root.scroll-tracks(event.delta-y / 1px, event.delta-x / 1px, 0, event.modifiers.control, event.modifiers.shift); accept } }
                                            Rectangle { y: (parent.height - 28px) / 2; height: 28px; width: 100%;
                                                HorizontalLayout { padding-left: 4px; spacing: 2px; alignment: start;
                                                    IconBtn { tooltip: head.video ? (head.muted ? "Show video track" : "Hide video track") : (head.muted ? "Unmute audio track" : "Mute audio track"); icon: head.video ? @image-url("icons/visibility.svg") : @image-url("icons/mute.svg"); armed: head.muted; clicked => { root.active-panel = 3; root.pick("mute", head.index); keys.focus(); } }
                                                    if !head.video: TextBtn { label: "S"; width: 26px; tooltip: head.solo ? "Unsolo track" : "Solo track"; background: head.solo ? Palette.accent-muted : Palette.bg2; clicked => { root.active-panel = 3; root.pick("solo", head.index); keys.focus(); } }
                                                    IconBtn { tooltip: head.locked ? "Unlock track" : "Lock track"; icon: @image-url("icons/lock.svg"); armed: head.locked; clicked => { root.active-panel = 3; root.pick("lock", head.index); keys.focus(); } }
                                                    Text { text: head.name; color: Palette.text-primary; font-size: 12px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: Palette.bg1; clip: true;

for lane in root.lanes: Rectangle { y: (lane.y - root.timeline-scroll-y) * 1px; height: max(lane.h * 1px, 28px); width: 100%; background: lane.video ? #222426 : #20231F; Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: #343438; } }
                                if !root.has-clips: Text { text: "Drag media onto a track to start editing."; x: 16px; y: parent.height * 0.35; width: parent.width - 32px; height: 48px; wrap: word-wrap; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                        for clip in root.clips: Rectangle {
