                        Rectangle { x: parent.width - 10px; y: 64px; width: 10px; height: parent.height - 196px; visible: export-scroll.content-height > export-scroll.height;
                            property <length> thumb-height: max(26px, self.height * export-scroll.height / max(1px, export-scroll.content-height));
                            property <length> thumb-y: (self.height - self.thumb-height) * -export-scroll.content-y / max(1px, export-scroll.content-height - export-scroll.height);
                            Rectangle { x: 3px; y: parent.thumb-y; width: 4px; height: parent.thumb-height; border-radius: 2px; background: export-scroll-touch.has-hover ? Palette.text-secondary : Palette.text-disabled; }
                            export-scroll-touch := LiveTouchArea {
                                mouse-cursor: pointer;
                                property <length> start-y;
                                property <length> start-scroll;
                                pointer-event(event) => { if (event.kind == PointerEventKind.down) {
                                    if (self.mouse-y < parent.thumb-y || self.mouse-y > parent.thumb-y + parent.thumb-height) { export-scroll.content-y = -max(0px, min(export-scroll.content-height - export-scroll.height, (self.mouse-y - parent.thumb-height / 2) / max(1px, parent.height - parent.thumb-height) * (export-scroll.content-height - export-scroll.height))); }
                                    self.start-y = self.mouse-y; self.start-scroll = export-scroll.content-y;
                                } }
                                moved => { if (self.pressed) { export-scroll.content-y = max(export-scroll.height - export-scroll.content-height, min(0px, self.start-scroll - (self.mouse-y - self.start-y) / max(1px, parent.height - parent.thumb-height) * (export-scroll.content-height - export-scroll.height))); } }
                                scroll-event(event) => { export-scroll.content-y = max(export-scroll.height - export-scroll.content-height, min(0px, export-scroll.content-y + event.delta-y)); accept }
