                        selected-count: root.project-selected-count; sort-column: root.media-sort-column; sort-descending: root.media-sort-descending;
                        select-media(id, ctrl, shift) => { root.select-media(id, ctrl, shift); } sort-media(column) => { root.sort-media(column); }
