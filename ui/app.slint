                                            pointer-event(event) => { root.active-panel = 3; keys.focus(); if (event.kind == PointerEventKind.down) { root.razor-track-pressed = true; root.timeline(1, 0, self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control); } if (event.kind == PointerEventKind.up) { root.razor-track-pressed = false; root.timeline(1, 2, self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control); } if (event.kind == PointerEventKind.cancel) { root.razor-track-pressed = false; root.razor-track-hover = false; root.timeline(1, 3, self.mouse-x / 1px, self.mouse-y / 1px, false, false); } }
                                            changed has-hover => { root.razor-track-hover = self.has-hover; root.razor-hover(self.has-hover, self.mouse-x / 1px, self.mouse-y / 1px); }
                                            moved => { root.razor-track-hover = self.has-hover; root.razor-track-pressed = self.pressed; if (self.pressed) { root.timeline(1, 1, self.mouse-x / 1px, self.mouse-y / 1px, false, false); } else { root.razor-hover(true, self.mouse-x / 1px, self.mouse-y / 1px); } }
                                            scroll-event(event) => { root.scroll-tracks(event.delta-y / 1px, event.delta-x / 1px, self.mouse-x / 1px, event.modifiers.control, event.modifiers.shift); accept }
                                        }
                                    }
                                    Rectangle {
                                        width: root.track-scrollbar-width; background: Palette.bg0; clip: true;
                                        property <length> thumb-height: min(self.height, max(28px, self.height * root.body-px / max(1, root.tracks-h)));
                                        property <length> thumb-y: (self.height - self.thumb-height) * root.timeline-scroll-y / max(1, root.track-scroll-max);
                                        Rectangle { x: 3px; y: parent.thumb-y; width: 8px; height: parent.thumb-height; border-radius: 4px; background: track-scroll-touch.pressed ? Palette.accent : track-scroll-touch.has-hover ? Palette.text-secondary : Palette.bg3; }
                                        track-scroll-touch := LiveTouchArea {
                                            enabled: root.track-scroll-max > 0.5; mouse-cursor: pointer;
                                            property <length> start-y;
                                            property <float> start-scroll;
                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.down) {
                                                    root.active-panel = 3; keys.focus();
                                                    if (self.mouse-y < parent.thumb-y || self.mouse-y > parent.thumb-y + parent.thumb-height) {
                                                        root.track-scroll-position = max(0, min(root.track-scroll-max, (self.mouse-y - parent.thumb-height / 2) / max(1px, parent.height - parent.thumb-height) * root.track-scroll-max));
                                                    }
                                                    self.start-y = self.mouse-y; self.start-scroll = root.timeline-scroll-y;
                                                }
                                            }
                                            moved => { if (self.pressed) { root.track-scroll-position = max(0, min(root.track-scroll-max, self.start-scroll + (self.mouse-y - self.start-y) / max(1px, parent.height - parent.thumb-height) * root.track-scroll-max)); } }
                                            scroll-event(event) => { root.scroll-tracks(event.delta-y / 1px, event.delta-x / 1px, root.timeline-px, event.modifiers.control, event.modifiers.shift); accept }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
                }

                if root.page == 1: Rectangle {
                    width: parent.width; height: parent.height; background: Palette.bg0;
                    property <length> queue-width: min(320px, self.width * 0.24);
                    property <length> settings-width: min(380px, self.width * 0.31);
                    Rectangle { x: 0px; y: 0px; width: parent.queue-width; height: 100%; background: Palette.bg1;
                        VerticalLayout { spacing: 0;
                            PanelHead { label: "Render queue"; detail: root.queue-items.length == 0 ? "" : "" + root.queue-items.length + " jobs"; }
                            Rectangle { height: 36px; background: Palette.bg1;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; alignment: start;
                                    TextBtn { label: "Start queue"; enabled: root.queue-pending && !root.export-busy; clicked => { root.command("render-queue"); } }
                                }
                            }
                            Rectangle { vertical-stretch: 1; min-height: 0px; clip: true;
                                if root.queue-items.length == 0: VerticalLayout { padding: 16px; spacing: 8px; alignment: center;
                                    Text { text: "No queued exports"; color: Palette.text-primary; font-size: 13px; font-weight: 600; horizontal-alignment: center; }
                                    Text { text: "Choose your settings, then add an export to the queue. Each job keeps its own edit and settings."; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
                                    Rectangle { vertical-stretch: 1; }
                                }
                                if root.queue-items.length > 0: Flickable {
                                    width: 100%; height: 100%; viewport-width: self.width; viewport-height: max(self.height, queue-list.preferred-height);
                                    queue-list := VerticalLayout { width: parent.width; spacing: 0; alignment: start;
                                        for job in root.queue-items: Rectangle { height: 112px; background: Palette.bg1;
                                            Rectangle { x: 0px; y: parent.height - 1px; width: 100%; height: 1px; background: Palette.bg3; }
                                            VerticalLayout { padding: 8px; spacing: 3px;
                                                Text { text: job.name; color: Palette.text-primary; font-weight: 600; font-size: 12px; overflow: elide; height: 18px; }
                                                Text { text: job.output; color: Palette.text-secondary; font-size: 11px; overflow: elide; height: 18px; }
                                                TextBtn { label: job.status; tooltip: "View full export details"; height: 22px; horizontal-stretch: 1; min-width: 0px; clicked => { root.export-details = job.status; root.show-export-details = true; } }
                                                HorizontalLayout { alignment: start; spacing: 8px;
                                                    if job.retryable: TextBtn { label: "Retry"; clicked => { root.pick("queue-retry", job.id); } }
                                                    TextBtn { label: "Remove"; enabled: job.removable; clicked => { root.pick("queue-remove", job.id); } }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle { height: 44px; background: Palette.bg2;
                                HorizontalLayout { padding-left: 8px; alignment: start;
                                    TextBtn { label: "Clear finished jobs"; enabled: root.queue-has-finished; clicked => { root.command("clear-completed"); } }
                                }
                            }
                        }
                    }
                    Rectangle { x: parent.queue-width + 5px; y: 0px; width: parent.width - parent.queue-width - parent.settings-width - 10px; height: 100%; background: Palette.bg1;
                        VerticalLayout { spacing: 0;
                            PanelHead { label: "Preview"; detail: root.seq-name; }
                            export-frame := Rectangle { vertical-stretch: 1; min-height: 100px; background: Palette.bg0; clip: true;
                                if root.show-picture && root.has-clips: Image { width: 100%; height: 100%; source: root.viewer-image; image-fit: contain; horizontal-alignment: center; vertical-alignment: center; preferred-width: 0px; preferred-height: 0px; }
                                PreviewContext { available-width: parent.width; available-height: parent.height; preparing: root.program-preparing; problem: root.program-problem; }
                                if !root.has-clips: VerticalLayout { padding: 24px; alignment: center; spacing: 8px;
                                    Rectangle { vertical-stretch: 1; }
                                    Text { text: "Nothing to export yet"; color: Palette.text-primary; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
                                    Text { text: "Add media to the timeline to prepare an export."; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
                                    HorizontalLayout { alignment: center; SecBtn { label: "Return to Edit"; clicked => { root.command("workspace-edit"); } } }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                            Rectangle { height: 24px; background: Palette.bg2;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px;
                                    TcRun { cells: root.program-tc; main: false; ink: Palette.accent; }
                                    Rectangle { horizontal-stretch: 1; }
                                    TcRun { cells: root.duration-tc; main: false; ink: Palette.text-secondary; }
                                }
                            }
                            Rectangle { height: 34px; background: Palette.bg2;
                                HorizontalLayout { spacing: 4px; alignment: center;
                                    IconBtn { enabled: root.has-clips; icon: @image-url("icons/step-back.svg"); tooltip: "Previous frame · " + root.shortcut-hint("step-back", root.shortcut-revision); clicked => { root.active-panel = 1; root.command("step-back"); } }
                                    PlayBtn { enabled: root.has-clips; stopped: root.shuttle == "STOP"; tooltip: "Play / pause · " + root.shortcut-hint("play-toggle", root.shortcut-revision); clicked => { root.active-panel = 1; root.command("play-toggle"); } }
                                    IconBtn { enabled: root.has-clips; icon: @image-url("icons/step-forward.svg"); tooltip: "Next frame · " + root.shortcut-hint("step-fwd", root.shortcut-revision); clicked => { root.active-panel = 1; root.command("step-fwd"); } }
                                }
                            }
                            Rectangle { height: 106px; background: Palette.bg1;
                                VerticalLayout { padding: 12px; spacing: 6px; alignment: start;
                                    Text { text: "Output summary"; color: Palette.text-primary; font-size: 12px; font-weight: 600; height: 20px; }
                                    Text { text: "H.264 / MP4 · " + root.export-width + " × " + root.export-height + " · " + root.export-rates[root.export-fps].text + " fps"; color: Palette.text-secondary; font-size: 12px; height: 20px; overflow: elide; }
                                    Text { text: root.export-inout ? "Range: In / Out" : "Range: Entire sequence"; color: Palette.text-secondary; font-size: 12px; height: 20px; }
                                }
                            }
                        }
                    }
                    Rectangle { x: parent.width - parent.settings-width; y: 0px; width: parent.settings-width; height: 100%; background: Palette.bg1;
                        PanelHead { x: 0px; y: 0px; width: 100%; label: "Export settings"; }
                        export-scroll := Flickable { x: 0px; y: 30px; width: parent.width - 8px; height: parent.height - 118px; viewport-width: self.width; viewport-height: max(self.height, export-settings.preferred-height);
                            export-settings := VerticalLayout { padding: 8px; spacing: 6px; alignment: start; width: parent.width;
                            HorizontalLayout { spacing: 8px; alignment: start;
                                TextBtn { label: "Presets"; dropdown: true; expanded: root.export-presets-open; enabled: !root.export-busy; clicked => { root.export-presets-open = !root.export-presets-open; } }
                                TextBtn { label: "Match sequence"; enabled: !root.export-busy; tooltip: "Use sequence dimensions and frame rate. Keeps your encoding quality and speed."; clicked => { root.command("preset-match"); } }
                            }
                            if root.export-presets-open: VerticalLayout { spacing: 0;
                                MenuEntry { label: "Balanced · default"; clicked => { root.command("preset-medium"); root.export-presets-open = false; } }
                                MenuEntry { label: "High quality"; clicked => { root.command("preset-high"); root.export-presets-open = false; } }
                                MenuEntry { label: "Speed first · larger files"; clicked => { root.command("preset-fast"); root.export-presets-open = false; } }
                                MenuEntry { label: "Smaller files"; clicked => { root.command("preset-compact"); root.export-presets-open = false; } }
                                MenuEntry { label: "Match sequence"; clicked => { root.command("preset-match"); root.export-presets-open = false; } }
                            }
                            SetRow { label: "Format"; value: "H.264"; }
                            SetRow { label: "Container"; value: "MP4"; }
                            Rectangle { height: 28px;
                                Text { text: "Render mode"; x: 0px; y: 0px; width: 108px; height: 100%; color: Palette.text-secondary; font-size: 12px; vertical-alignment: center; }
                                ChoiceButton { x: 116px; width: parent.width - 116px; choices: [{text: "Balanced"}, {text: "Speed first"}, {text: "Smaller files"}]; selected: root.export-speed; enabled: !root.export-busy; chosen(index) => { root.export-speed = index; } }
                            }
                            Text { text: root.export-speed == 1 ? "Faster encoding can produce larger files." : root.export-speed == 2 ? "More encoding work improves compression." : "Good picture quality with responsive rendering."; color: Palette.text-secondary; font-size: 12px; height: 32px; wrap: word-wrap; }
                            Rectangle { height: 28px;
                                Text { text: "Encoder"; x: 0px; y: 0px; width: 108px; height: 100%; color: Palette.text-secondary; font-size: 12px; vertical-alignment: center; }
                                ChoiceButton { x: 116px; width: parent.width - 116px; choices: [{text: "Auto · hardware when available"}, {text: "CPU · software"}, {text: "GPU · hardware required"}]; selected: root.export-encoder; enabled: !root.export-busy; chosen(index) => { root.export-encoder = index; } }
                            }
                            Text { text: root.export-encoder == 1 ? "Uses the CPU software encoder." : root.export-encoder == 2 ? "Requires a working GPU encoder. Effects may still use the CPU. Fails if GPU encoding is unavailable." : "Auto uses a verified hardware encoder when available, with CPU fallback."; color: Palette.text-secondary; font-size: 12px; height: root.export-encoder == 1 ? 20px : root.export-encoder == 2 ? 52px : 36px; wrap: word-wrap; }
                            SectionHead { label: "Video"; }
                            Rectangle { height: 28px;
                                Text { text: "Width"; x: 0px; y: 0px; width: 108px; height: 28px; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: left; vertical-alignment: center; }
                                Field { x: 116px; y: 0px; width: parent.width - 116px; value <=> root.export-width; }
                            }
                            Rectangle { height: 28px;
                                Text { text: "Height"; x: 0px; y: 0px; width: 108px; height: 28px; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: left; vertical-alignment: center; }
                                Field { x: 116px; y: 0px; width: parent.width - 116px; value <=> root.export-height; }
                            }
                            Rectangle { height: 28px;
                                Text { text: "Frame rate"; x: 0px; y: 0px; width: 108px; height: 100%; color: Palette.text-secondary; font-size: 12px; vertical-alignment: center; }
                                ChoiceButton { x: 116px; width: parent.width - 116px; choices: root.export-rates; suffix: " fps"; selected: root.export-fps; enabled: !root.export-busy; chosen(index) => { root.export-fps = index; } }
                            }
                            Rectangle { height: 28px;
                                Text { text: "Range"; x: 0px; width: 108px; height: 100%; color: Palette.text-secondary; font-size: 12px; vertical-alignment: center; }
                                ChoiceButton { x: 116px; width: parent.width - 116px; choices: [{text: "Entire sequence"}, {text: "In / Out"}]; selected: root.export-inout ? 1 : 0; enabled: !root.export-busy; chosen(index) => { root.export-inout = index == 1; } }
                            }
                            SetRow { label: "Quality target"; value: root.export-crf <= 18.5 ? "High" : root.export-crf < 23 ? "Balanced" : "Standard"; }
                            if root.export-encoder == 1: SetRow { label: "CRF"; value: root.read-crf; }
                            if root.export-encoder != 1: Text { text: "Quality targets vary by encoder."; color: Palette.text-secondary; font-size: 12px; height: 20px; wrap: word-wrap; }
                            SectionHead { label: "Destination"; }
                            Rectangle { height: 28px;
                                Text { text: "Output name"; x: 0px; y: 0px; width: 108px; height: 28px; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                Field { x: 116px; y: 0px; width: parent.width - 116px; value <=> root.export-path; }
                            }
                            Rectangle { height: 28px;
                                SecBtn { x: 116px; y: 0px; label: "Browse"; clicked => { root.command("browse-export"); } }
                            }
                            }
                        }
                        Rectangle { x: parent.width - 8px; y: 30px; width: 8px; height: parent.height - 118px; background: Palette.bg0;
                            visible: export-scroll.viewport-height > export-scroll.height;
                            Rectangle { x: 2px; width: 4px; border-radius: 2px; background: Palette.text-disabled;
                                height: max(24px, parent.height * export-scroll.height / max(1px, export-scroll.viewport-height));
                                y: max(0px, min(parent.height - self.height, (parent.height - self.height) * -export-scroll.viewport-y / max(1px, export-scroll.viewport-height - export-scroll.height)));
                            }
                        }
                        Rectangle { x: 0px; y: parent.height - 88px; width: 100%; height: 88px; background: Palette.bg2;
                            Rectangle { x: 8px; y: 8px; width: parent.width - 16px; height: 3px; background: Palette.bg3;
                                Rectangle { x: 0px; y: 0px; width: parent.width * min(1, max(0, root.export-shown-progress)); height: 100%; background: Palette.accent; }
                            }
                            Rectangle { x: 8px; y: 16px; width: parent.width - 16px; height: 20px;
                                Rectangle { x: 0px; y: 0px; width: max(0px, parent.width - (root.export-busy ? (root.export-preparing ? 89px : 42px) : 0px) - (root.export-busy && root.export-eta != "" ? 122px : 0px)); height: 100%; clip: true;
                                    Text { x: 0px; y: 0px; width: 100%; height: 100%; text: root.export-message; color: Palette.text-secondary; font-size: 11px; overflow: elide; horizontal-alignment: left; vertical-alignment: center; }
                                }
                                if root.export-busy && root.export-eta != "": Text { x: max(0px, parent.width - 164px); width: min(118px, parent.width); height: 100%; text: root.export-eta; color: Palette.text-secondary; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                if root.export-busy: Text { x: parent.width - self.width; width: root.export-preparing ? 85px : 38px; height: 100%; text: (root.export-preparing ? root.export-preparation-label + " " : "") + root.export-percent + "%"; color: Palette.text-primary; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                                LiveTouchArea {
                                    property <string> shown-message: "";
                                    mouse-cursor: pointer;
                                    clicked => { root.export-details = root.export-message; root.show-export-details = true; }
                                    changed has-hover => {
                                        if (self.has-hover && root.export-message != "") {
                                            self.shown-message = root.export-message;
                                            ToolHints.text = "Click to view export details\n" + self.shown-message;
                                            ToolHints.x = self.absolute-position.x + self.width / 2;
                                            ToolHints.y = self.absolute-position.y + self.height + 5px;
                                            ToolHints.shown = true;
                                        } else if (ToolHints.text == "Click to view export details\n" + self.shown-message) { ToolHints.shown = false; }
                                    }
                                }
                            }
                            HorizontalLayout { y: 44px; height: 36px; padding-left: 8px; padding-right: 8px; spacing: 6px;
                                SecBtn { label: "Add to queue"; enabled: root.has-clips; clicked => { root.command("add-to-queue"); } }
                                Rectangle { horizontal-stretch: 1; }
                                if root.export-busy: SecBtn { label: root.export-cancelling ? "Cancelling…" : "Cancel"; enabled: !root.export-cancelling; clicked => { root.command("cancel-render"); } }
                                PriBtn { label: root.export-busy ? "Rendering" : "Export now"; enabled: !root.export-busy && root.has-clips; clicked => { root.command("render"); } }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 22px; background: Palette.bg2; border-radius: 0px;
                Rectangle { height: 1px; width: 100%; background: Palette.bg3; }
                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 12px;
                    Text { text: root.sequence-label; color: Palette.text-primary; font-size: 11px; font-weight: 400; horizontal-alignment: left; vertical-alignment: center; }
                    if root.show-status-extra && !root.import-busy: Text { text: root.playback-label; color: Palette.text-secondary; font-size: 11px; horizontal-alignment: left; vertical-alignment: center; }
                    if !root.import-busy: Rectangle { width: root.preview-cache-status == "" ? 90px : 170px;
                        Text { width: parent.width - (root.preview-cache-status != "" && root.preview-cache-auto ? 62px : 0px); height: 100%; text: root.preview-cache-status == "" ? root.cache-label : root.preview-cache-label; color: Palette.text-secondary; font-size: 11px; vertical-alignment: center; overflow: elide; }
                        LiveTouchArea {
                            property <string> shown-message: "";
                            changed has-hover => {
                                if (self.has-hover && root.preview-cache-status != "") {
                                    self.shown-message = root.preview-cache-status;
                                    ToolHints.text = self.shown-message; ToolHints.x = self.absolute-position.x + self.width / 2; ToolHints.y = self.absolute-position.y - 56px; ToolHints.shown = true;
                                } else if (ToolHints.text == self.shown-message) { ToolHints.shown = false; }
                            }
                        }
                        if root.preview-cache-status != "" && root.preview-cache-auto: TextBtn { x: parent.width - 60px; y: 1px; width: 60px; height: 20px; label: root.preview-cache-paused ? "Resume" : "Pause"; tooltip: root.preview-cache-paused ? "Resume background preview preparation" : "Pause background preview preparation"; clicked => { root.preview-cache-paused = !root.preview-cache-paused; root.preview-cache-settings(); } }
                    }
                    Text { text: root.import-busy ? root.import-status : root.status-text; color: Palette.text-primary; font-size: 11px; min-width: 0px; horizontal-stretch: 1; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                    if root.import-busy: Rectangle { width: 90px; height: 4px; border-radius: 2px; background: Palette.bg3;
                        Rectangle { width: parent.width * max(0, min(1, root.import-progress)); height: 100%; border-radius: 2px; background: Palette.accent; }
                    }
                    if root.import-busy: TextBtn { label: "Cancel import"; height: 20px; clicked => { root.command("import-cancel"); } }
                    if root.live-preview: Text {
                        text: root.live-status == "" ? "Live" : root.live-status;
                        color: root.live-update-blocked ? Palette.status-warning : root.live-update-pending ? Palette.accent : Palette.text-secondary;
                        font-size: 11px; width: min(360px, root.width * 0.27);
                        horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                    }
                    Text { text: root.app-version; color: Palette.text-disabled; font-size: 11px; horizontal-alignment: left; vertical-alignment: center; }
                }
            }
        }

        if root.open-menu != 0 || root.filter-open || root.quality-open: LiveTouchArea { x: 0px; y: 0px; width: 100%; height: 100%; z: 2; clicked => { root.open-menu = 0; root.filter-open = false; root.quality-open = false; keys.focus(); } }
        if root.open-menu == 1: KeyboardMenu { x: min(0px, root.width - self.width - 8px); y: 30px; z: 3; width: min(300px, root.width - 16px); menu-id: 1;
            items: [
                {label: "New project", hint: root.shortcut-hint("new", root.shortcut-revision), enabled: true, divider: false},
                {label: "Open project", hint: root.shortcut-hint("open", root.shortcut-revision), enabled: true, divider: false},
                {label: "Save", hint: root.shortcut-hint("save", root.shortcut-revision), enabled: true, divider: false},
                {label: "Save as", hint: root.shortcut-hint("save-as", root.shortcut-revision), enabled: true, divider: false},
                {label: "Import media", hint: root.shortcut-hint("import", root.shortcut-revision), enabled: true, divider: false},
                {label: "Import Premiere / Resolve timeline…", hint: root.shortcut-hint("import-timeline", root.shortcut-revision), enabled: true, divider: false},
                {label: "Relink selected media…", hint: "", enabled: true, divider: false},
                {label: "Export", hint: root.shortcut-hint("export-view", root.shortcut-revision), enabled: true, divider: true},
                {label: "Quit", hint: root.shortcut-hint("quit", root.shortcut-revision), enabled: true, divider: true}
            ];
            dismissed => { root.open-menu = 0; keys.focus(); }
            adjacent(direction) => { root.open-menu = root.open-menu + direction < 1 ? 9 : root.open-menu + direction > 9 ? 1 : root.open-menu + direction; }
            activated(index) => { keys.focus();
                if (index == 0) { root.open-menu = 0; root.command("new"); }
                if (index == 1) { root.open-menu = 0; root.command("open"); }
                if (index == 2) { root.open-menu = 0; root.command("save"); }
                if (index == 3) { root.open-menu = 0; root.command("save-as"); }
                if (index == 4) { root.open-menu = 0; root.command("import"); }
                if (index == 5) { root.open-menu = 0; root.command("import-timeline"); }
                if (index == 6) { root.open-menu = 0; root.command("relink-media"); }
                if (index == 7) { root.open-menu = 0; root.command("export-view"); }
                if (index == 8) { root.open-menu = 0; root.command("quit"); }
            }
        }
        if root.open-menu == 2: KeyboardMenu { x: min(48px, root.width - self.width - 8px); y: 30px; z: 3; width: min(300px, root.width - 16px); menu-id: 2;
            items: [
                {label: "Undo", hint: root.can-undo ? root.shortcut-hint("undo", root.shortcut-revision) : "Nothing to undo", enabled: root.can-undo, divider: false},
                {label: "Redo", hint: root.can-redo ? root.shortcut-hint("redo", root.shortcut-revision) : "Nothing to redo", enabled: root.can-redo, divider: false},
                {label: "Copy", hint: root.shortcut-hint("copy", root.shortcut-revision), enabled: true, divider: true},
                {label: "Paste", hint: root.shortcut-hint("paste", root.shortcut-revision), enabled: true, divider: false},
