                                    Rectangle {
                                        x: 2px; width: 4px; background: Palette.bg3;
                                        height: insp-scroll.content-height <= insp-scroll.height ? parent.height : max(24px, parent.height * insp-scroll.height / insp-scroll.content-height);
                                        y: insp-scroll.content-height <= insp-scroll.height ? 0px : (parent.height - self.height) * -insp-scroll.content-y / (insp-scroll.content-height - insp-scroll.height);
