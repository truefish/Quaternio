                                            background: clip.still ? (clip.selected ? Palette.clip-still-on : Palette.clip-still) : clip.video ? (clip.selected ? Palette.clip-video-on : Palette.clip-video) : (clip.selected ? Palette.clip-audio-on : Palette.clip-audio);
                                            border-width: 1px; border-color: clip.selected ? #C9C2E5 : #161618;
                                            Rectangle { width: 100%; height: min(19px, parent.height); background: clip.selected ? #FFFFFF12 : #00000022; }
                                            if !clip.video && clip.waveform.width > 0: Image { x: clip.waveform-x * 1px; y: 20px; width: max(0px, clip.waveform-width * 1px); height: max(0px, parent.height - 22px); source: clip.waveform; image-fit: fill; preferred-width: 0px; preferred-height: 0px; }
                                            if clip.video && clip.filmstrip.width > 0: Image { x: clip.filmstrip-x * 1px; y: 20px; width: max(0px, clip.filmstrip-width * 1px); height: max(0px, parent.height - 20px); source: clip.filmstrip; image-fit: fill; preferred-width: 0px; preferred-height: 0px; opacity: clip.dim ? 0.5 : 1; }
                                            // Bound text to the viewport: Slint software text sizes are i16
                                            // before clipping, even when a long clip extends far offscreen.
                                            if clip.w > 8 && clip.x + clip.w > 8 && clip.x < root.timeline-px - 8: Text { text: clip.name; x: max(4px, (4 - clip.x) * 1px); y: (!clip.video && clip.waveform.width > 0) || (clip.video && clip.h >= 32) ? 1px : max(0px, (parent.height - self.height) / 2); width: max(0px, min(parent.width - self.x - 4px, (root.timeline-px - max(0, clip.x) - 8) * 1px)); height: min(18px, parent.height); color: clip.dim ? Palette.text-secondary : Palette.text-primary; font-size: 11px; font-weight: 500; font-italic: clip.offline; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                                            if clip.selected: Rectangle { width: 100%; height: 100%; background: transparent; border-width: 1px; border-color: #D6D1EE; }
                                        }
                                        for mark in root.trans: Rectangle {
                                            x: mark.x * 1px; y: (mark.y - root.timeline-scroll-y) * 1px; width: max(mark.w * 1px, 4px); height: max(mark.h * 1px, 8px); border-radius: 0px;
                                            background: mark.audio ? Palette.trans-audio : Palette.trans-video;
                                            border-width: 1px; border-color: mark.selected ? Palette.accent : Palette.bg0;
                                            if mark.w >= 72: Text { text: mark.label; x: 4px; color: Palette.text-primary; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; }
                                        }
                                        if root.in-on: Rectangle { x: root.in-x * 1px; width: 1px; height: 100%; background: Palette.guide; }
                                        if root.out-on: Rectangle { x: root.out-x * 1px; width: 1px; height: 100%; background: Palette.guide; }
                                        Rectangle { x: root.playhead-x * 1px; y: 0px; width: 1px; height: 100%; background: Palette.accent; }
                                        if root.razor-hover-allowed: Rectangle {
                                            width: 100%; height: 100%; clip: true;
                                            for guide in root.razor-guides: Rectangle {
                                                x: max(0px, min(parent.width - 1px, guide.x * 1px));
                                                y: max(0px, guide.y * 1px); width: 1px;
                                                height: max(0px, min(guide.h * 1px, parent.height - self.y));
                                                background: root.razor-valid ? Palette.accent : #e7ad72;
                                            }
                                            if root.razor-text != "": Rectangle {
                                                width: min(330px, max(0px, parent.width - 8px)); height: min(24px, parent.height);
                                                x: max(4px, min(root.razor-label-x * 1px + 12px, parent.width - self.width - 4px));
                                                y: max(0px, min(root.razor-label-y * 1px + 20px, parent.height - self.height));
                                                background: Palette.bg0; border-width: 1px; border-color: root.razor-valid ? Palette.accent : #e7ad72;
                                                Text { x: 6px; width: max(0px, parent.width - 12px); height: 100%; text: root.razor-text; font-size: 11px; color: Palette.text-primary; vertical-alignment: center; overflow: elide; }
                                            }
                                        }
                                        if root.edit-feedback-allowed: Rectangle {
                                            width: 100%; height: 100%; clip: true;
                                            for guide in root.edit-guides: Rectangle {
                                                x: max(0px, min(parent.width - 2px, guide.x * 1px)); y: max(0px, guide.y * 1px);
                                                width: 2px; height: max(0px, min(guide.h * 1px, parent.height - self.y));
                                                background: root.edit-valid ? Palette.accent : #e7ad72;
                                            }
                                            if root.edit-text != "": Rectangle {
                                                width: min(420px, max(0px, parent.width - 8px)); height: min(24px, parent.height);
                                                x: max(4px, min(root.edit-label-x * 1px + 12px, parent.width - self.width - 4px));
                                                y: max(0px, min(root.edit-label-y * 1px + 20px, parent.height - self.height));
                                                background: Palette.bg0; border-width: 1px; border-color: root.edit-valid ? Palette.accent : #e7ad72;
                                                Text { x: 6px; width: max(0px, parent.width - 12px); height: 100%; text: root.edit-text; font-size: 11px; color: Palette.text-primary; vertical-alignment: center; overflow: elide; }
                                            }
                                        }
                                        tracks-touch := LiveTouchArea {
                                            mouse-cursor: root.tool-razor ? crosshair : root.edit-cursor == 1 ? ew-resize : root.edit-cursor == 2 ? (self.pressed ? grabbing : grab) : default;
                                            pointer-event(event) => { root.active-panel = 3; keys.focus(); if (event.kind == PointerEventKind.down) { root.razor-track-pressed = true; root.timeline(1, 0, self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control); } if (event.kind == PointerEventKind.up) { root.razor-track-pressed = false; root.timeline(1, 2, self.mouse-x / 1px, self.mouse-y / 1px, event.modifiers.shift, event.modifiers.control); } if (event.kind == PointerEventKind.cancel) { root.razor-track-pressed = false; root.razor-track-hover = false; root.timeline(1, 3, self.mouse-x / 1px, self.mouse-y / 1px, false, false); } }
                                            changed has-hover => { root.razor-track-hover = self.has-hover; root.razor-hover(self.has-hover, self.mouse-x / 1px, self.mouse-y / 1px); }
                                            moved => { root.razor-track-hover = self.has-hover; root.razor-track-pressed = self.pressed; if (self.pressed) { root.timeline(1, 1, self.mouse-x / 1px, self.mouse-y / 1px, false, false); } else { root.razor-hover(true, self.mouse-x / 1px, self.mouse-y / 1px); } }
                                            scroll-event(event) => { root.scroll-tracks(event.delta-y / 1px, event.delta-x / 1px, self.mouse-x / 1px, event.modifiers.control, event.modifiers.shift); accept }
                                        }
                                    }
                                    Rectangle {
                                        width: root.track-scrollbar-width; background: Palette.bg0; clip: true;
                                        property <length> thumb-height: min(self.height, max(28px, self.height * root.body-px / max(1, root.tracks-h)));
                                        property <length> thumb-y: (self.height - self.thumb-height) * root.timeline-scroll-y / max(1, root.track-scroll-max);
                                        Rectangle { x: 3px; y: parent.thumb-y; width: 8px; height: parent.thumb-height; border-radius: 4px; background: track-scroll-touch.pressed ? Palette.accent : track-scroll-touch.has-hover ? Palette.text-secondary : Palette.bg3; }
                                        track-scroll-touch := LiveTouchArea {
                                            enabled: root.track-scroll-max > 0.5; mouse-cursor: pointer;
                                            property <length> start-y;
                                            property <float> start-scroll;
                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.down) {
                                                    root.active-panel = 3; keys.focus();
                                                    if (self.mouse-y < parent.thumb-y || self.mouse-y > parent.thumb-y + parent.thumb-height) {
                                                        root.track-scroll-position = max(0, min(root.track-scroll-max, (self.mouse-y - parent.thumb-height / 2) / max(1px, parent.height - parent.thumb-height) * root.track-scroll-max));
                                                    }
                                                    self.start-y = self.mouse-y; self.start-scroll = root.timeline-scroll-y;
                                                }
                                            }
                                            moved => { if (self.pressed) { root.track-scroll-position = max(0, min(root.track-scroll-max, self.start-scroll + (self.mouse-y - self.start-y) / max(1px, parent.height - parent.thumb-height) * root.track-scroll-max)); } }
                                            scroll-event(event) => { root.scroll-tracks(event.delta-y / 1px, event.delta-x / 1px, root.timeline-px, event.modifiers.control, event.modifiers.shift); accept }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Live stereo output, visible while editing regardless of inspector tab.
                    Rectangle { width: 60px; background: Palette.bg1;
                        Rectangle { width: 1px; height: 100%; background: Palette.bg3; }
                        VerticalLayout { padding: 5px; spacing: 4px;
                            TextBtn { label: "Mix"; height: 23px; tooltip: "Open audio mixer"; clicked => { if (root.workspace == 1) { root.command("workspace-edit"); } root.active-panel = 4; root.grade-tab = 1; } }
                            HorizontalLayout { spacing: 5px; vertical-stretch: 1;
                                VerticalMeter { level: root.meter-left; held: root.meter-hold-left; clipped: root.meter-clip-left; }
                                VerticalMeter { level: root.meter-right; held: root.meter-hold-right; clipped: root.meter-clip-right; }
                            }
                            Text { text: "L     R"; color: Palette.text-secondary; font-size: 10px; horizontal-alignment: center; height: 14px; }
                            Text { text: root.meter-read-left; color: root.meter-clip-left ? Palette.status-error : Palette.text-secondary; font-size: 10px; horizontal-alignment: center; height: 14px; }
                            Text { text: root.meter-read-right; color: root.meter-clip-right ? Palette.status-error : Palette.text-secondary; font-size: 10px; horizontal-alignment: center; height: 14px; }
                            TextBtn { label: "Reset"; height: 22px; tooltip: "Clear peak hold and clipping indicators"; clicked => { root.command("clear-meters"); } }
                        }
                    }

                }
            }
                }

                if root.page == 1: Rectangle {
                    width: parent.width; height: parent.height; background: Palette.bg0;
                    property <length> settings-width: min(480px, max(408px, self.width * 0.40));
                    Rectangle { x: 0px; y: 0px; width: parent.width - parent.settings-width - 6px; height: parent.height; background: Palette.bg1;
                        VerticalLayout { spacing: 0;
                            PanelHead { label: "Sequence preview"; detail: root.seq-name; }
                            Rectangle { vertical-stretch: 1; min-height: 100px; background: Palette.bg0; clip: true;
                                if root.show-picture && root.has-clips: Image { width: 100%; height: 100%; source: root.viewer-image; image-fit: contain; horizontal-alignment: center; vertical-alignment: center; preferred-width: 0px; preferred-height: 0px; }
                                PreviewContext { available-width: parent.width; available-height: parent.height; preparing: root.program-preparing; problem: root.program-problem; }
                                if !root.has-clips: VerticalLayout { padding: 24px; alignment: center; spacing: 8px;
                                    Rectangle { vertical-stretch: 1; }
                                    Text { text: "Nothing to export yet"; color: Palette.text-primary; font-size: UiMetrics.title-font; font-weight: 600; horizontal-alignment: center; }
                                    Text { text: "Add media to the timeline, then return here."; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
                                    HorizontalLayout { alignment: center; SecBtn { label: "Back to Edit"; clicked => { root.command("workspace-edit"); } } }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                            Rectangle { height: 38px; background: Palette.bg2;
                                HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 6px;
                                    TcRun { cells: root.program-tc; main: false; ink: Palette.accent; }
                                    Rectangle { horizontal-stretch: 1; }
                                    IconBtn { enabled: root.has-clips && !root.export-busy; icon: @image-url("icons/step-back.svg"); tooltip: "Previous frame"; clicked => { root.active-panel = 1; root.command("step-back"); } }
                                    PlayBtn { enabled: root.has-clips && !root.export-busy; stopped: root.shuttle == "STOP"; tooltip: "Play / pause sequence"; clicked => { root.active-panel = 1; root.command("play-toggle"); } }
                                    IconBtn { enabled: root.has-clips && !root.export-busy; icon: @image-url("icons/step-forward.svg"); tooltip: "Next frame"; clicked => { root.active-panel = 1; root.command("step-fwd"); } }
                                    Rectangle { horizontal-stretch: 1; }
                                    TcRun { cells: root.duration-tc; main: false; ink: Palette.text-secondary; }
                                }
                            }
                            Rectangle { height: 65px;
                                VerticalLayout { padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; spacing: 4px;
                                    Text { text: "Output · " + root.export-width + " × " + root.export-height + " · " + (root.export-fps >= 0 && root.export-fps < root.export-rates.length ? root.export-rates[root.export-fps].text : "—") + " fps"; color: Palette.text-primary; font-size: 12px; overflow: elide; }
                                    Text { text: root.export-range-label; color: Palette.text-secondary; font-size: 12px; overflow: elide; }
                                }
                            }
                            if root.export-busy || root.export-result-state > 0: Rectangle {
                                height: root.export-busy || root.export-result-state != 1 ? 90px : 120px; background: Palette.bg2;
                                VerticalLayout { padding: 12px; spacing: 5px;
                                    Text { text: root.export-busy ? (root.export-checking ? "Checking destination…" : root.export-cancelling ? "Cancelling export…" : root.export-preparing ? "Preparing export…" : "Exporting video…") : root.export-result-state == 1 ? "Export complete" : root.export-result-state == 2 ? "Export failed" : "Export cancelled"; color: root.export-busy ? Palette.text-primary : root.export-result-state == 1 ? Palette.status-ok : root.export-result-state == 2 ? Palette.status-error : Palette.text-secondary; font-size: 13px; font-weight: 600; height: 20px; }
                                    ExportPath { value: root.export-busy ? root.export-active-path : root.export-result-path; }
                                    if !root.export-busy && root.export-result-state == 1: HorizontalLayout { alignment: start; spacing: 8px;
                                        SecBtn { label: "Open export"; clicked => { root.command("open-last-export"); } }
                                        SecBtn { label: "Show in folder"; clicked => { root.command("reveal-last-export"); } }
                                    }
                                }
                            }
                            Rectangle { height: root.queue-items.length == 0 ? 78px : min(196px, root.height * 0.26);
                                VerticalLayout { spacing: 0;
                                    Rectangle { height: 36px;
                                        HorizontalLayout { padding-left: 12px; padding-right: 8px; spacing: 8px;
                                            Text { text: "Export queue" + (root.queue-items.length == 0 ? "" : " · " + root.queue-items.length); color: Palette.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            TextBtn { label: "Clear finished"; enabled: root.queue-has-finished && !root.export-busy; clicked => { root.command("clear-completed"); } }
                                            SecBtn { label: "Start queue"; enabled: root.queue-pending && !root.export-busy; clicked => { root.command("render-queue"); } }
                                        }
                                    }
                                    if root.queue-items.length == 0: Text { x: 14px; width: parent.width - 28px; height: 36px; text: "Add to queue to save an export and run it later."; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; }
                                    if root.queue-items.length > 0: Flickable {
                                        vertical-stretch: 1; min-height: 0px; content-width: self.width; content-height: max(self.height, queue-list.preferred-height);
                                        queue-list := VerticalLayout { width: parent.width; padding: 6px; spacing: 6px; alignment: start;
                                            for job in root.queue-items: Rectangle { height: 116px; background: Palette.bg2; border-radius: 3px;
                                                VerticalLayout { padding: 8px; spacing: 3px;
                                                    HorizontalLayout { spacing: 8px;
                                                        Text { text: job.name; color: Palette.text-primary; font-weight: 600; font-size: 12px; overflow: elide; height: 18px; horizontal-stretch: 1; min-width: 0px; }
                                                        Text { text: job.state-label; color: job.complete ? Palette.status-ok : job.state-label == "Failed" ? Palette.status-error : Palette.text-secondary; font-size: 11px; height: 18px; }
                                                    }
                                                    ExportPath { value: job.output; height: 32px; }
                                                    HorizontalLayout { alignment: start; spacing: 6px; height: 28px;
                                                        if job.complete: SecBtn { label: "Open export"; clicked => { root.pick("queue-open", job.id); } }
                                                        if job.complete: SecBtn { label: "Show in folder"; clicked => { root.pick("queue-reveal", job.id); } }
                                                        if job.retryable: SecBtn { label: "Retry"; enabled: !root.export-busy; clicked => { root.pick("queue-retry", job.id); } }
                                                        TextBtn { label: "Details"; tooltip: job.status; clicked => { root.export-details = job.output + "\n\n" + job.status; root.show-export-details = true; } }
                                                        Rectangle { horizontal-stretch: 1; }
                                                        TextBtn { label: "Remove"; enabled: job.removable && !root.export-busy; tooltip: "Remove this job from the queue. Keeps the exported file."; clicked => { root.pick("queue-remove", job.id); } }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { x: parent.width - parent.settings-width; y: 0px; width: parent.settings-width; height: parent.height; background: Palette.bg1;
                        Rectangle { x: 0px; y: 0px; width: 100%; height: 64px;
                            VerticalLayout { padding-left: 16px; padding-right: 16px; padding-top: 12px; padding-bottom: 8px; spacing: 4px;
                                Text { text: root.export-container==1 ? "Export audio" : "Export video"; color: Palette.text-primary; font-size: 18px; font-weight: 600; }
                                Text { text: root.export-container==1 ? "WAV · PCM stereo · 48 kHz" : root.export-codec==1 ? "MP4 · HEVC video · AAC stereo audio" : "MP4 · H.264 video · AAC stereo audio"; color: Palette.text-secondary; font-size: 12px; }
                            }
                        }
                        export-scroll := Flickable { x: 0px; y: 64px; width: parent.width - 10px; height: parent.height - 196px; content-width: self.width; content-height: max(self.height, export-settings.preferred-height);
                            export-settings := VerticalLayout { padding-left: 16px; padding-right: 6px; padding-top: 0px; padding-bottom: 16px; spacing: 8px; alignment: start; width: parent.width;
                                ExportLabel { text: "Format"; }
                                ChoiceButton { label: "Export format"; height: UiMetrics.control-height; choices: [{text:"MP4 video"},{text:"WAV audio"}]; selected <=> root.export-container; enabled: !root.export-busy; chosen(i) => { root.export-container=i; root.command("export-format-changed"); } }
                                if root.export-container==0: VerticalLayout { spacing: 6px;
                                    ExportLabel { text: "Video codec"; }
                                    ChoiceButton { label: "Video codec"; height: UiMetrics.control-height; choices: root.export-hevc-supported ? [{text:"H.264 · most compatible"},{text:"HEVC · smaller files"}] : [{text:"H.264 · most compatible"}]; selected <=> root.export-codec; enabled: !root.export-busy; chosen(i) => { root.export-codec=i; root.export-backend=""; root.command("export-form-changed"); } }
                                    SecBtn { label: root.export-burn-captions ? "Captions: Burn into video" : "Captions: Omit from video"; enabled: !root.export-busy; clicked => { root.export-burn-captions=!root.export-burn-captions; root.command("export-form-changed"); } }
                                    ExportLabel { text: "Encoder"; }
                                    ChoiceButton { label: "Encoder"; height: UiMetrics.control-height; choices: root.export-backend-options; selected <=> root.export-backend-index; enabled: !root.export-busy; chosen(i) => { root.export-backend-index=i; root.export-backend=root.export-backend-names[i]; root.command("export-form-changed"); } }
                                    Text { text: "Listed by your FFmpeg installation. GPU and driver support is checked before export."; color: Palette.text-secondary; font-size: 11px; wrap: word-wrap; }
                                }
                                ExportHeading { text: "Destination"; }
                                VerticalLayout { spacing: 4px;
                                    ExportLabel { text: "File name"; }
                                    Field { height: UiMetrics.control-height; value <=> root.export-filename; enabled: !root.export-busy; placeholder: "My video.mp4"; edited => { root.command("export-form-changed"); } }
                                }
                                VerticalLayout { spacing: 4px;
                                    ExportLabel { text: "Save to folder"; }
                                    Field { height: UiMetrics.control-height; value <=> root.export-folder; enabled: !root.export-busy; placeholder: "Choose a folder"; edited => { root.command("export-form-changed"); } }
                                }
                                HorizontalLayout { spacing: 8px; alignment: start;
                                    SecBtn { label: "Choose folder…"; enabled: !root.export-busy; clicked => { root.command("choose-export-folder"); } }
                                    TextBtn { label: "Open folder"; enabled: root.export-folder != ""; tooltip: "Open this destination in your file manager"; clicked => { root.command("open-export-folder"); } }
                                    TextBtn { label: "Save as…"; enabled: !root.export-busy; tooltip: "Choose both file name and location"; clicked => { root.command("browse-export"); } }
                                }
                                ExportLabel { text: "Export range"; }
                                ChoiceButton { label: "Export range"; height: UiMetrics.control-height; choices: [{text: "Entire sequence"}, {text: "In / Out marks"}]; selected: root.export-inout ? 1 : 0; enabled: !root.export-busy; chosen(index) => { root.export-inout = index == 1; root.command("export-form-changed"); } }
                                if root.export-container==0: VerticalLayout { spacing: 10px; alignment: start;
                                HorizontalLayout { spacing: 8px;
                                    ExportHeading { text: "Video"; horizontal-stretch: 1; }
                                    TextBtn { label: "Match sequence"; enabled: !root.export-busy; tooltip: "Use the sequence size and frame rate. Keeps your quality settings."; clicked => { root.command("preset-match"); } }
                                }
                                HorizontalLayout { spacing: 12px;
                                    VerticalLayout { spacing: 4px;
                                        ExportLabel { text: "Width · pixels"; }
                                        Field { height: UiMetrics.control-height; value <=> root.export-width; enabled: !root.export-busy; edited => { root.command("export-form-changed"); } }
                                    }
                                    VerticalLayout { spacing: 4px;
                                        ExportLabel { text: "Height · pixels"; }
                                        Field { height: UiMetrics.control-height; value <=> root.export-height; enabled: !root.export-busy; edited => { root.command("export-form-changed"); } }
                                    }
                                }
                                HorizontalLayout { spacing: 12px;
                                    VerticalLayout { spacing: 4px;
                                        ExportLabel { text: "Frame rate"; }
                                        ChoiceButton { label: "Export frame rate"; height: UiMetrics.control-height; choices: root.export-rates; suffix: " fps"; selected: root.export-fps; enabled: !root.export-busy; chosen(index) => { root.export-fps = index; root.command("export-form-changed"); } }
                                    }
                                }
                                if root.export-inout && !root.export-range-available: Text { text: "Set In and Out marks in Edit to choose a range."; color: Palette.status-warning; font-size: 11px; wrap: word-wrap; }
                                ExportHeading { text: "Quality & performance"; }
                                HorizontalLayout { spacing: 12px;
                                    VerticalLayout { spacing: 4px;
                                        ExportLabel { text: "Picture quality"; }
                                        ChoiceButton { label: "Options";
                                            height: 32px; enabled: !root.export-busy;
                                            property <[LabelItem]> quality-presets: [{text: "High"}, {text: "Balanced"}, {text: "Standard"}];
                                            property <[LabelItem]> custom-presets: [{text: "High"}, {text: "Balanced"}, {text: "Standard"}, {text: "Custom · " + root.export-crf}];
                                            choices: root.export-crf == 18 || root.export-crf == 21 || root.export-crf == 24 ? self.quality-presets : self.custom-presets;
                                            selected: root.export-crf == 18 ? 0 : root.export-crf == 21 ? 1 : root.export-crf == 24 ? 2 : 3;
                                            chosen(index) => { if (index < 3) { root.export-crf = index == 0 ? 18 : index == 1 ? 21 : 24; root.command("export-form-changed"); } }
                                        }
                                    }
                                    VerticalLayout { spacing: 4px;
                                        ExportLabel { text: "Encoding speed"; }
                                        ChoiceButton { label: "Encoding speed"; height: UiMetrics.control-height; choices: [{text: "Balanced"}, {text: "Faster"}, {text: "Better compression"}]; selected: root.export-speed; enabled: !root.export-busy; chosen(index) => { root.export-speed = index; root.command("export-form-changed"); } }
                                    }
                                }
                                Text { text: root.export-speed == 1 ? "Faster encoding can create larger files." : root.export-speed == 2 ? "Better compression takes longer and can reduce file size." : "Higher picture quality usually creates larger files."; color: Palette.text-secondary; font-size: 11px; wrap: word-wrap; }
                                if root.export-backend=="": VerticalLayout { spacing: 4px;
                                    ExportLabel { text: "Automatic encoding method"; }
                                    ChoiceButton { label: "Encoding method"; height: UiMetrics.control-height; choices: [{text: "Auto · recommended"}, {text: "Software · CPU"}, {text: "Hardware · GPU required"}, {text: "AMD · Radeon required"}]; selected: root.export-encoder; enabled: !root.export-busy; chosen(index) => { root.export-encoder = index; root.command("export-form-changed"); } }
                                }
