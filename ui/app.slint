                        }
                        if !root.session-active && root.session-show-codes: TextBtn { label: "Open invitation file…"; clicked => { root.command("session-open-invitation"); } }
                        if root.session-active && root.session-host: Rectangle {
                            height: invite-content.preferred-height; vertical-stretch: 0; background: Palette.bg2; border-radius: 4px;
                            invite-content := VerticalLayout { padding: 10px; spacing: 8px; alignment: start;
                                Text { text: "Invite someone"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                                LabeledField { label: "Guest name · optional"; value <=> root.session-invitee; placeholder: "Guest"; enabled: !root.session-inviting; }
                                HorizontalLayout { spacing: 8px;
                                    ChoiceButton { label: "Guest permission"; choices: [{text: "Editor"}, {text: "Viewer"}]; selected: root.session-editor-role ? 0 : 1; enabled: !root.session-inviting; chosen(index) => { root.session-editor-role = index == 0; } }
                                    PriBtn { label: root.session-inviting ? "Creating…" : "Create invitation"; enabled: !root.session-inviting; clicked => { root.command("session-invite"); } }
                                }
                            }
                        }
                        if root.session-code != "" && (root.session-host || !root.session-connected): Text { text: root.session-simple-code ? "Send this invite code privately. Your guest pastes it into Join with code to connect automatically." : root.session-host ? "1. Save the invitation and send it privately.\n2. Open their reply to connect." : "Save your reply and send it back. The host opens it to finish connecting."; color: Palette.text-secondary; font-size: 13px; wrap: word-wrap; }
                        if root.session-code != "" && !root.session-simple-code && (root.session-host || !root.session-connected): PriBtn { label: root.session-host ? "Save invitation…" : "Save reply…"; clicked => { root.command("session-save-code"); } }
                        if root.session-host && !root.session-auto-connect: SecBtn { label: "Open their reply…"; clicked => { root.command("session-open-reply"); } }
                        if root.session-active && !root.session-simple-code && (root.session-host || !root.session-connected): TextBtn { label: root.session-show-codes ? "Hide connection codes" : "Show connection code"; clicked => { root.session-show-codes = !root.session-show-codes; } }
                        if root.session-show-codes || root.session-simple-code: VerticalLayout { spacing: 8px;
                            if !root.session-active || (root.session-host && !root.session-auto-connect): Text { text: root.session-host ? "Paste their reply" : "Paste an invitation"; color: Palette.text-secondary; font-size: 12px; }
                            if !root.session-active || (root.session-host && !root.session-auto-connect): ConnectionText { value <=> root.session-input; }
                            if !root.session-active: SecBtn { label: "Join with code"; enabled: root.session-input != ""; clicked => { root.command("session-join"); } }
                            if root.session-host && !root.session-auto-connect: SecBtn { label: "Connect with reply"; enabled: root.session-input != ""; clicked => { root.command("session-accept"); } }
                            if root.session-code != "": Text { text: root.session-simple-code ? "Invite code" : root.session-host ? "Your invitation code" : "Your reply code"; color: Palette.text-secondary; font-size: 12px; }
                            if root.session-code != "": VerticalLayout { spacing: 8px;
                                outgoing-code := ConnectionText { value: root.session-code; read-only: true; }
                                PriBtn { label: outgoing-code.copied ? "Copied" : root.session-host ? "Copy invite" : "Copy reply"; clicked => { outgoing-code.copy-code(); } }
                            }
                        }
                        for peer in root.session-peers: Rectangle {
                            height: 54px; background: Palette.bg2; border-radius: 4px;
                            HorizontalLayout { padding: 8px; spacing: 8px;
                                VerticalLayout { spacing: 4px; horizontal-stretch: 1;
                                    Text { text: peer.name; color: Palette.text-primary; font-size: 13px; overflow: elide; }
                                    Text { text: peer.role + " · " + peer.state; color: Palette.text-secondary; font-size: 12px; }
                                }
                                if peer.revocable: TextBtn { label: "Remove"; clicked => { root.command("session-revoke:" + peer.id); } }
                            }
                        }
                        Text { text: "Media stays on the host. Guests stream previews and can upload media using Import. The session ends when the host leaves."; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                        if root.session-active && !root.session-host && !root.session-readonly: SecBtn { label: "Upload media to host…"; clicked => { root.command("session-upload"); } }
                        if root.session-export-requested && root.session-host: SecBtn { label: "Review export request…"; clicked => { root.command("session-export"); } }
                        for transfer in root.session-transfers: Rectangle {
                            height: 86px; background: Palette.bg2; border-radius: 4px;
                            VerticalLayout { padding: 10px; spacing: 5px;
                                Text { text: transfer.name; color: Palette.text-primary; font-size: 12px; overflow: elide; min-width: 0px; }
                                Rectangle { height: 3px; background: Palette.bg3; Rectangle { height: 100%; width: parent.width * transfer.percent / 100; background: Palette.accent; } }
                                HorizontalLayout { spacing: 8px;
                                    Text { text: transfer.state + " · " + transfer.percent + "% · " + transfer.detail; color: Palette.text-secondary; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                                    if transfer.cancellable: TextBtn { label: "Cancel"; clicked => { root.command("session-cancel-upload:" + transfer.id); } }
                                }
                            }
                        }
                        if root.session-readonly: Text { text: root.session-viewer ? "You’re viewing this project. Only editors can make changes or upload media." : "Connecting. Editing is temporarily paused."; color: Palette.status-warning; font-size: UiMetrics.body-font; wrap: word-wrap; }
                        if root.session-issues != "": Text { text: "Session notices"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                        if root.session-issues != "": Text { text: root.session-issues; color: Palette.status-warning; font-size: UiMetrics.body-font; wrap: word-wrap; }
                        if root.session-has-branch: SecBtn { label: "Save my edits as a project…"; clicked => { root.command("session-save-branch"); } }
                        if !root.session-active: TextBtn { label: root.session-show-relay ? "Hide advanced options" : "Advanced"; clicked => { root.session-show-relay = !root.session-show-relay; } }
                        if !root.session-active && root.session-show-relay: VerticalLayout { spacing: 8px;
                            SecBtn { label: root.session-use-public ? "Public service: On · automatic" : "Public service: Off · direct/manual"; clicked => { root.session-use-public = !root.session-use-public; } }
                            Text { text: "Public service is optional. Leave the custom address empty to use it; guests only need an invite code."; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                            LabeledField { label: "Server address"; value <=> root.session-service-url; placeholder: "https://relay.example.com"; }
                            LabeledField { label: "Private access key"; value <=> root.session-service-key; placeholder: ""; secret: true; }
                            TextBtn { label: root.session-show-manual-relay ? "Hide manual TURN settings" : "Advanced: existing TURN server"; clicked => { root.session-show-manual-relay = !root.session-show-manual-relay; } }
                            if root.session-show-manual-relay: VerticalLayout { spacing: 8px;
                                Text { text: "Leave the service address empty to use manual TURN settings. Invitations then need a reply."; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                                LabeledField { label: "TURN address"; value <=> root.session-relay-url; placeholder: "turn:relay.example.com:3478"; }
                                LabeledField { label: "Relay username"; value <=> root.session-relay-user; placeholder: ""; }
                                LabeledField { label: "Relay password"; value <=> root.session-relay-password; placeholder: ""; secret: true; }
                            }
                            SecBtn { label: root.session-relay-only ? "Connection: Relay only" : "Connection: Auto · direct or relay"; clicked => { root.session-relay-only = !root.session-relay-only; } }
                            SecBtn { label: "Apply connection settings"; clicked => { root.command("session-relay-save"); } }
                        }
                        if !root.session-active && root.session-show-relay: TextBtn { label: root.session-show-recovery ? "Hide recovery options" : "Recover a previous session"; clicked => { root.session-show-recovery = !root.session-show-recovery; } }
                        if !root.session-active && root.session-show-relay && root.session-show-recovery: VerticalLayout { spacing: 8px;
                            SecBtn { label: "Recover a session I hosted…"; clicked => { root.command("session-recover-host"); } }
                            SecBtn { label: "Recover my unsent edits…"; clicked => { root.command("session-recover-branch"); } }
                        }
                        if root.session-active && !root.session-confirm-end: SecBtn { label: root.session-host ? "End session for everyone" : "Leave session"; clicked => { root.command("session-leave"); } }
                        if root.session-active && root.session-confirm-end: VerticalLayout { spacing: 8px;
                            Text { text: "End the session? Everyone will disconnect. Uploaded media stays on this computer."; color: Palette.status-warning; font-size: UiMetrics.body-font; wrap: word-wrap; }
                            HorizontalLayout { spacing: 8px;
                                SecBtn { label: "Keep session"; clicked => { root.session-confirm-end = false; } }
                                PriBtn { label: "End session"; clicked => { root.command("session-end-confirmed"); keys.focus(); } }
                            }
                        }
                    }
                    }
                }
            }
        }
        if root.show-creator && !root.modal-open: Rectangle {
            x: parent.width - self.width - 8px; y: 70px; width: min(440px,parent.width - 16px); height: parent.height - 100px;
            z: 3; background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 6px;
            LiveTouchArea { }
            VerticalLayout { padding: 16px; spacing: 12px;
                HorizontalLayout { spacing: UiMetrics.space-sm; Text { text: "Create"; color: Palette.text-primary; font-size: 16px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; } TextBtn { label: "Close"; clicked => { root.show-creator=false; keys.focus(); } } }
                Flickable { vertical-stretch: 1; content-width: self.width; content-height: max(self.height,creator-content.preferred-height);
                    creator-content := VerticalLayout { width: parent.width; spacing: 10px; alignment: start;
                        ChoiceButton { label: "Creative tool section"; choices: [{text:"Titles and captions"},{text:"Animation"},{text:"Audio finishing"},{text:"Trim and speed"},{text:"Transcription"},{text:"Project and sequences"},{text:"Multicam"},{text:"Picture finishing"}]; selected <=> root.creator-section; chosen(i) => { root.creator-section=i; } }
                        if root.creator-section==7: VerticalLayout { spacing: 10px; alignment: start;
                            Text { text: "SDR Rec.709 finishing"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                            Text { text: root.picture-info; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                            ChoiceButton { label: "Input color space"; choices: [{text:"Use source tags"},{text:"SDR Rec.709"},{text:"HDR · PQ / Rec.2020"},{text:"HDR · HLG / Rec.2020"},{text:"Log · use conversion LUT"}]; selected: root.picture-input; enabled: !root.creator-readonly && root.creator-has-clip; chosen(i) => { root.picture-input=i; root.command("picture-input"); } }
                            HorizontalLayout { spacing: UiMetrics.space-sm; SecBtn { label: "Clip LUT…"; enabled: !root.creator-readonly && root.creator-has-clip; clicked => { root.command("picture-lut"); } } TextBtn { label: "Remove clip LUT"; enabled: !root.creator-readonly && root.creator-has-clip; clicked => { root.command("picture-lut-reset"); } } }
                            HorizontalLayout { spacing: UiMetrics.space-sm; SecBtn { label: "Output LUT…"; enabled: !root.creator-readonly; clicked => { root.command("picture-output-lut"); } } TextBtn { label: "Remove output LUT"; enabled: !root.creator-readonly; clicked => { root.command("picture-output-reset"); } } }
                            SecBtn { label: root.picture-precision ? "High precision: On" : "High precision: Off"; enabled: !root.creator-readonly; clicked => { root.picture-precision=!root.picture-precision; root.command("picture-precision"); } }
                            SecBtn { label: root.picture-gpu ? "GPU composition: On · CPU fallback" : "GPU composition: Off"; enabled: !root.creator-readonly; clicked => { root.picture-gpu=!root.picture-gpu; root.command("picture-gpu"); } }
                            Text { text: "HDR PQ/HLG sources are tone mapped into SDR. Log footage needs a conversion LUT. High precision uses 16-bit source decoding and floating-point layers; it can be slower. LUTs are embedded in the project."; color: Palette.text-secondary; font-size: 11px; wrap: word-wrap; }
                            TextBtn { label: root.picture-parade ? "RGB parade" : "Luma waveform"; clicked => { root.picture-parade=!root.picture-parade; root.command("creator-refresh"); } }
                            Image { height: 160px; source: root.picture-scope; image-fit: fill; }
                        }
                        if root.creator-section==6: VerticalLayout { spacing: 10px; alignment: start;
                            Text { text: "Cut between cameras"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                            Text { text: "Select camera files together in the Project panel, then create a multicam clip. Source In marks line up the recordings; camera 1 supplies the sound."; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                            PriBtn { label: "Create from selected files"; enabled: !root.creator-readonly && root.project-selected-count>=2 && root.project-selected-count<=16; clicked => { root.command("multicam-create"); } }
                            ChoiceButton { label: "Camera angle"; choices: root.multicam-options; selected: root.multicam-angle; enabled: root.multicam-has-clip; chosen(i) => { root.multicam-angle=i; root.command("multicam-refresh"); } }
                            SecBtn { label: "Cut to camera at playhead"; enabled: !root.creator-readonly && root.multicam-has-clip; clicked => { root.command("multicam-cut"); } }
                            NumRow { label: "Offset · seconds"; read: ""+root.multicam-offset; value <=> root.multicam-offset; minimum: -60; maximum: 60; bipolar: true; changed(v) => { root.multicam-offset=v; } }
                            HorizontalLayout { spacing: UiMetrics.space-sm; SecBtn { label: "Apply offset"; enabled: !root.creator-readonly && root.multicam-has-clip; clicked => { root.command("multicam-offset"); } } SecBtn { label: root.multicam-busy ? "Matching..." : "Sync by sound"; enabled: !root.creator-readonly && root.multicam-has-clip && !root.multicam-busy; clicked => { root.command("multicam-sync"); } } TextBtn { label: "Cancel"; enabled: root.multicam-busy; clicked => { root.command("multicam-cancel"); } } }
                            Text { text: "Select the multicam video clip before cutting or changing offsets. Sound sync matches up to ±10 seconds in the first 30 seconds. Review every automatic match."; color: Palette.text-secondary; font-size: 11px; wrap: word-wrap; }
                        }
                        if root.creator-section==5: VerticalLayout { spacing: 10px; alignment: start;
                HorizontalLayout { spacing: UiMetrics.space-sm; TextBtn { label: "Duplicate sequence"; enabled: !root.creator-readonly; clicked => { root.command("sequence-copy"); } } TextBtn { label: "Adjustment clip"; enabled: !root.creator-readonly; clicked => { root.command("sequence-adjustment"); } } }
                HorizontalLayout { spacing: UiMetrics.space-sm; ChoiceButton { label: "Sequence to nest"; choices: root.sequence-options; selected: root.sequence-source; horizontal-stretch: 1; chosen(index) => { root.sequence-source=index; } } TextBtn { label: "Nest"; enabled: !root.creator-readonly; clicked => { root.command("sequence-nest"); } } }

                            Text { text: "Source destinations"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                            HorizontalLayout { spacing: UiMetrics.space-sm; TextBtn { label: root.patch-video ? "Picture: On" : "Picture: Off"; clicked => { root.patch-video=!root.patch-video; root.command("sequence-patch"); } } ChoiceButton { label: "Destination video track"; horizontal-stretch: 1; choices: root.target-video-options; selected: root.target-video; chosen(i) => { root.target-video=i; root.command("sequence-target-video"); } } }
                            HorizontalLayout { spacing: UiMetrics.space-sm; TextBtn { label: root.patch-audio ? "Audio: On" : "Audio: Off"; clicked => { root.patch-audio=!root.patch-audio; root.command("sequence-patch"); } } ChoiceButton { label: "Destination audio track"; horizontal-stretch: 1; choices: root.target-audio-options; selected: root.target-audio; chosen(i) => { root.target-audio=i; root.command("sequence-target-audio"); } } }
                            TextBtn { label: "Toggle selected track sync lock"; enabled: !root.creator-readonly; clicked => { root.command("sequence-sync-lock"); } }
                            Text { text: "A sync-locked track moves with source insertions on other tracks. Locked tracks block changes that would move their clips."; color: Palette.text-secondary; font-size: 11px; wrap: word-wrap; }
                            Text { text: "Collect and archive"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                            Text { text: "Collect copies the project and all source files into a new portable folder. Archive also creates a ZIP. Keep enough disk space for both."; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                            HorizontalLayout { spacing: UiMetrics.space-sm; PriBtn { label: "Collect project"; clicked => { root.command("portable-collect"); } } SecBtn { label: "Archive ZIP"; clicked => { root.command("portable-archive"); } } TextBtn { label: "Cancel"; clicked => { root.command("portable-cancel"); } } }
                            SecBtn { label: "Export timeline XML"; clicked => { root.command("portable-xml"); } }
                            Text { text: "Exports the open sequence's cuts and source timing with a compatibility report. Render unsupported titles and effects before interchange."; color: Palette.text-secondary; font-size: 11px; wrap: word-wrap; }
                            TextBtn { label: "Delete current sequence"; enabled: !root.creator-readonly; clicked => { root.command("sequence-delete"); } }
                        }
                        if root.creator-section==4: VerticalLayout { spacing: 10px; alignment: start;
                            Text { text: "Local transcription"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                            Text { text: root.speech-status; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                            HorizontalLayout { spacing: UiMetrics.space-sm;
                                PriBtn { label: root.speech-installed ? "Transcribe sequence" : "Download model · 57 MiB"; enabled: !root.speech-busy; clicked => { root.command(root.speech-installed ? "speech-start" : "speech-download"); } }
                                TextBtn { label: root.speech-busy ? "Cancel" : "Delete model"; enabled: root.speech-busy || root.speech-installed; clicked => { root.command(root.speech-busy ? "speech-cancel" : "speech-delete"); } }
                            }
                            if root.speech-segments.length>0: VerticalLayout { spacing: 8px;
                                ChoiceButton { label: "Transcript passage"; choices: root.speech-segments; selected: root.speech-selection; chosen(i) => { root.speech-selection=i; root.command("speech-seek"); } }
                                HorizontalLayout { spacing: UiMetrics.space-sm; PriBtn { label: "Add captions"; enabled: !root.creator-readonly; clicked => { root.command("speech-captions"); } } TextBtn { label: "Remove passage"; enabled: !root.creator-readonly; clicked => { root.command("speech-cut"); } } }
                                Text { text: "Choose a passage to review it. Removing marks it first; press again to cut all tracks. Speech recognition can make mistakes."; color: Palette.text-secondary; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                        if root.creator-section!=0 && !root.creator-has-clip: Text { text: "Select a timeline clip to edit it."; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                        if root.creator-readonly: Text { text: "Viewing only. A connected editor can make changes."; color: Palette.status-warning; font-size: UiMetrics.body-font; wrap: word-wrap; }
                        if root.creator-section==0: VerticalLayout { spacing: 10px; alignment: start;
                        Text { text: "Titles and captions"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                        Rectangle { height: 84px; background: Palette.bg0; border-width: 1px; border-color: Palette.bg3; border-radius: 3px;
                            TextInput { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; accessible-label: "Title or caption text"; text <=> root.creator-text;
                                edited => { root.creator-text-dirty = true; }
                                Timer { interval: 150ms; running: parent.has-focus; triggered => { LiveFocus.heartbeat(); } }
                                color: Palette.text-primary; font-size: 13px; wrap: word-wrap; enabled: !root.creator-readonly; property <bool> counted: false; changed has-focus => { if (self.has-focus!=self.counted) { self.counted=self.has-focus; if (self.has-focus) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); } } } }
                        }
                        HorizontalLayout { spacing: UiMetrics.space-sm;
                            SecBtn { label: "Add title"; enabled: !root.creator-readonly; clicked => { root.command("creator-title"); } }
                            SecBtn { label: "Lower third"; enabled: !root.creator-readonly; clicked => { root.command("creator-lower-third"); } }
                            SecBtn { label: "Caption"; enabled: !root.creator-readonly; clicked => { root.command("creator-caption"); } }
                        }
                        if root.creator-draft-notice != "": Text { text: root.creator-draft-notice; color: Palette.status-warning; font-size: 13px; wrap: word-wrap; }
                        if root.creator-text-dirty && root.creator-is-text: TextBtn { label: "Discard draft"; clicked => { root.command("creator-text-reload"); } }
                        if root.creator-is-text: VerticalLayout { spacing: 6px;
                            NumRow { label: "Text size"; read: ""+round(root.creator-text-size); value <=> root.creator-text-size; minimum: 8; maximum: 512; changed(v) => { root.creator-text-size=v; root.creator-text-dirty=true; } }
                            HorizontalLayout { spacing: UiMetrics.space-sm;
                                SecBtn { label: root.creator-text-background ? "Background: On" : "Background: Off"; clicked => { root.creator-text-background=!root.creator-text-background; root.creator-text-dirty=true; } }
                                PriBtn { label: "Apply text"; enabled: !root.creator-readonly; clicked => { root.command("creator-text"); } }
                            }
                        }
                        HorizontalLayout { spacing: UiMetrics.space-sm;
                            TextBtn { label: "Import SRT / VTT…"; enabled: !root.creator-readonly; clicked => { root.command("creator-captions-import"); } }
                            TextBtn { label: "Export captions…"; clicked => { root.command("creator-captions-export"); } }
                        }
                        HorizontalLayout { spacing: UiMetrics.space-sm;
                            TextBtn { label: "Save style"; enabled: root.creator-is-text; clicked => { root.command("creator-style-save"); } }
                            TextBtn { label: "Apply saved style"; enabled: root.creator-is-text && !root.creator-readonly; clicked => { root.command("creator-style-apply"); } }
                            TextBtn { label: root.creator-safe-guides ? "Hide safe areas" : "Safe areas"; clicked => { root.creator-safe-guides=!root.creator-safe-guides; } }
                        }
                        }
                        if root.creator-section==1 && root.creator-has-clip: VerticalLayout { spacing: 8px;
                            Text { text: "Animate selected clip"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                            ChoiceButton { label: "Animated property"; choices: [{text:"Position X"},{text:"Position Y"},{text:"Scale"},{text:"Rotation"},{text:"Opacity"},{text:"Volume"},{text:"Exposure"},{text:"Contrast"},{text:"Highlights"},{text:"Shadows"},{text:"Temperature"},{text:"Tint"},{text:"Saturation"}]; selected <=> root.creator-property; chosen(i) => { root.creator-property=i; root.command("creator-refresh"); } }
                            ChoiceButton { label: "Keyframe interpolation"; choices: [{text:"Linear"},{text:"Hold"},{text:"Ease in / out"}]; selected <=> root.creator-interpolation; chosen(i) => { root.creator-interpolation=i; } }
                            NumRow { label: "Value"; enabled: !root.creator-readonly; value <=> root.creator-key-value; read: ""+(round(root.creator-key-value*root.creator-key-scale*100)/100)+(root.creator-key-scale==100 ? "%" : ""); display-scale: root.creator-key-scale; minimum: root.creator-key-min; maximum: root.creator-key-max; changed(v) => { root.creator-key-value=v; root.adjust(root.creator-key-field,v); root.command("creator-refresh"); } }
                            Text { text: root.creator-key-info; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                            HorizontalLayout { spacing: UiMetrics.space-sm;
                                TextBtn { label: "Previous"; clicked => { root.command("creator-key-prev"); } }
                                PriBtn { label: "Set keyframe"; enabled: !root.creator-readonly; clicked => { root.command("creator-key-add"); } }
                                TextBtn { label: "Next"; clicked => { root.command("creator-key-next"); } }
                            }
                            HorizontalLayout { spacing: UiMetrics.space-sm;
                                TextBtn { label: "Remove"; enabled: !root.creator-readonly; clicked => { root.command("creator-key-remove"); } }
                                TextBtn { label: "Copy"; clicked => { root.command("creator-key-copy"); } }
                                TextBtn { label: "Paste"; enabled: !root.creator-readonly; clicked => { root.command("creator-key-paste"); } }
                                TextBtn { label: "Reset animation"; enabled: !root.creator-readonly; clicked => { root.command("creator-key-reset"); } }
                            }
                            Text { text: "Set a keyframe, move the playhead, then change Value here to add another."; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                        }
                        if root.creator-section==2: VerticalLayout { spacing: 10px; alignment: start;
                            Text { text: root.creator-audio-info; color: Palette.text-secondary; font-size: 11px; wrap: word-wrap; }
                            HorizontalLayout { spacing: UiMetrics.space-sm; TextBtn { label: "Mark dialogue track"; enabled: !root.creator-readonly; clicked => { root.command("creator-dialogue"); } } TextBtn { label: "Mark music track"; enabled: !root.creator-readonly; clicked => { root.command("creator-music"); } } }
                            HorizontalLayout { spacing: UiMetrics.space-sm; TextBtn { label: "Toggle music ducking"; enabled: !root.creator-readonly; clicked => { root.command("creator-ducking"); } } TextBtn { label: "Toggle voice cleanup"; enabled: !root.creator-readonly; clicked => { root.command("creator-cleanup"); } } }
                        Text { text: "Audio finishing"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                        if root.creator-audio-busy: HorizontalLayout { spacing: UiMetrics.space-sm;
                            Text { text: "Measuring clip loudness…"; color: Palette.text-secondary; font-size: 12px; horizontal-stretch: 1; }
                            TextBtn { label: "Cancel"; clicked => { root.command("creator-audio-cancel"); } }
                        }
                        if root.creator-has-clip && !root.creator-audio-busy: SecBtn { label: "Normalize clip loudness"; enabled: !root.creator-readonly; clicked => { root.command("creator-normalize"); } }
                        NumRow { label: "Low · dB"; read: ""+root.creator-low-db; value <=> root.creator-low-db; minimum: -12; maximum: 12; bipolar: true; changed(v) => { root.creator-low-db=v; } }
                        NumRow { label: "Mid · dB"; read: ""+root.creator-mid-db; value <=> root.creator-mid-db; minimum: -12; maximum: 12; bipolar: true; changed(v) => { root.creator-mid-db=v; } }
                        NumRow { label: "High · dB"; read: ""+root.creator-high-db; value <=> root.creator-high-db; minimum: -12; maximum: 12; bipolar: true; changed(v) => { root.creator-high-db=v; } }
                        HorizontalLayout { spacing: UiMetrics.space-sm;
                            SecBtn { label: root.creator-compressor ? "Compressor: On" : "Compressor: Off"; clicked => { root.creator-compressor=!root.creator-compressor; } }
                            SecBtn { label: root.creator-limiter ? "Peak ceiling: On" : "Peak ceiling: Off"; clicked => { root.creator-limiter=!root.creator-limiter; } }
                        }
                        HorizontalLayout { spacing: UiMetrics.space-sm;
                            PriBtn { label: "Apply to mix"; enabled: !root.creator-readonly; clicked => { root.command("creator-audio-apply"); } }
                            TextBtn { label: "Reset mix effects"; enabled: !root.creator-readonly; clicked => { root.command("creator-audio-reset"); } }
                        }
                        Text { text: "EQ and compression affect the whole mix. Peak ceiling limits samples to −1 dBFS; it is not a true-peak limiter."; color: Palette.text-secondary; font-size: 11px; wrap: word-wrap; }
                        }
                        if root.creator-section==3 && root.creator-has-clip: VerticalLayout { spacing: 6px;
                            ChoiceButton { label: "Editing tool"; choices: [{text:"Selection tool"},{text:"Slip tool"},{text:"Rolling tool · outgoing cut"},{text:"Slide tool"}]; selected: root.precision-tool; chosen(i) => { root.precision-tool=i; root.command("creator-precision-tool"); } }
                            Text { text: "Choose a tool, then drag a clip in the timeline. Slip changes its source, rolling moves its outgoing cut, slide moves it between neighbors. V returns to Selection."; color: Palette.text-secondary; font-size: 11px; wrap: word-wrap; }
                            Text { text: "Precision edits · one frame"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                            HorizontalLayout { spacing: UiMetrics.space-sm;
                                SecBtn { label: "Slip −"; enabled: !root.creator-readonly; clicked => { root.command("creator-precision-slip-back"); } }
                                SecBtn { label: "Slip +"; enabled: !root.creator-readonly; clicked => { root.command("creator-precision-slip-forward"); } }
                                SecBtn { label: "Roll −"; enabled: !root.creator-readonly; clicked => { root.command("creator-precision-roll-back"); } }
                                SecBtn { label: "Roll +"; enabled: !root.creator-readonly; clicked => { root.command("creator-precision-roll-forward"); } }
                            }
                            HorizontalLayout { spacing: UiMetrics.space-sm;
                                SecBtn { label: "Slide −"; enabled: !root.creator-readonly; clicked => { root.command("creator-precision-slide-back"); } }
                                SecBtn { label: "Slide +"; enabled: !root.creator-readonly; clicked => { root.command("creator-precision-slide-forward"); } }
                            }
                        }
                        if root.creator-section==3 && root.creator-has-clip && !root.creator-is-text: VerticalLayout { spacing: 8px;
                            Text { text: "Speed and duration · "+root.creator-speed-label; color: Palette.text-primary; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                            NumRow { label: "Speed %"; read: ""+round(root.creator-speed); value <=> root.creator-speed; minimum: 5; maximum: 1600; changed(v) => { root.creator-speed=v; } }
                            HorizontalLayout { spacing: UiMetrics.space-sm;
                                SecBtn { label: "Apply speed"; enabled: !root.creator-readonly; clicked => { root.command("creator-speed"); } }
                                SecBtn { label: "Reverse"; enabled: !root.creator-readonly; clicked => { root.command("creator-reverse"); } }
                                SecBtn { label: "Freeze / unfreeze"; enabled: !root.creator-readonly; clicked => { root.command("creator-freeze"); } }
                            }
                            Text { text: "Speed changes linked audio too. Freeze frames are silent. Make room before slowing a clip down."; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
        if root.show-activity && !root.show-session && !root.show-creator && !root.modal-open: Rectangle {
            x: parent.width - self.width - 8px; y: 70px; width: min(380px, parent.width - 16px); height: min(560px, parent.height - 100px);
            z: 3; background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 6px;
            LiveTouchArea { }
            VerticalLayout { padding: 16px; spacing: 12px;
                HorizontalLayout {
                    Text { text: "Background activity"; color: Palette.text-primary; font-size: 16px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                    TextBtn { label: "Close"; clicked => { root.show-activity = false; keys.focus(); } }
                }
                Flickable { vertical-stretch: 1; min-height: 0px; content-width: self.width; content-height: max(self.height, activity-content.preferred-height);
                    activity-content := VerticalLayout { width: parent.width; spacing: UiMetrics.space-md; alignment: start;
                if root.collection-status != "": VerticalLayout { spacing: 8px;
                    Text { text: "Project collection / archive"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                    Text { text: root.collection-status; color: Palette.text-secondary; font-size: 13px; wrap: word-wrap; }
                    if root.collection-busy: SecBtn { label: "Cancel collection"; clicked => { root.command("portable-cancel"); } }
                    if !root.collection-busy && root.collection-output != "": SecBtn { label: "Show collected project"; clicked => { root.command("portable-reveal"); } }
                }
                if root.speech-busy: VerticalLayout { spacing: 8px;
                    Text { text: "Transcription / model download"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                    Text { text: root.speech-status; color: Palette.text-secondary; font-size: 13px; wrap: word-wrap; }
                    SecBtn { label: "Cancel transcription"; clicked => { root.command("speech-cancel"); } }
                }
                if root.creator-audio-busy: VerticalLayout { spacing: 8px;
                    Text { text: "Measuring loudness…"; color: Palette.text-primary; font-size: 13px; }
                    SecBtn { label: "Cancel loudness analysis"; clicked => { root.command("creator-audio-cancel"); } }
                }
                if root.multicam-busy: VerticalLayout { spacing: 8px;
                    Text { text: "Matching camera sound…"; color: Palette.text-primary; font-size: 13px; }
                    SecBtn { label: "Cancel synchronization"; clicked => { root.command("multicam-cancel"); } }
                }
                Rectangle { min-height: activity-card-0.preferred-height; background: Palette.bg2; border-radius: UiMetrics.radius;
                    activity-card-0 := VerticalLayout { padding: 12px; spacing: 6px;
                        Text { text: root.import-busy ? "Import · Running" : "Import · Idle"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                        if root.import-busy: Text { text: root.import-status; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                        if root.import-busy: SecBtn { label: "Cancel import"; clicked => { root.command("import-cancel"); } }
                    }
                }
                Rectangle { min-height: activity-card-1.preferred-height; background: Palette.bg2; border-radius: UiMetrics.radius;
                    activity-card-1 := VerticalLayout { padding: 12px; spacing: 6px;
                        Text { text: root.export-busy ? "Export · Running" : "Export · Idle"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                        if root.export-busy: Text { text: root.export-preparing ? root.export-preparation-label : root.export-percent + "%" + (root.export-eta == "" ? "" : " · " + root.export-eta); color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                        SecBtn { label: root.export-busy ? "View export progress" : "Open export queue"; clicked => { root.command("export-view"); } }
                    }
                }
                Rectangle { min-height: activity-card-2.preferred-height; background: Palette.bg2; border-radius: UiMetrics.radius;
                    activity-card-2 := VerticalLayout { padding: 12px; spacing: 6px;
                        Text { text: root.preview-cache-paused ? "Preview cache · Paused" : "Preview cache"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                        Text { text: root.preview-cache-status == "" ? root.preview-cache-label : root.preview-cache-status; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                        if root.preview-cache-auto: SecBtn { label: root.preview-cache-paused ? "Resume preparation" : "Pause preparation"; clicked => { root.preview-cache-paused = !root.preview-cache-paused; root.preview-cache-settings(); } }
                    }
                }
                Rectangle { min-height: activity-card-3.preferred-height; background: Palette.bg2; border-radius: UiMetrics.radius;
                    activity-card-3 := VerticalLayout { padding: 12px; spacing: 6px;
                        Text { text: root.engine-busy ? "Media engine · Working" : root.engine-ready ? "Media engine · Ready" : "Media engine · Setup needed"; color: Palette.text-primary; font-size: 13px; font-weight: 600; }
                        Text { text: root.engine-status; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                        SecBtn { label: "Manage media engine"; clicked => { root.command("engine-setup"); } }
                    }
                }
                    }
                }
            }
        }
        if root.show-review && !root.show-session && !root.show-creator && !root.modal-open: Rectangle {
            x: parent.width - self.width - 8px; y: 70px; width: 380px; height: parent.height - 100px;
            z: 3; background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 6px;
            LiveTouchArea { }
            VerticalLayout { padding: 16px; spacing: 10px;
                HorizontalLayout {
                    Text { text: "Review notes"; color: Palette.text-primary; font-size: 16px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                    TextBtn { label: "Close"; clicked => { root.show-review = false; keys.focus(); } }
                }
                Flickable { vertical-stretch: 1; min-height: 0px; content-width: self.width; content-height: max(self.height, review-content.preferred-height);
                    review-content := VerticalLayout { width: parent.width; spacing: 10px; alignment: start;
                Text { text: root.review-summary; color: Palette.text-secondary; font-size: 12px; }
                HorizontalLayout { spacing: 8px;
                    SecBtn { label: "Import notes"; clicked => { root.command("review-import"); } }
                    SecBtn { label: "Export notes"; clicked => { root.command("review-export"); } }
                }
                LabeledField { label: "Your name"; value <=> root.review-author; }
                Rectangle { height: 84px; background: Palette.bg0; border-width: 1px; border-color: draft.has-focus ? Palette.accent : Palette.bg3; border-radius: 3px; clip: true;
                    Text { x: 8px; y: 8px; text: root.review-draft == "" ? "Add a note at the playhead…" : ""; color: Palette.text-secondary; font-size: 13px; }
                    draft := TextInput { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
                        text <=> root.review-draft; color: Palette.text-primary; font-size: 13px; wrap: word-wrap; single-line: false;
                        changed has-focus => { if (self.has-focus) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); } }
                        Timer { interval: 150ms; running: draft.has-focus; triggered => { LiveFocus.heartbeat(); } }
                    }
                }
                if root.review-error != "": Text { text: root.review-error; color: Palette.status-warning; wrap: word-wrap; font-size: 12px; }
                HorizontalLayout { spacing: 8px;
                    SecBtn { label: root.review-show-resolved ? "Hide resolved" : "Show resolved"; clicked => { root.command("review-filter"); } }
                    PriBtn { label: "Add note"; enabled: root.review-draft != ""; clicked => { root.command("review-add"); } }
                }
                LabeledField { label: "Search notes"; value <=> root.review-query; placeholder: "Note text or reviewer"; edited => { root.command("review-search"); } }
                HorizontalLayout {
                    TextBtn { label: "Previous"; enabled: root.review-page > 0; clicked => { root.command("review-prev"); } }
                    Text { text: (root.review-page + 1) + " / " + root.review-pages; color: Palette.text-secondary; font-size: 12px; horizontal-stretch: 1; horizontal-alignment: center; vertical-alignment: center; }
                    TextBtn { label: "Next"; enabled: root.review-page + 1 < root.review-pages; clicked => { root.command("review-next"); } }
                }
                Rectangle { min-height: note-list.preferred-height;
                    note-list := VerticalLayout { width: parent.width; spacing: 8px;
                        for item in root.review-notes: Rectangle {
                            min-height: note-content.preferred-height + 20px; background: Palette.bg2; border-radius: 4px;
                            note-content := VerticalLayout { padding: 10px; spacing: 6px;
                                HorizontalLayout { spacing: 8px;
                                    TextBtn { label: item.timecode; tooltip: "Go to note"; clicked => { root.command("review-jump:" + item.id); } }
                                    Text { text: item.author; color: Palette.text-secondary; font-size: 12px; overflow: elide; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; }
                                }
                                Text { text: item.text; color: Palette.text-primary; font-size: 13px; wrap: word-wrap; }
                                TextBtn { label: item.resolved ? "Reopen" : "Resolve"; clicked => { root.command("review-resolve:" + item.id); } }
                            }
                        }
                        if root.review-notes.length == 0: Text { text: root.review-query == "" ? "No notes yet. Add one at the playhead." : "No matching notes."; color: Palette.text-secondary; font-size: 13px; wrap: word-wrap; }
                    }
                }
                    }
                }
            }
        }
        if root.show-update-agree: Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; z: 9; width: min(560px, parent.width - 48px); height: 260px;
            background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 4px;
            VerticalLayout { padding: 16px; spacing: 12px;
                Text { text: root.update-agree-title; color: Palette.text-primary; font-size: UiMetrics.title-font; font-weight: 600; }
                Text { text: root.update-agree-body; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    SecBtn { label: "Cancel"; clicked => { root.command("update-agree-cancel"); keys.focus(); } }
                    SecBtn { label: "Open download page"; clicked => { root.command("update-agree-manual"); keys.focus(); } }
                    PriBtn { label: "Update automatically"; clicked => { root.command("update-agree-auto"); keys.focus(); } }
                }
            }
        }
        if root.show-update-agree: Rectangle { width: 100%; height: 100%; z: 8; background: #00000088; LiveTouchArea { } }
        if root.show-export-details: Rectangle { width: 100%; height: 100%; z: 8; background: #00000088; LiveTouchArea { } }
        if root.show-export-details: Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(680px, parent.width - 64px); height: min(max(184px, export-detail-text.preferred-height + 128px), parent.height - 96px); z: 9;
            background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 4px;
            VerticalLayout { padding: 20px; spacing: 16px;
                Text { text: "Export details"; color: Palette.text-primary; font-size: 16px; font-weight: 600; }
                Rectangle { vertical-stretch: 1; min-height: 0px; clip: true;
                    Flickable { width: 100%; height: 100%; content-width: self.width; content-height: max(self.height, export-detail-text.preferred-height);
                        export-detail-text := TextInput { x: 0px; y: 0px; width: parent.width; height: self.preferred-height; text: root.export-details; color: Palette.text-primary; font-size: 12px; wrap: word-wrap; read-only: true; single-line: false; selection-background-color: Palette.accent-muted; selection-foreground-color: Palette.text-primary; }
                    }
                }
                HorizontalLayout { alignment: end; spacing: 8px;
                    SecBtn { label: "Copy details"; clicked => { export-detail-text.select-all(); export-detail-text.copy(); } }
                    SecBtn { label: "Close"; clicked => { root.show-export-details = false; keys.focus(); } }
                }
            }
        }
        if root.show-import-mode: Rectangle {
            x: (parent.width - 440px) / 2; y: (parent.height - self.height) / 2; z: 5; width: 440px; height: 220px;
            background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 4px;
            VerticalLayout { padding: 16px; spacing: 12px;
                Text { text: "Import timeline"; color: Palette.text-primary; font-size: UiMetrics.title-font; font-weight: 600; }
                Text { text: "Open this timeline as a new project, or add it at the playhead?"; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                Text { text: "Import an FCPXML timeline. Direct .prproj and .drp import is not available yet."; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                HorizontalLayout { alignment: end; spacing: 8px;
                    SecBtn { label: "Cancel"; clicked => { root.command("import-timeline-cancel"); keys.focus(); } }
                    SecBtn { label: "Add to current"; clicked => { root.command("import-timeline-merge"); keys.focus(); } }
                    PriBtn { label: "New project"; clicked => { root.command("import-timeline-new"); keys.focus(); } }
                }
            }
        }
        if root.show-import-report: Rectangle {
            x: (parent.width - 520px) / 2; y: (parent.height - self.height) / 2; z: 5; width: 520px; height: min(420px, parent.height - 96px);
            background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 4px;
            VerticalLayout { spacing: 0;
                Rectangle { height: 38px; background: Palette.bg2;
                    Text { text: "Import report"; x: 16px; height: 100%; color: Palette.text-primary; font-size: UiMetrics.title-font; font-weight: 600; vertical-alignment: center; }
                }
                Flickable {
                    vertical-stretch: 1; min-height: 120px;
                    content-width: self.width;
                    content-height: max(self.height, report-body.preferred-height);
                    report-body := Text {
                        width: parent.width - 32px; x: 16px; y: 12px;
                        text: root.import-report-text;
                        color: Palette.text-primary; font-size: 12px; wrap: word-wrap;
                    }
                }
                Rectangle { height: 56px; background: Palette.bg2;
                    HorizontalLayout { padding-right: 16px; alignment: end;
                        PriBtn { label: "Close"; clicked => { root.command("import-report-close"); keys.focus(); } }
                    }
                }
            }
        }
        if root.show-dialog: Rectangle { x: (parent.width - 520px) / 2; y: (parent.height - self.height) / 2; z: 5; width: 520px; height: min(640px, parent.height - 80px); background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 4px;
            VerticalLayout { spacing: 0;
                Rectangle { height: 38px; background: Palette.bg2;
                    Text { text: root.dialog-title; x: 16px; height: 100%; color: Palette.text-primary; font-size: UiMetrics.title-font; font-weight: 600; vertical-alignment: center; }
                }
                dialog-scroll := Flickable {
                    vertical-stretch: 1; min-height: 0px;
                    content-width: self.width;
                    content-height: max(self.height, dialog-content.preferred-height);
                    dialog-content := VerticalLayout { width: parent.width; padding: 16px; spacing: 8px; alignment: start;
                        if root.dialog-is-new: Text { text: "Project name"; color: Palette.text-secondary; font-size: 12px; height: 18px; }
                        if root.dialog-is-new: Field { field-label: "Project name"; value <=> root.dlg-name; }
                        Text { text: "Sequence preset"; color: Palette.text-secondary; font-size: 12px; height: 24px; vertical-alignment: center; }
                        VerticalLayout { spacing: 2px; alignment: start;
                            for preset[index] in root.presets: Rectangle { height: 30px; border-radius: 4px; background: preset-touch.has-hover ? Palette.bg3 : Palette.bg2;
                                preset-touch := LiveTouchArea { mouse-cursor: pointer; clicked => { root.pick("preset", index); } }
                                Text { text: preset.text; x: 10px; width: parent.width - 20px; height: 100%; color: Palette.text-primary; font-size: 12px; font-weight: 500; overflow: elide; vertical-alignment: center; }
                            }
                        }
                        HorizontalLayout { spacing: 12px;
                            VerticalLayout { spacing: 6px; alignment: start; horizontal-stretch: 1;
                                Text { text: "Width (pixels)"; color: Palette.text-secondary; font-size: 12px; height: 18px; }
                                Field { field-label: "Sequence width in pixels"; value <=> root.dlg-width; }
                            }
                            VerticalLayout { spacing: 6px; alignment: start; horizontal-stretch: 1;
                                Text { text: "Height (pixels)"; color: Palette.text-secondary; font-size: 12px; height: 18px; }
                                Field { field-label: "Sequence height in pixels"; value <=> root.dlg-height; }
                            }
                        }
                        Text { text: "Frame rate"; color: Palette.text-secondary; font-size: 12px; height: 24px; vertical-alignment: center; }
                        ChoiceButton { label: "Sequence frame rate"; choices: root.rates; suffix: " fps"; selected: root.dlg-fps; chosen(index) => { root.dlg-fps = index; } }

                    }
                }
                if root.dialog-error != "": Rectangle { height: 44px;
                    Text { x: 16px; width: parent.width - 32px; height: 100%; text: root.dialog-error; color: Palette.status-error; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                }
                Rectangle { height: 56px; background: Palette.bg2;
                    HorizontalLayout { padding-right: 16px; alignment: end; spacing: 8px;
                        SecBtn { label: "Cancel"; clicked => { root.show-dialog = false; } }
                        PriBtn { label: root.dialog-is-new ? "Create project" : "Apply settings"; clicked => { root.command(root.dialog-is-new ? "create-project" : "apply-sequence"); } }
                    }
                }
            }
        }
        if root.show-prefs: Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; z: 5;
            width: min(952px, parent.width - 96px); height: min(640px, parent.height - 96px);
            background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 4px; clip: true;
            VerticalLayout { spacing: 0;
                Rectangle { height: 38px; background: Palette.bg2;
                    Text { text: "Preferences"; x: 16px; y: 0px; height: 100%; color: Palette.text-primary; font-size: UiMetrics.title-font; font-weight: 600; vertical-alignment: center; }
                }
                HorizontalLayout { spacing: 0; vertical-stretch: 1; min-height: 0px;
                    Rectangle { width: 180px; background: Palette.bg1;
                        Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: 100%; background: Palette.bg3; }
                        VerticalLayout { padding: 8px; spacing: 4px; alignment: start;
                            NavigationItem { label: "General"; selected: root.preferences-tab == 4; clicked => { root.preferences-tab = 4; } }
                            NavigationItem { label: "Keyboard"; selected: root.preferences-tab == 0; clicked => { root.preferences-tab = 0; } }
                            NavigationItem { label: "Workspace layout"; selected: root.preferences-tab == 1; clicked => { root.preferences-tab = 1; } }
                            NavigationItem { label: "Preview cache"; selected: root.preferences-tab == 2; clicked => { root.preferences-tab = 2; } }
                            NavigationItem { label: "Versions"; selected: root.preferences-tab == 3; clicked => { root.preferences-tab = 3; root.command("versions-refresh"); } }
                            NavigationItem { label: "Media engine"; selected: root.preferences-tab == 5; clicked => { root.preferences-tab = 5; } }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; min-width: 0px;
                        if root.preferences-tab == 5: VerticalLayout { padding: 16px; spacing: 12px;
                            Text { text: "Media engine"; color: Palette.text-primary; font-size: 20px; font-weight: 600; height: 32px; }
                            Rectangle { vertical-stretch: 1; min-height: 64px; background: Palette.bg0; border-radius: UiMetrics.radius;
                                Flickable { x: 12px; y: 12px; width: parent.width - 24px; height: parent.height - 24px;
                                    content-width: self.width; content-height: engine-info.preferred-height;
                                    Rectangle { x: 0px; y: 0px; width: parent.width; height: engine-info.preferred-height;
                                        engine-info := VerticalLayout { spacing: 8px; alignment: start;
                                            Text { text: root.engine-status; color: Palette.text-primary; font-size: 13px; wrap: word-wrap; }
                                            if root.engine-details != "": Text { text: root.engine-details; color: Palette.text-secondary; font-size: 12px; wrap: char-wrap; }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout { height: UiMetrics.control-height; spacing: 12px;
                                Text { text: "Preview decoding"; color: Palette.text-primary; font-size: 13px; vertical-alignment: center; }
                                ChoiceButton { label: "Preview decoding"; choices: [{text: "Automatic · GPU / CPU"}, {text: "CPU"}]; selected: root.preview-hardware ? 0 : 1; chosen(index) => { if ((index == 0) != root.preview-hardware) { root.command("preview-hardware-toggle"); } } }
                            }
                            HorizontalLayout { spacing: 8px;
                                SecBtn { label: "Choose installed tools"; enabled: !root.engine-busy; clicked => { root.command("engine-select"); } }
                                SecBtn { label: "Offline archives"; enabled: !root.engine-busy; clicked => { root.command("engine-offline"); } }
                                SecBtn { label: "Check again"; enabled: !root.engine-busy; clicked => { root.command("engine-check"); } }
                            }
                            if root.engine-busy || !root.engine-ready: HorizontalLayout { alignment: start;
                                if root.engine-busy: SecBtn { label: "Cancel setup"; clicked => { root.command("engine-cancel"); } }
                                if !root.engine-busy && !root.engine-ready: PriBtn { label: "Download and set up"; clicked => { root.command("engine-install"); } }
                            }
                        }
                        if root.preferences-tab == 4: Flickable {
                            width: 100%; height: 100%; content-width: self.width; content-height: max(self.height, general-preferences.preferred-height);
                            general-preferences := VerticalLayout { width: parent.width; padding: 24px; spacing: 16px; alignment: start;
                            Text { text: "General"; color: Palette.text-primary; font-size: 20px; font-weight: 600; height: 32px; }
                            SectionHead { label: "Saving projects"; }
                            HorizontalLayout { height: 32px; spacing: 12px;
                                Text { text: "Autosave"; color: Palette.text-primary; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                SecBtn { label: root.autosave-problem != "" ? "Paused" : root.autosave-enabled ? "On" : "Off"; accessible-label: root.autosave-enabled ? "Turn autosave off" : "Turn autosave on"; width: 76px; clicked => { root.command("autosave-toggle"); } }
                            }
                            Text { text: "Save changes automatically every 30 seconds. Save a new project once to choose its location."; color: Palette.text-secondary; font-size: 13px; wrap: word-wrap; }
                        }
                        }
                        if root.preferences-tab == 3: VerticalLayout { padding: 16px; spacing: 10px; alignment: start;
                            HorizontalLayout { height: 28px; spacing: 8px;
                                Text { text: "Versions"; color: Palette.text-primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                SecBtn { label: "Refresh"; enabled: !root.versions-busy; clicked => { root.command("versions-refresh-force"); } }
                            }
                            Text { text: "Quaternio " + root.app-version; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; }
                            if root.versions-status != "": Text { text: root.versions-status; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; }
                            Rectangle { vertical-stretch: 1; min-height: 0px; clip: true; background: Palette.bg0;
                                if root.version-rows.length == 0 && !root.versions-busy: Text {
                                    width: 100%; height: 100%; text: "No published releases found yet."; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
                                }
                                Flickable { width: 100%; height: 100%; content-width: self.width; content-height: max(self.height, versions-list.preferred-height);
                                    versions-list := VerticalLayout { width: parent.width; spacing: 0; alignment: start;
                                        for row in root.version-rows: Rectangle {
                                            height: 44px; background: row.current ? Palette.accent-muted : Palette.bg0;
                                            HorizontalLayout { padding-left: 10px; padding-right: 8px; spacing: 8px;
                                                VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 2px; alignment: center;
                                                    HorizontalLayout { spacing: 8px; height: 16px;
                                                        Text { text: row.tag; color: Palette.text-primary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                                                        if row.prerelease: Text { text: "pre"; color: Palette.status-warning; font-size: 10px; vertical-alignment: center; }
                                                        if row.current: Text { text: "This version"; color: Palette.accent; font-size: 10px; vertical-alignment: center; }
                                                    }
                                                    Text { text: row.date; color: Palette.text-secondary; font-size: 11px; }
                                                }
                                                if !row.current: SecBtn { label: "Install"; clicked => { root.version-install(row.tag); } }
                                                TextBtn { label: "Page"; clicked => { root.version-open(row.html-url); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.preferences-tab == 2: Flickable {
                            width: 100%; height: 100%; content-width: self.width; content-height: max(self.height, cache-preferences.preferred-height);
                            cache-preferences := VerticalLayout { width: parent.width; padding: 16px; spacing: 12px; alignment: start;
                            Text { text: "Preview cache"; color: Palette.text-primary; font-size: 14px; font-weight: 600; height: 28px; }
                            Text { text: "Prepare faster previews for footage that is slow to play or scrub. Preparation runs while you are idle."; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; }
                            SectionHead { label: "Background preparation"; }
                            HorizontalLayout { height: 28px; spacing: 8px; alignment: start;
                                Text { text: "Automatic previews"; width: 144px; color: Palette.text-secondary; font-size: 12px; vertical-alignment: center; }
                                ChoiceButton { label: "Automatic previews"; width: 180px; choices: [{text: "On"}, {text: "Off"}]; selected: root.preview-cache-auto ? 0 : 1; chosen(index) => { root.preview-cache-auto = index == 0; root.preview-cache-settings(); } }
                            }
                            HorizontalLayout { height: 28px; spacing: 8px; alignment: start;
                                Text { text: "Disk limit"; width: 144px; color: Palette.text-secondary; font-size: 12px; vertical-alignment: center; }
                                ChoiceButton { label: "Preview disk limit"; width: 180px; choices: [{text: "2 GB"}, {text: "10 GB"}, {text: "25 GB"}]; selected: root.preview-cache-limit-gb == 2 ? 0 : root.preview-cache-limit-gb == 25 ? 2 : 1; chosen(index) => { root.preview-cache-limit-gb = index == 0 ? 2 : index == 2 ? 25 : 10; root.preview-cache-settings(); } }
                            }
                            HorizontalLayout { alignment: start; spacing: 8px;
                                SecBtn { label: root.preview-cache-paused ? "Resume preparation" : "Pause preparation"; enabled: root.preview-cache-auto; clicked => { root.preview-cache-paused = !root.preview-cache-paused; root.preview-cache-settings(); } }
                            }
                            SectionHead { label: "Storage and status"; }
                            if root.preview-cache-status != "": Text { text: root.preview-cache-status; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout { alignment: start; SecBtn { label: "Clear preview cache"; clicked => { root.preview-cache-clear(); } } }
                            Text { text: "Clearing previews keeps your original media and edits. Required previews can be prepared again."; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; }
                        }
                        }
                        if root.preferences-tab == 1: Flickable {
                            width: 100%; height: 100%; content-width: self.width; content-height: max(self.height, layout-preferences.preferred-height);
                            layout-preferences := VerticalLayout { width: parent.width; padding: 16px; spacing: 12px; alignment: start;
                            Text { text: "Workspace layout"; color: Palette.text-primary; font-size: 14px; font-weight: 600; height: 28px; }
                            Text { text: "Resize panels by dragging their dividers. Drag the Source or Project tab onto the other tab to swap them."; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; }
                            SectionHead { label: "Saved layout"; }
                            HorizontalLayout { spacing: 8px; alignment: start;
                                SecBtn { label: "Save layout"; clicked => { root.command("layout-save"); } }
                                SecBtn { label: "Restore saved"; clicked => { root.command("layout-restore"); } }
                            }
                            Text { text: "Save your current panel arrangement, then restore it when needed."; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; }
                            SectionHead { label: "Default layout"; }
                            HorizontalLayout { alignment: start; SecBtn { label: "Reset layout"; clicked => { root.command("layout-reset"); } } }
                            Text { text: "Return panels to the default editing arrangement."; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; }
                        }
                        }
                        if root.preferences-tab == 0: VerticalLayout { padding: 16px; spacing: 8px;
                            HorizontalLayout { height: 28px; spacing: 8px;
                                Text { text: "Keyboard shortcuts"; color: Palette.text-primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                TextBtn { label: "Reset all"; clicked => { root.command("reset-keybindings"); } }
                            }
                            HorizontalLayout { height: 28px; spacing: 6px; alignment: start;
                                Text { text: "Shortcut preset"; width: 108px; color: Palette.text-secondary; font-size: 12px; vertical-alignment: center; }
                                ChoiceButton { label: "Keyboard preset"; horizontal-stretch: 1; choices: [{text: "Premiere"}, {text: "Resolve"}]; selected: root.profile-name == "Resolve" ? 1 : 0; chosen(index) => { root.command(index == 1 ? "profile-resolve" : "profile-premiere"); } }
                            }
                            Rectangle { height: 28px;
                                LiveTouchArea { mouse-cursor: pointer; clicked => { root.command("vim-toggle"); } }
                                Rectangle { x: 0px; y: 6px; width: 16px; height: 16px; border-radius: 3px; background: root.vim-navigation ? Palette.accent-action : Palette.bg0; border-width: 1px; border-color: root.vim-navigation ? Palette.accent : Palette.bg3;
                                    Text { text: root.vim-navigation ? "✓" : ""; x: 0px; y: 0px; width: 100%; height: 100%; color: Palette.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Text { text: "Vim navigation mode"; x: 26px; y: 0px; height: 100%; color: Palette.text-primary; font-size: 12px; vertical-alignment: center; }
                            }
                            Text { text: "Click a shortcut to remap it. Esc cancels capture; Backspace clears a binding."; color: Palette.text-secondary; font-size: 12px; height: 36px; wrap: word-wrap; }
                            if root.binding-message != "": Text { text: root.binding-message; color: Palette.status-warning; font-size: 12px; height: 36px; wrap: word-wrap; }
                            Field { placeholder: "Search commands or shortcuts…"; value <=> root.keybinding-query; }
                            Rectangle { height: 24px; background: Palette.bg2;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px;
                                    Text { text: "Command"; color: Palette.text-secondary; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Text { text: "Shortcut"; width: 156px; color: Palette.text-secondary; font-size: 11px; vertical-alignment: center; }
                                    Rectangle { width: 46px; }
                                }
                            }
                            Rectangle { vertical-stretch: 1; min-height: 0px; clip: true; background: Palette.bg0; border-radius: 0px;
                                if root.keybinding-items.length == 0: Text { x: 8px; y: 0px; width: parent.width - 16px; height: 100%; text: "No matching shortcuts"; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                Flickable { x: 0px; y: 0px; width: 100%; height: 100%; content-width: self.width; content-height: max(self.height, bindings-list.preferred-height);
                                    bindings-list := VerticalLayout { width: parent.width; padding: 0px; spacing: 0px; alignment: start;
                                        for row in root.keybinding-items: Rectangle { height: 36px; border-radius: 0px; background: root.capturing-binding && root.binding-action == row.action ? Palette.accent-muted : Palette.bg0;
                                            HorizontalLayout { padding-left: 8px; padding-right: 4px; spacing: 8px;
                                                Text { text: row.label; color: Palette.text-primary; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                                                if row.modified: Text { text: "Custom"; color: Palette.accent; font-size: 10px; vertical-alignment: center; }
                                                Rectangle { width: 148px;
                                                    SecBtn { x: 0px; y: 4px; width: 100%; label: row.binding == "" ? "Unassigned" : row.binding; clicked => { root.binding-edit(row.action); } }
                                                }
                                                TextBtn { label: "Reset"; enabled: row.modified; clicked => { root.binding-reset(row.action); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 48px; background: Palette.bg2;
                    HorizontalLayout { padding-left: 16px; padding-right: 16px; spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        PriBtn { label: "Done"; clicked => { root.show-prefs = false; keys.focus(); } }
                    }
                }
            }
        }
        if root.show-sequence-match: Rectangle { x: 0px; y: 0px; width: 100%; height: 100%; z: 8; background: #00000088; LiveTouchArea { } }
        if root.show-sequence-match: Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; z: 9;
            width: min(520px, parent.width - 64px); height: 238px;
            background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 4px; clip: true;
            LiveTouchArea { }
            VerticalLayout { spacing: 0;
                Rectangle { height: 38px; background: Palette.bg2;
                    Text { x: 16px; width: parent.width - 32px; height: 100%; text: "Match sequence to footage?"; color: Palette.text-primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                }
                VerticalLayout { padding: 16px; spacing: 8px;
                    Text { text: root.sequence-match-description; color: Palette.text-primary; font-size: 12px; wrap: word-wrap; vertical-stretch: 1; }
                    Text { text: "Choose the sequence settings for this first edit."; color: Palette.text-secondary; font-size: 12px; height: 24px; }
                }
                Rectangle { height: 52px; background: Palette.bg2;
                    HorizontalLayout { padding-left: 16px; padding-right: 16px; spacing: 8px;
                        TextBtn { label: "Cancel"; clicked => { root.sequence-match-choice(-1); keys.focus(); } }
                        Rectangle { horizontal-stretch: 1; }
                        SecBtn { label: "Keep settings"; clicked => { root.sequence-match-choice(0); keys.focus(); } }
                        PriBtn { label: "Match footage"; clicked => { root.sequence-match-choice(1); keys.focus(); } }
                    }
                }
            }
        }
        if root.save-problem-open: Rectangle { width: 100%; height: 100%; z: 12; background: #00000088; LiveTouchArea {} }
        if root.save-problem-open: Rectangle { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; width: min(520px,parent.width - 48px); height: 210px; z: 13; background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 4px;
            VerticalLayout { padding: 16px; spacing: 12px;
                Text { text: "Saving needs attention"; color: Palette.text-primary; font-size: 16px; font-weight: 600; }
                Text { text: root.autosave-problem; color: Palette.text-secondary; font-size: 13px; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout { spacing: 8px; alignment: end;
                    SecBtn { label: "Close"; clicked => { root.save-problem-open=false; } }
                    PriBtn { label: "Save As…"; clicked => { root.save-problem-open=false; root.command("save-as"); } }
                }
            }
        }
        if root.show-about: Rectangle { x: (parent.width - 420px) / 2; y: (parent.height - self.height) / 2; z: 5; width: 420px; height: 188px; background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 4px; clip: true;
            VerticalLayout { spacing: 0;
                Rectangle { height: 38px; background: Palette.bg2;
                    Text { x: 16px; width: parent.width - 32px; text: "About Quaternio"; color: Palette.text-primary; font-size: 14px; font-weight: 600; height: 100%; vertical-alignment: center; }
                }
                VerticalLayout { padding: 16px; spacing: 8px;
                    Text { text: "Quaternio " + root.app-version; color: Palette.text-primary; font-size: 12px; }
                    Text { text: "Decoder: FFmpeg"; color: Palette.text-secondary; font-size: 12px; }
                }
                Rectangle { height: 48px; background: Palette.bg2;
                    HorizontalLayout { padding-right: 16px; alignment: end; PriBtn { label: "Close"; clicked => { root.show-about = false; keys.focus(); } } }
                }
            }
        }

        command-overlay := Rectangle {
            x: 0px; y: 0px; width: 100%; height: 100%; z: 6;
            visible: root.show-command-palette;
            background: #00000088;
            LiveTouchArea { clicked => { root.show-command-palette = false; } }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: min(100px, (parent.height - self.height) / 3);
                width: min(560px, parent.width - 48px);
                height: min(520px, parent.height - 100px);
                background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 4px; clip: true;
                LiveTouchArea { }
                VerticalLayout { spacing: 0;
                    Rectangle { height: 40px; background: Palette.bg2;
                        HorizontalLayout { padding-left: 16px; padding-right: 8px; spacing: 12px;
                            Text { text: "Commands"; color: Palette.text-primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                            Text { text: root.shortcut-hint("commands", root.shortcut-revision); color: Palette.text-secondary; font-size: 11px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            TextBtn { label: "Close · Esc"; clicked => { root.show-command-palette = false; } }
                        }
                    }
                    Rectangle { height: 52px;
                        Rectangle { x: 12px; y: 8px; width: parent.width - 24px; height: 36px; background: Palette.bg0; border-width: 1px; border-color: Palette.accent; border-radius: 4px;
                            Text { x: 12px; y: 0px; width: parent.width - 24px; height: 100%; text: root.command-query == "" ? "Search commands…" : ""; color: Palette.text-secondary; font-size: 13px; vertical-alignment: center; }
                            palette-search := FocusScope {
                                x: 0px; y: 0px; width: 100%; height: 100%; forward-focus: palette-input;
                                key-pressed(event) => {
                                    if (event.text == Key.UpArrow) { root.key-cmd("palette-up", false, false, false); return accept; }
                                    if (event.text == Key.DownArrow) { root.key-cmd("palette-down", false, false, false); return accept; }
                                    if (event.text == Key.Escape) { root.show-command-palette = false; return accept; }
                                    reject
                                }
                                palette-input := TextInput {
                Timer { interval: 150ms; running: palette-input.has-focus; triggered => { LiveFocus.heartbeat(); } }
                                    property <bool> live-focus-counted: false;
                                    changed has-focus => { if (self.has-focus != self.live-focus-counted) { self.live-focus-counted = self.has-focus; if (self.has-focus) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); } } }
                                    x: 12px; y: 0px; width: parent.width - 24px; height: 100%;
                                    text <=> root.command-query; single-line: true;
                                    color: Palette.text-primary; font-size: 13px; vertical-alignment: center;
                                    accepted => { root.key-cmd("palette-enter", false, false, false); }
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; min-height: 0px; clip: true;
                        if root.command-items.length == 0: Text { x: 16px; y: 0px; width: parent.width - 32px; height: 100%; text: "No matching commands"; color: Palette.text-secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                        palette-results := Flickable {
                            x: 0px; y: 0px; width: 100%; height: 100%;
                            content-width: self.width;
                            content-height: max(self.height, palette-list.preferred-height);
                            palette-list := VerticalLayout { width: parent.width; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px; spacing: 2px; alignment: start;
                                for item[index] in root.command-items: Rectangle {
                                    height: 40px; border-radius: 4px;
                                    background: item.enabled && index == root.command-selection ? Palette.accent-muted : item.enabled && result-touch.has-hover ? Palette.bg3 : Palette.bg1;
                                    Rectangle { x: 0px; y: 4px; width: 2px; height: parent.height - 8px; background: item.enabled && index == root.command-selection ? Palette.accent : transparent; }
                                    result-touch := LiveTouchArea { enabled: item.enabled; mouse-cursor: pointer; clicked => { root.command-selection = index; root.palette-run(item.action); } }
                                    HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 16px;
                                        Text { text: item.label; color: item.enabled ? Palette.text-primary : Palette.text-disabled; font-size: 13px; font-weight: index == root.command-selection && item.enabled ? 500 : 400; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                                        Text { text: item.hint; color: item.enabled ? Palette.text-secondary : Palette.text-disabled; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; horizontal-stretch: 0; }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { height: 32px; background: Palette.bg2;
                        Text { x: 16px; y: 0px; width: parent.width - 32px; height: 100%; text: "↑ ↓ Navigate    Enter Run    Esc Close"; color: Palette.text-secondary; font-size: 11px; vertical-alignment: center; }
                    }
                }
            }
        }

        binding-capture-overlay := Rectangle {
            x: 0px; y: 0px; width: 100%; height: 100%; z: 7;
            visible: root.capturing-binding && root.show-prefs; background: #00000088;
            LiveTouchArea { }
            binding-capture := FocusScope {
                x: 0px; y: 0px; width: 100%; height: 100%;
                key-pressed(event) => {
                    root.key-cmd(root.normalized-key(event.text), event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
                    accept
                }
            }
            Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 440px; height: 244px; background: Palette.bg1; border-width: 1px; border-color: Palette.accent; border-radius: 4px;
                VerticalLayout { padding: 20px; spacing: 12px; alignment: start;
                    Text { text: "Set shortcut"; color: Palette.text-primary; font-size: UiMetrics.title-font; font-weight: 600; height: 24px; }
                    Text { text: root.binding-label; color: Palette.text-primary; font-size: 13px; font-weight: 500; height: 22px; overflow: elide; }
                    Text { text: "Press a key or key combination.\nBackspace clears this binding."; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; height: 40px; }
                    Text { text: root.binding-message; color: Palette.status-warning; font-size: 12px; wrap: word-wrap; height: 36px; }
                    HorizontalLayout { alignment: end; SecBtn { label: "Cancel · Esc"; clicked => { root.key-cmd("escape", false, false, false); } } }
                }
            }
        }
        for ghost in root.media-drop-ghosts: Rectangle {
            visible: root.media-drag-active && root.media-drop-valid;
            x: ghost.x * 1px; y: ghost.y * 1px; width: ghost.w * 1px; height: ghost.h * 1px; z: 5;
            background: ghost.video ? #5AB2F330 : #7DCA9A30; border-width: 2px; border-color: ghost.video ? Palette.accent : Palette.status-ok; border-radius: 2px;
        }
        if root.media-drag-active: Rectangle {
            x: max(8px, min(root.width - self.width - 8px, root.media-drag-x * 1px + 14px));
            y: max(8px, min(root.height - self.height - 8px, root.media-drag-y * 1px + 14px));
            width: 236px; height: 48px; z: 6; background: Palette.bg2;
            border-width: 1px; border-color: root.media-drop-valid ? Palette.accent : Palette.bg3; border-radius: 4px;
            VerticalLayout { padding-left: 10px; padding-right: 10px; spacing: 0;
                Text { text: root.media-drag-label; color: Palette.text-primary; font-size: 12px; font-weight: 500; overflow: elide; vertical-alignment: center; }
                Text { text: root.media-drop-hint; color: root.media-drop-valid ? Palette.accent : Palette.text-secondary; font-size: 11px; overflow: elide; vertical-alignment: center; }
            }
        }
        if PaneDocking.active && root.pane-drag-valid: Rectangle { x: 0px; y: root.dock-target-y; width: root.dock-target-width; height: 32px; z: 5; background: #5AB2F330; border-width: 2px; border-color: Palette.accent; }
        if PaneDocking.active: Rectangle {
            x: max(8px, min(root.width - self.width - 8px, PaneDocking.x + 14px)); y: max(8px, min(root.height - self.height - 8px, PaneDocking.y + 14px));
            width: 280px; height: 52px; z: 6; background: Palette.bg2; border-width: 1px; border-color: root.pane-drag-valid ? Palette.accent : Palette.bg3; border-radius: 4px;
            Text { x: 10px; y: 6px; width: parent.width - 20px; height: parent.height - 12px; text: (PaneDocking.pane == 0 ? "Source" : "Project") + (root.pane-drag-valid ? " · Release to swap panels" : " · Drag over the other panel tab"); wrap: word-wrap; color: Palette.text-primary; font-size: 12px; vertical-alignment: center; }
        }
        if !root.live-reloading && ToolHints.shown && ToolHints.ready && root.open-menu == 0 && !root.filter-open && !root.quality-open && !PaneDocking.active && !root.show-command-palette && !root.show-dialog && !root.show-prefs && !root.show-about && !root.show-sequence-match: Rectangle {
            x: max(8px, min(root.width - self.width - 8px, ToolHints.x - self.width / 2));
            y: min(root.height - self.height - 8px, ToolHints.y);
            width: min(420px, hint-label.preferred-width + 20px); height: hint-label.preferred-height + 16px; z: 10;
            background: Palette.bg3; border-width: 1px; border-color: #4A4A4A; border-radius: 4px;
            hint-label := Text { x: 10px; y: 8px; width: parent.width - 20px; text: ToolHints.text; wrap: word-wrap; color: Palette.text-primary; font-size: 11px; vertical-alignment: center; }
        }
    }
    if root.live-reloading: Rectangle {
        x: 0px; y: 0px; width: 100%; height: 100%; z: 100;
        background: #111111CC;
        LiveTouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 360px; height: 72px; background: Palette.bg2; border-width: 1px; border-color: Palette.bg3;
            Text { text: "Saving recovery checkpoint…"; color: Palette.text-primary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    changed width => { PopupBounds.width = self.width; root.compact-toolbar = self.width < 1060px; }
    changed height => { PopupBounds.height = self.height; }
    init => { PopupBounds.width = self.width; PopupBounds.height = self.height; keys.focus(); }
}
