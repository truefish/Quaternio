                        command(action) => { root.command(action); } focus-editor => { keys.focus(); }
                    }
                    if root.workspace == 0 && root.expanded-panel < 0: Rectangle { width: 5px; background: project-divider.pressed || project-divider.has-hover ? Palette.bg3 : Palette.bg0;
                        Rectangle { x: 2px; y: 0px; width: 1px; height: 100%; background: project-divider.pressed || project-divider.has-hover ? Palette.accent : Palette.bg3; }
                        project-divider := LiveTouchArea {
                            mouse-cursor: ew-resize;
                            property <float> start-width;
