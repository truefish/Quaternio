                            IconBtn { icon: @image-url("icons/selection.svg"); tooltip: "Selection tool · " + root.shortcut-hint("tool-select", root.shortcut-revision) + "\nSelect, move and trim clips."; armed: !root.tool-razor; clicked => { root.active-panel = 3; keys.focus(); root.command("tool-select"); } }
