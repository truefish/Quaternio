                {label: "Deselect", hint: root.shortcut-hint("deselect", root.shortcut-revision), enabled: true, divider: false},
                {label: "Preferences", hint: "", enabled: true, divider: true}
            ];
            dismissed => { root.open-menu = 0; keys.focus(); }
            adjacent(direction) => { root.open-menu = root.open-menu + direction < 1 ? 9 : root.open-menu + direction > 9 ? 1 : root.open-menu + direction; }
            activated(index) => { keys.focus();
                if (index == 0) { root.open-menu = 0; root.command("undo"); }
                if (index == 1) { root.open-menu = 0; root.command("redo"); }
                if (index == 2) { root.open-menu = 0; root.command("copy"); }
                if (index == 3) { root.open-menu = 0; root.command("paste"); }
                if (index == 4) { root.open-menu = 0; root.command("select-all"); }
                if (index == 5) { root.open-menu = 0; root.command("deselect"); }
                if (index == 6) { root.open-menu = 0; root.show-prefs = true; }
            }
        }
        if root.open-menu == 3: KeyboardMenu { x: min(94px, root.width - self.width - 8px); y: 30px; z: 3; width: min(300px, root.width - 16px); menu-id: 3;
            items: [
                {label: "Insert", hint: root.shortcut-hint("insert", root.shortcut-revision), enabled: root.has-selected-media, divider: false},
                {label: "Overwrite", hint: root.shortcut-hint("overwrite", root.shortcut-revision), enabled: root.has-selected-media, divider: false},
                {label: "Split at playhead", hint: root.shortcut-hint("split", root.shortcut-revision), enabled: root.can-split, divider: false},
                {label: "Ripple delete", hint: root.shortcut-hint("ripple-delete", root.shortcut-revision), enabled: root.can-edit-selection, divider: false},
                {label: "Lift", hint: root.shortcut-hint("lift", root.shortcut-revision), enabled: root.can-edit-selection, divider: false},
                {label: "Link", hint: root.shortcut-hint("link-clips", root.shortcut-revision), enabled: root.inspector-mode != 0, divider: false},
                {label: "Unlink", hint: root.shortcut-hint("unlink-clips", root.shortcut-revision), enabled: root.inspector-mode != 0, divider: false}
            ];
            dismissed => { root.open-menu = 0; keys.focus(); }
            adjacent(direction) => { root.open-menu = root.open-menu + direction < 1 ? 9 : root.open-menu + direction > 9 ? 1 : root.open-menu + direction; }
            activated(index) => { keys.focus();
                if (index == 0) { root.open-menu = 0; root.command("insert"); }
                if (index == 1) { root.open-menu = 0; root.command("overwrite"); }
                if (index == 2) { root.open-menu = 0; root.command("split"); }
                if (index == 3) { root.open-menu = 0; root.command("ripple-delete"); }
                if (index == 4) { root.open-menu = 0; root.command("lift"); }
                if (index == 5) { root.open-menu = 0; root.command("link-clips"); }
                if (index == 6) { root.open-menu = 0; root.command("unlink-clips"); }
            }
        }
        if root.open-menu == 4: KeyboardMenu { x: min(140px, root.width - self.width - 8px); y: 30px; z: 3; width: min(300px, root.width - 16px); menu-id: 4;
            items: [
                {label: "Sequence settings", hint: "", enabled: true, divider: false},
                {label: "Add video track", hint: "", enabled: true, divider: false},
                {label: "Add audio track", hint: "", enabled: true, divider: false},
                {label: "Zoom in", hint: root.shortcut-hint("zoom-in", root.shortcut-revision), enabled: true, divider: false},
                {label: "Zoom out", hint: root.shortcut-hint("zoom-out", root.shortcut-revision), enabled: true, divider: false},
                {label: "Zoom to fit", hint: root.shortcut-hint("zoom-fit", root.shortcut-revision), enabled: true, divider: false}
            ];
            dismissed => { root.open-menu = 0; keys.focus(); }
            adjacent(direction) => { root.open-menu = root.open-menu + direction < 1 ? 9 : root.open-menu + direction > 9 ? 1 : root.open-menu + direction; }
            activated(index) => { keys.focus();
                if (index == 0) { root.open-menu = 0; root.command("sequence"); }
                if (index == 1) { root.open-menu = 0; root.command("add-video"); }
                if (index == 2) { root.open-menu = 0; root.command("add-audio"); }
                if (index == 3) { root.open-menu = 0; root.command("zoom-in"); }
                if (index == 4) { root.open-menu = 0; root.command("zoom-out"); }
                if (index == 5) { root.open-menu = 0; root.command("zoom-fit"); }
            }
        }
        if root.open-menu == 5: KeyboardMenu { x: min(218px, root.width - self.width - 8px); y: 30px; z: 3; width: min(300px, root.width - 16px); menu-id: 5;
            items: [
                {label: "Mark in", hint: root.shortcut-hint("mark-in", root.shortcut-revision), enabled: true, divider: false},
                {label: "Mark out", hint: root.shortcut-hint("mark-out", root.shortcut-revision), enabled: true, divider: false},
                {label: "Go to in", hint: root.shortcut-hint("goto-in", root.shortcut-revision), enabled: true, divider: false},
                {label: "Go to out", hint: root.shortcut-hint("goto-out", root.shortcut-revision), enabled: true, divider: false},
                {label: "Clear in and out", hint: root.shortcut-hint("clear-io", root.shortcut-revision), enabled: true, divider: false}
            ];
            dismissed => { root.open-menu = 0; keys.focus(); }
            adjacent(direction) => { root.open-menu = root.open-menu + direction < 1 ? 9 : root.open-menu + direction > 9 ? 1 : root.open-menu + direction; }
            activated(index) => { keys.focus();
