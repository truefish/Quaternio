    accessible-role: tab; accessible-label: root.label; accessible-value: root.on ? "Selected" : "";
    accessible-action-default => { root.clicked(); }
    forward-focus: tab-focus;
    tab-focus := FocusScope {
        enabled: !KeyboardControls.blocked;
        changed has-focus => { if (self.has-focus) { KeyboardControls.navigating = true; } }
        key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { return accept; } return reject; }
        key-released(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; }
    }
    border-width: 1px; border-color: tab-focus.has-focus ? Palette.accent : transparent;
    callback clicked();
    horizontal-stretch: 0; height: 32px; border-radius: 0px;
    touch := LiveTouchArea { mouse-cursor: pointer; clicked => { tab-focus.focus(); root.clicked(); } }
    VerticalLayout { alignment: end; spacing: 0;
        HorizontalLayout { padding-left: root.compact ? 8px : 12px; padding-right: root.compact ? 8px : 12px; height: 29px; alignment: start;
            Text { text: root.label; color: root.on || touch.has-hover ? Palette.text-primary : Palette.text-secondary; font-size: 12px; font-weight: root.on ? 600 : 400; horizontal-alignment: left; vertical-alignment: center; }
        }
        Rectangle { height: 2px; background: root.on ? Palette.accent : Palette.bg2; }
    }
}

component InspectorTab inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    accessible-role: tab; accessible-label: root.label; accessible-value: root.on ? "Selected" : "";
    accessible-action-default => { root.clicked(); }
    forward-focus: tab-focus;
    tab-focus := FocusScope {
        enabled: !KeyboardControls.blocked;
        changed has-focus => { if (self.has-focus) { KeyboardControls.navigating = true; } }
        key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { return accept; } return reject; }
        key-released(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; }
    }
    border-width: 1px; border-color: tab-focus.has-focus ? Palette.accent : transparent;
    callback clicked();
    horizontal-stretch: 1; min-width: 0px; height: 30px;
    background: root.on ? Palette.accent-muted : touch.has-hover ? Palette.bg3 : Palette.bg2;
    touch := LiveTouchArea { mouse-cursor: pointer; clicked => { tab-focus.focus(); root.clicked(); } }
    Text { text: root.label; width: 100%; height: 100%; color: root.on ? Palette.accent : Palette.text-secondary; font-size: 12px; font-weight: root.on ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    Rectangle { y: parent.height - 2px; width: 100%; height: 2px; background: root.on ? Palette.accent : transparent; }
}

component TcRun inherits HorizontalLayout {
    in property <[Glyph]> cells;
    in property <bool> main: false;
    in property <color> ink: Palette.text-primary;
    height: root.main ? 24px : 16px;
    spacing: 0; alignment: start;
    for g in root.cells: Text {
        text: g.ch;
        width: g.sep ? (root.main ? 6px : 4px) : (root.main ? 13px : 8px);
        height: root.main ? 24px : 16px;
        font-size: root.main ? 18px : 11px;
        font-weight: 500;
        color: root.ink;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
}

component TimecodeEntry inherits Rectangle {
    in property <[Glyph]> cells;
    in property <string> value;
    in property <color> ink: Palette.text-primary;
    in property <bool> enabled: true;
    property <bool> editing: false;
    property <bool> invalid: false;
    callback begin();
    callback seek(string) -> bool;
    callback finished();
    width: 108px; height: 22px;
    background: root.editing ? Palette.bg0 : hit.has-hover && root.enabled ? Palette.bg3 : transparent;
    border-width: root.editing ? 1px : 0px;
    border-color: root.invalid ? Palette.status-error : Palette.accent;
    border-radius: 2px;
    if !root.editing: TcRun { x: 2px; y: (parent.height - self.height) / 2; cells: root.cells; ink: root.ink; }
    hit := LiveTouchArea {
        enabled: root.enabled && !root.editing; mouse-cursor: text;
        clicked => { root.begin(); input.text = root.value; root.invalid = false; root.editing = true; input.focus(); input.select-all(); }
        changed has-hover => {
            if (self.has-hover && root.enabled && !root.editing) {
                ToolHints.text = "Jump to timecode or frame\nEnter to jump · Esc to cancel";
                ToolHints.x = self.absolute-position.x + root.width / 2; ToolHints.y = self.absolute-position.y + root.height + 5px; ToolHints.shown = true;
            } else if (ToolHints.text == "Jump to timecode or frame\nEnter to jump · Esc to cancel") { ToolHints.shown = false; }
        }
    }
    FocusScope {
        visible: root.editing;
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.editing = false; root.invalid = false; root.finished(); return accept; }
            return reject;
        }
        input := TextInput {
            x: 4px; width: parent.width - 8px; height: 100%;
            enabled: root.editing; single-line: true; color: Palette.text-primary; font-size: 11px;
            vertical-alignment: center;
            property <bool> counted: false;
            Timer { interval: 150ms; running: input.has-focus; triggered => { LiveFocus.heartbeat(); } }
            changed has-focus => {
                if (self.has-focus != self.counted) { self.counted = self.has-focus; if (self.has-focus) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); root.editing = false; root.invalid = false; } }
            }
            edited => { root.invalid = false; }
            accepted => {
                if (root.seek(self.text)) { root.editing = false; root.finished(); }
                else { root.invalid = true; self.select-all(); }
            }
        }
    }
}

component FoldHead inherits Rectangle {
    in property <string> label;
    in property <bool> open: false;
    in property <bool> enabled: true;
    callback toggled();
    callback focused();
    forward-focus: header-focus;
    property <bool> keyboard-held: false;
    function release-key() { if (root.keyboard-held) { root.keyboard-held = false; LiveFocus.input-lost(); } }
    height: 22px; border-radius: 0px; background: header-focus.has-focus ? Palette.accent-muted : touch.has-hover ? Palette.bg2 : Palette.bg1;
    header-focus := FocusScope {
        enabled: root.enabled && !KeyboardControls.blocked;
        changed has-focus => { if (self.has-focus) { KeyboardControls.navigating = true; root.focused(); } else { root.release-key(); } }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " " || event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                if (!root.keyboard-held) { root.keyboard-held = true; LiveFocus.input-gained(); }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Return || event.text == " " || event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                if (root.keyboard-held) {
                    root.release-key();
                    if (event.text == Key.Return || event.text == " " || (event.text == Key.LeftArrow && root.open) || (event.text == Key.RightArrow && !root.open)) { root.toggled(); }
                }
                return accept;
            }
            return reject;
        }
        Timer { interval: 150ms; running: root.keyboard-held; triggered => { LiveFocus.heartbeat(); } }
    }
    touch := LiveTouchArea { enabled: root.enabled && !KeyboardControls.blocked; mouse-cursor: pointer; clicked => { header-focus.focus(); root.toggled(); } }
    HorizontalLayout { padding-left: 8px; spacing: 4px; alignment: start; y: 1px; height: 21px;
        Rectangle { width: 12px;
            Image { x: 0px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; source: root.open ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg"); colorize: root.enabled ? Palette.text-secondary : Palette.text-disabled; }
        }
        Text { text: root.label; color: root.enabled ? Palette.text-primary : Palette.text-disabled; font-size: 11px; font-weight: 600; horizontal-alignment: left; vertical-alignment: center; }
    }
}

component PanelHead inherits Rectangle {
