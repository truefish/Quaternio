Rectangle { height: 20px; background: Palette.bg0; clip: true;
                                Rectangle { x: 0px; y: 0px; width: 160px; height: 100%; background: Palette.bg2; Text { text: "Tracks"; x: 8px; height: 100%; color: Palette.text-secondary; font-size: 11px; vertical-alignment: center; } }
                                Rectangle { x: 160px; y: 0px; width: parent.width - 160px - root.track-scrollbar-width; height: 100%; clip: true;
                                    if root.in-on && root.out-on: Rectangle { x: root.in-x * 1px; width: max(0px, (root.out-x - root.in-x) * 1px); height: 100%; background: Palette.accent-range; }
                                    for tick in root.ticks: Rectangle {
