    property <bool> quality-open: false;
    property <length> view-w: 640px;
    property <length> view-h: 360px;
    property <length> time-w: 800px;
    property <length> time-body: max(140px, root.time-h - 80px);
    out property <float> body-px: root.time-body / 1px;
    out property <float> timeline-px: max(1px, root.width - (root.workspace == 0 && root.expanded-panel < 0 ? root.bottom-bin-w + 5px : 0px) - 160px - root.track-scrollbar-width - 96px) / 1px;
    out property <float> preview-px-width: max(1px, root.workspace == 1 ? root.preview-w : root.view-region) / 1px;
    out property <float> preview-px-height: max(1px, root.upper-h - 134px) / 1px;
    in-out property <bool> project-top: false;
    // Default to a compact source panel and a larger program monitor.
    in-out property <float> source-width: 0;
    in-out property <float> properties-width: 300;
    in-out property <float> project-width: 320;
    in-out property <float> upper-ratio: 0.57;
    out property <float> timeline-origin-x: ((root.workspace == 0 && root.expanded-panel < 0 ? root.bottom-bin-w + 5px : 0px) + 196px) / 1px;
    out property <float> timeline-origin-y: (root.upper-h + root.panel-split-h + 142px) / 1px;
    property <float> track-scroll-position: 0;
    property <float> track-scroll-max: max(0, root.tracks-h - root.body-px);
    property <length> track-scrollbar-width: root.track-scroll-max > 0.5 ? 14px : 0px;
    out property <float> timeline-scroll-y: max(0, min(root.track-scroll-position, root.track-scroll-max));
    changed tracks-h => { root.track-scroll-position = root.timeline-scroll-y; }
    changed body-px => { root.track-scroll-position = root.timeline-scroll-y; }
    public function scroll-tracks-to(offset: float) {
        root.track-scroll-position = max(0, min(root.track-scroll-max, offset));
    }
    function scroll-tracks(delta-y: float, delta-x: float, x: float, control: bool, shift: bool) {
        if (control || shift) {
            root.wheel(delta-y != 0 ? delta-y : delta-x, x, control);
        } else {
            root.track-scroll-position = max(0, min(root.track-scroll-max, root.timeline-scroll-y - delta-y));
            if (delta-x != 0) { root.wheel(delta-x, x, false); }
        }
    }
    in property <bool> media-drag-active: false;
    in property <bool> media-drop-valid: false;
    in property <[DropGhost]> media-drop-ghosts;
    in property <string> media-drop-hint: "Move to compatible, unlocked tracks";
    in property <float> media-drag-x: 0;
    in property <float> media-drag-y: 0;
    in property <string> media-drag-label: "";
    in property <float> media-drop-x: 0;
    in property <float> media-drop-y: 0;
    in property <float> media-drop-width: 0;
    in property <float> media-drop-height: 0;
    property <length> mid-h: root.height - 84px;
    property <length> panel-split-h: root.expanded-panel < 0 ? 8px : 0px;
    property <length> upper-h: root.expanded-panel == 3 ? 0px : root.expanded-panel == 1 ? root.mid-h : max(220px, min(root.mid-h - 220px, (root.mid-h - 8px) * root.upper-ratio));
    property <length> time-h: root.mid-h - root.upper-h - root.panel-split-h;
    property <length> span: root.expanded-panel == 1 ? root.width : root.width - 10px;
    property <length> preview-w: max(360px, min(640px, root.width * 0.48));
    property <length> bin-w: root.expanded-panel == 1 ? 0px : root.workspace == 2 ? 240px : root.workspace == 1 ? root.width - root.preview-w - 5px : max(240px, min(root.project-top ? root.project-width * 1px : root.source-width > 0 ? root.source-width * 1px : (root.width - root.insp-w - 10px) * 0.34, root.width - root.insp-w - 330px));
    property <length> bottom-bin-w: max(240px, min((root.project-top ? (root.source-width > 0 ? root.source-width : 320) : root.project-width) * 1px, root.width - 745px));
    property <length> insp-w: root.workspace == 1 || root.expanded-panel == 1 ? 0px : max(260px, min(root.properties-width * 1px, root.width - 570px));
    property <length> view-region: root.span - root.bin-w - root.insp-w;
    property <bool> pair: false;
    property <bool> wide-bin: root.bin-w >= 520px;
    property <bool> show-status-extra: root.width >= 1440px;
    property <bool> stack-wheels: root.insp-w < 560px;

    callback command(string);
    callback palette-run(string);
    callback select-media(int, bool, bool);
    callback sort-media(int);
    callback binding-edit(string);
    callback binding-reset(string);
    callback create-bin(string);
    callback choose-bin(string);
    callback move-to-bin(string);
    callback media-drag(int, int, float, float);
    callback adjust(string, float);
    callback mix-track(int, string, float);
    callback pick(string, int);
    callback timeline(int, int, float, float, bool, bool);
    callback razor-hover(bool, float, float);
    in property <[RazorGuide]> razor-guides;
    in property <string> razor-text;
    in property <bool> razor-valid;
    in property <float> razor-label-x;
    in property <float> razor-label-y;
    // Timeline lives inside a conditional component; retain only event-fed
    // interaction state here rather than reaching through that component's ID.
    property <bool> razor-track-hover: false;
    property <bool> razor-track-pressed: false;
    changed expanded-panel => { ToolHints.shown = false; }
    changed page => { root.expanded-panel = -1; ToolHints.shown = false; root.razor-track-hover = false; root.razor-track-pressed = false; }
    changed workspace => { root.expanded-panel = -1; ToolHints.shown = false; root.razor-track-hover = false; root.razor-track-pressed = false; }
    out property <bool> razor-hover-allowed: root.tool-razor && root.page == 0 && root.razor-track-hover && !root.razor-track-pressed
        && root.open-menu == 0 && !root.filter-open && !root.quality-open && !root.show-dialog && !root.show-prefs
        && !root.show-about && !root.show-command-palette && !root.show-sequence-match && !root.live-reloading && !LiveFocus.active;
    in property <[RazorGuide]> edit-guides;
    in property <string> edit-text;
    in property <bool> edit-valid: true;
    in property <int> edit-cursor: 0;
    in property <float> edit-label-x;
    in property <float> edit-label-y;
    out property <bool> edit-feedback-allowed: !root.tool-razor && root.page == 0 && root.razor-track-hover
        && root.open-menu == 0 && !root.filter-open && !root.quality-open && !root.show-dialog && !root.show-prefs
        && !root.show-about && !root.show-command-palette && !root.show-sequence-match && !root.live-reloading
        && (!LiveFocus.active || root.razor-track-pressed);
    callback wheel(float, float, bool);
    callback viewer(int, float, float);
    callback source-scrub(int, float);
    callback resized(float, float, float, float);
