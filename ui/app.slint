                                    Rectangle { horizontal-stretch: 1; background: Palette.bg1; clip: true;

for lane in root.lanes: Rectangle { y: (lane.y - root.timeline-scroll-y) * 1px; height: max(lane.h * 1px, 28px); width: 100%; background: lane.video ? #242426 : #202522; Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: #343438; } }
                                if !root.has-clips: Text { text: "Drag media onto a track to start editing."; x: 16px; y: parent.height * 0.35; width: parent.width - 32px; height: 48px; wrap: word-wrap; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
