                                            Rectangle { y: (parent.height - 28px) / 2; height: 28px; width: 100%;
                                                HorizontalLayout { padding-left: 4px; spacing: 2px; alignment: start;
                                                    IconBtn { tooltip: head.muted ? "Unmute track" : "Mute track"; icon: @image-url("icons/mute.svg"); armed: head.muted; clicked => { root.active-panel = 3; root.pick("mute", head.index); keys.focus(); } }
                                                    if !head.video: TextBtn { label: "S"; width: 26px; tooltip: head.solo ? "Unsolo track" : "Solo track"; background: head.solo ? Palette.accent-muted : Palette.bg2; clicked => { root.active-panel = 3; root.pick("solo", head.index); keys.focus(); } }
                                                    IconBtn { tooltip: head.locked ? "Unlock track" : "Lock track"; icon: @image-url("icons/lock.svg"); armed: head.locked; clicked => { root.active-panel = 3; root.pick("lock", head.index); keys.focus(); } }
