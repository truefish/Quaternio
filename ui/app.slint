component PropLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> numeric: false;
    in property <bool> enabled: true;
    height: 28px; border-radius: 0px;
    HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px; 
        Text { text: root.label; width: 92px; color: root.enabled ? Palette.text-secondary : Palette.text-disabled; font-size: 12px; font-weight: 400; horizontal-alignment: left; vertical-alignment: center; }
        Text {
            text: root.value;
            color: root.enabled ? Palette.text-primary : Palette.text-disabled;
            font-size: 12px;
            font-weight: 500;
            horizontal-alignment: root.numeric ? right : left;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

component SliderTrack inherits Rectangle {
    in-out property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> bipolar: false;
    in property <bool> enabled: true;
    callback changed(float);
    height: 28px; min-width: 32px; border-radius: 4px;
    Rectangle { y: (parent.height - 3px) / 2; height: 3px; width: 100%; border-radius: 2px; background: Palette.bg3; }
    Rectangle {
        y: (parent.height - 3px) / 2; height: 3px; border-radius: 2px; background: root.enabled ? Palette.accent : Palette.text-disabled;
        property <length> wpos: root.maximum <= root.minimum ? 0px : max(0, min(1, (root.value - root.minimum) / (root.maximum - root.minimum))) * parent.width;
        x: root.bipolar ? min(parent.width / 2, self.wpos) : 0px;
        width: root.bipolar ? max(parent.width / 2, self.wpos) - min(parent.width / 2, self.wpos) : max(0px, self.wpos);
    }
    Rectangle {
        width: 12px; height: 16px; border-radius: 4px; background: touch.pressed || touch.has-hover ? Palette.accent : Palette.text-primary; border-width: 1px;
        border-color: root.enabled ? Palette.accent : Palette.text-disabled;
        y: (parent.height - self.height) / 2;
        x: root.maximum <= root.minimum ? 0px : min(parent.width - self.width, max(0px, (root.value - root.minimum) / (root.maximum - root.minimum) * (parent.width - self.width)));
    }
    touch := LiveTouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.up) {
                root.value = max(root.minimum, min(root.maximum, root.minimum + ((self.mouse-x - 6px) / max(1px, self.width - 12px)) * (root.maximum - root.minimum)));
                root.changed(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.value = max(root.minimum, min(root.maximum, root.minimum + ((self.mouse-x - 6px) / max(1px, self.width - 12px)) * (root.maximum - root.minimum)));
                root.changed(root.value);
            }
        }
    }
}

component NumRow inherits Rectangle {
    in property <string> label;
    in property <string> read;
    in-out property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <bool> bipolar: false;
    in property <bool> enabled: true;
    in property <float> display-scale: 1;
    in property <bool> follow-model: false;
    in property <float> model-value: 0;
    callback changed(float);
    callback focused();
    changed model-value => { if (root.follow-model) { root.value = root.model-value; } }
    changed read => { if (!value-input.has-focus) { value-input.text = root.read; } }
    height: 32px; border-radius: 0px;
    HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px; 
        Text { text: root.label; width: 92px; color: root.enabled ? Palette.text-secondary : Palette.text-disabled; font-size: 12px; font-weight: 400; horizontal-alignment: left; vertical-alignment: center; }
        SliderTrack { value <=> root.value; minimum: root.minimum; maximum: root.maximum; bipolar: root.bipolar; enabled: root.enabled; changed(v) => { if (root.enabled) { root.focused(); root.changed(v); } } horizontal-stretch: 1; }
        Rectangle { width: 58px; height: 26px; background: root.enabled ? Palette.bg0 : Palette.bg1; border-width: 1px; border-color: value-input.has-focus ? Palette.accent : Palette.bg3; border-radius: 4px;
            value-input := TextInput {
                Timer { interval: 150ms; running: value-input.has-focus; triggered => { LiveFocus.heartbeat(); } }
                property <bool> live-focus-counted: false;
                text: root.read; x: 4px; width: parent.width - 8px; height: 100%;
                enabled: root.enabled; single-line: true;
                color: root.enabled ? Palette.text-primary : Palette.text-disabled; font-size: 12px; font-weight: 500;
                horizontal-alignment: right; vertical-alignment: center;
                accepted => {
                    if (self.text.is-float() && root.display-scale > 0) {
                        root.value = max(root.minimum, min(root.maximum, self.text.to-float() / root.display-scale));
                        root.changed(root.value);
                    }
                    self.text = root.read;
                }
                changed has-focus => { if (self.has-focus != self.live-focus-counted) { self.live-focus-counted = self.has-focus; if (self.has-focus) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); } } 
                    if (self.has-focus) {
                        root.focused();
                        self.text = "" + (round(root.value * root.display-scale * 100) / 100);
                    } else {
                        if (self.text.is-float() && root.display-scale > 0) {
                            root.value = max(root.minimum, min(root.maximum, self.text.to-float() / root.display-scale));
                            root.changed(root.value);
                        }
                        self.text = root.read;
                    }
                }
            }
        }
    }
}

component GradeWheel inherits VerticalLayout {
    in property <string> title;
    in property <string> read-m;
    in property <string> read-r;
    in property <string> read-g;
    in property <string> read-b;
    in-out property <float> master;
    in-out property <float> red;
    in-out property <float> green;
    in-out property <float> blue;
    callback changed(string, float);
    callback focused();
    spacing: 0px; alignment: start;
    Rectangle { height: 34px;
        HorizontalLayout { padding-left: 8px; padding-right: 8px; 
            Text { text: root.title; color: Palette.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            TextBtn { label: "Reset"; clicked => { root.master = 0; root.red = 0; root.green = 0; root.blue = 0; root.changed("m", 0); root.changed("r", 0); root.changed("g", 0); root.changed("b", 0); } }
        }
    }
    NumRow { focused => { root.focused(); } label: "Master"; read: root.read-m; value <=> root.master; minimum: -1; maximum: 1; bipolar: true; changed(v) => { root.changed("m", v); } }
    NumRow { focused => { root.focused(); } label: "Red"; read: root.read-r; value <=> root.red; minimum: -1; maximum: 1; bipolar: true; changed(v) => { root.changed("r", v); } }
    NumRow { focused => { root.focused(); } label: "Green"; read: root.read-g; value <=> root.green; minimum: -1; maximum: 1; bipolar: true; changed(v) => { root.changed("g", v); } }
    NumRow { focused => { root.focused(); } label: "Blue"; read: root.read-b; value <=> root.blue; minimum: -1; maximum: 1; bipolar: true; changed(v) => { root.changed("b", v); } }
}

component WheelWell inherits Rectangle {
    in property <string> title;
    in-out property <float> master: 0;
    in-out property <float> red: 0;
    in-out property <float> green: 0;
    in-out property <float> blue: 0;
    in property <string> read-m: "0.00";
    in property <string> read-r: "0.00";
    in property <string> read-g: "0.00";
    in property <string> read-b: "0.00";
    callback changed(string, float);
    width: 168px; border-radius: 0px;
    VerticalLayout { spacing: 4px; alignment: start;
        Text { text: root.title; color: Palette.text-primary; font-size: 11px; font-weight: 600; height: 22px; horizontal-alignment: left; vertical-alignment: center; }
        well := Rectangle {
            width: 168px; height: 168px; background: Palette.bg0; border-width: 1px; border-color: Palette.bg3; border-radius: 0px;
            Rectangle { x: parent.width / 2; y: 0px; width: 1px; height: 100%; background: Palette.bg3; }
            Rectangle { y: parent.height / 2; x: 0px; height: 1px; width: 100%; background: Palette.bg3; }
            Rectangle {
                width: 8px; height: 8px; background: Palette.accent; border-radius: 0px;
                x: ((root.red - root.blue) / 2 + 1) / 2 * (parent.width - self.width);
                y: (1 - root.master) / 2 * (parent.height - self.height);
            }
            area := LiveTouchArea {
                mouse-cursor: pointer;
                moved => {
                    if (self.pressed) {
                        root.red = max(-1, min(1, (self.mouse-x / self.width) * 2 - 1));
                        root.blue = -root.red;
                        root.master = max(-1, min(1, 1 - (self.mouse-y / self.height) * 2));
                        root.changed("m", root.master);
                        root.changed("r", root.red);
                        root.changed("b", root.blue);
                    }
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.up) {
                        root.red = max(-1, min(1, (self.mouse-x / self.width) * 2 - 1));
                        root.blue = -root.red;
                        root.master = max(-1, min(1, 1 - (self.mouse-y / self.height) * 2));
                        root.changed("m", root.master);
                        root.changed("r", root.red);
                        root.changed("b", root.blue);
                    }
                }
            }
        }
        SliderTrack { value <=> root.master; minimum: -1; maximum: 1; bipolar: true; changed(v) => { root.changed("m", v); } }
        HorizontalLayout { spacing: 4px; alignment: start;
            Text { text: "Y"; color: Palette.text-secondary; font-size: 11px; width: 12px; vertical-alignment: center; horizontal-alignment: left; }
            Text { text: root.read-m; color: Palette.text-primary; font-size: 11px; font-weight: 500; width: 36px; vertical-alignment: center; horizontal-alignment: right; }
            Text { text: "R"; color: Palette.text-secondary; font-size: 11px; width: 12px; vertical-alignment: center; }
            Text { text: root.read-r; color: Palette.text-primary; font-size: 11px; font-weight: 500; width: 36px; vertical-alignment: center; horizontal-alignment: right; }
        }
        HorizontalLayout { spacing: 4px; alignment: start;
            Text { text: "G"; color: Palette.text-secondary; font-size: 11px; width: 12px; vertical-alignment: center; }
            Text { text: root.read-g; color: Palette.text-primary; font-size: 11px; font-weight: 500; width: 36px; vertical-alignment: center; horizontal-alignment: right; }
            Text { text: "B"; color: Palette.text-secondary; font-size: 11px; width: 12px; vertical-alignment: center; }
            Text { text: root.read-b; color: Palette.text-primary; font-size: 11px; font-weight: 500; width: 36px; vertical-alignment: center; horizontal-alignment: right; }
        }
        TextBtn { label: "Reset"; clicked => { root.master = 0; root.red = 0; root.green = 0; root.blue = 0; root.changed("m", 0); root.changed("r", 0); root.changed("g", 0); root.changed("b", 0); } }
    }
}

global PaneDocking {
    in-out property <bool> active: false;
    in-out property <bool> cancelled: false;
    in-out property <int> pane: 0;
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
}

component PaneDragHeader inherits LiveTouchArea {
    in property <bool> draggable: false;
    in property <int> pane: 0;
    callback activated();
    callback dock-panel(float, float);
    property <bool> dragged: false;
    property <length> start-x;
    property <length> start-y;
    mouse-cursor: root.draggable ? (self.pressed ? grabbing : grab) : default;
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            root.dragged = false; PaneDocking.cancelled = false; root.start-x = self.absolute-position.x + self.mouse-x; root.start-y = self.absolute-position.y + self.mouse-y;
            root.activated();
        }
        if (event.kind == PointerEventKind.up && root.dragged && !PaneDocking.cancelled) {
            root.dock-panel((self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
            PaneDocking.active = false;
        }
        if (event.kind == PointerEventKind.cancel) { PaneDocking.active = false; PaneDocking.cancelled = true; }
    }
    moved => {
        if (self.pressed && root.draggable && !PaneDocking.cancelled) {
            PaneDocking.x = self.absolute-position.x + self.mouse-x; PaneDocking.y = self.absolute-position.y + self.mouse-y;
            if (abs(PaneDocking.x - root.start-x) > 4px || abs(PaneDocking.y - root.start-y) > 4px) {
                root.dragged = true; PaneDocking.pane = root.pane; PaneDocking.active = true; ToolHints.shown = false;
            }
        }
    }
    clicked => { if (!root.dragged) { root.activated(); } }
    changed has-hover => {
        if (self.has-hover && root.draggable && !self.pressed) {
            ToolHints.text = "Drag the Source or Project tab onto the other tab to swap panels";
            ToolHints.x = self.absolute-position.x + self.width / 2; ToolHints.y = self.absolute-position.y + self.height + 5px; ToolHints.shown = true;
        } else if (ToolHints.text == "Drag the Source or Project tab onto the other tab to swap panels") { ToolHints.shown = false; }
    }
}

component MediaDragArea inherits LiveTouchArea {
    in property <int> media-id;
    callback selected(bool, bool);
    property <bool> selection-ctrl: false;
    property <bool> selection-shift: false;
    callback media-drag(int, int, float, float);
    property <bool> dragged: false;
    property <length> start-x;
    property <length> start-y;
    mouse-cursor: pointer;
    function reconcile-release(release-x: length, release-y: length) {
        // A Flickable can defer the press until release for a quick gesture.
        // Reconcile the final position before deciding whether this was a click.
        if (!root.dragged && (abs(release-x - root.start-x) > 4px || abs(release-y - root.start-y) > 4px)) {
            root.dragged = true;
            root.media-drag(root.media-id, 1, release-x / 1px, release-y / 1px);
        }
    }
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            root.dragged = false;
            root.selection-ctrl = event.modifiers.control;
            root.selection-shift = event.modifiers.shift;
            root.start-x = self.absolute-position.x + self.mouse-x;
            root.start-y = self.absolute-position.y + self.mouse-y;
            ToolHints.shown = false;
            root.media-drag(root.media-id, 0, root.start-x / 1px, root.start-y / 1px);
        }
        if (event.kind == PointerEventKind.up) {
            root.reconcile-release(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            root.media-drag(root.media-id, root.dragged ? 2 : 3, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
        }
        if (event.kind == PointerEventKind.cancel) { root.media-drag(root.media-id, 3, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px); }
    }
    moved => {
        if (self.pressed) {
            if (abs(self.absolute-position.x + self.mouse-x - root.start-x) > 4px || abs(self.absolute-position.y + self.mouse-y - root.start-y) > 4px) { root.dragged = true; }
            if (root.dragged) { root.media-drag(root.media-id, 1, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px); }
        }
    }
    clicked => { root.reconcile-release(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); if (!root.dragged) { root.selected(root.selection-ctrl, root.selection-shift); } }
}

component MediaBin inherits Rectangle {
    in property <[BinItem]> bin-items;
    in property <[string]> bins;
    in property <string> current-bin: "";
    in property <bool> selected-media: false;
    in property <int> selected-count: 0;
    in property <int> sort-column: 0;
    in property <bool> sort-descending: false;
    callback select-media(int, bool, bool);
    callback sort-media(int);
    callback create-bin(string);
    callback choose-bin(string);
    callback move-to-bin(string);
    in property <bool> has-media: false;
    in property <bool> active: false;
    callback activated();
    in property <bool> dockable: false;
    callback dock-panel(float, float);
    in property <int> armed-kind: -1;
    in-out property <string> query: "";
    in-out property <int> bin-tab: 0;
    in-out property <bool> icon-view: false;
    in-out property <int> bin-filter: 0;
    in-out property <bool> filter-open: false;
    in-out property <length> filter-popup-x: 0px;
    in-out property <length> filter-popup-y: 0px;
    property <bool> wide-bin: root.width >= 520px;
    property <bool> show-folders: false;
    callback command(string);
    callback pick(string, int);
    callback focus-editor();
    callback media-drag(int, int, float, float);
    background: Palette.bg1; border-radius: 0px;
    VerticalLayout { spacing: 0;
        Rectangle { height: 32px; background: Palette.bg2; border-radius: 0px;
            PaneDragHeader { draggable: root.dockable; pane: 2; activated => { root.activated(); root.bin-tab = 0; root.focus-editor(); } dock-panel(x, y) => { root.dock-panel(x, y); } }
            Rectangle { x: 0px; y: 30px; width: 100%; height: 2px; background: root.active ? Palette.accent : transparent; }
            HorizontalLayout { padding-left: 8px; padding-right: 4px; spacing: 2px;
                TextBtn { label: "Media" + (root.selected-count > 1 ? " · " + root.selected-count : ""); tooltip: "Project media"; background: root.bin-tab == 0 ? Palette.accent-muted : transparent; clicked => { root.activated(); root.bin-tab = 0; } }
                Rectangle { width: 4px; }
                WsTab { label: "Transitions"; on: root.bin-tab == 1; clicked => { root.activated(); root.bin-tab = 1; root.icon-view = false; } }
                Rectangle { horizontal-stretch: 1; }
                TextBtn { label: "Import…"; tooltip: "Add video, audio or images"; clicked => { root.activated(); root.command("import"); } }
            }
        }
        if root.bin-tab == 0 && root.show-folders: Rectangle { height: 34px; background: Palette.bg1;
            ProjectOrganizer { x: 8px; y: 2px; width: parent.width - 16px; window-width: PopupBounds.width; window-height: PopupBounds.height;
                bins: root.bins; current-bin: root.current-bin; selected-media: root.selected-count > 0;
                create-bin(name) => { root.activated(); root.create-bin(name); root.focus-editor(); }
                choose-bin(name) => { root.activated(); root.choose-bin(name); root.focus-editor(); }
                move-to-bin(name) => { root.activated(); root.move-to-bin(name); root.focus-editor(); }
            }
        }
        if root.bin-tab == 0: Rectangle { height: 34px; background: Palette.bg1;
            HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 4px;
                Field { focused => { root.activated(); } placeholder: "Search media…"; value <=> root.query; horizontal-stretch: 1; min-width: 0px; }
                if root.query != "": TextBtn { label: "×"; tooltip: "Clear search"; clicked => { root.activated(); root.query = ""; } }
                TextBtn { label: "Bins"; tooltip: "Show folders and organize selected media"; background: root.show-folders ? Palette.accent-muted : transparent; clicked => { root.show-folders = !root.show-folders; } }
                IconBtn { tooltip: "List view"; icon: @image-url("icons/list.svg"); armed: !root.icon-view; clicked => { root.activated(); root.icon-view = false; } }
                IconBtn { tooltip: "Thumbnail view"; icon: @image-url("icons/grid.svg"); armed: root.icon-view; clicked => { root.activated(); root.icon-view = true; } }
                ChoiceButton { width: 28px; tooltip: "Filter media by type"; icon: @image-url("icons/filter.svg"); choices: [{text: "All media"}, {text: "Video"}, {text: "Audio"}, {text: "Still"}]; selected: root.bin-filter; armed: root.bin-filter != 0; chosen(index) => { root.activated(); root.bin-filter = index; root.command("filter"); } }
            }
        }
        if root.bin-tab == 0 && root.has-media && !root.icon-view: Rectangle { height: 26px; background: Palette.bg2; border-radius: 0px;
            Rectangle { y: 25px; height: 1px; width: 100%; background: Palette.bg3; }
            HorizontalLayout { width: parent.width; padding-left: 8px; padding-right: 8px; spacing: 8px;
                Rectangle { width: 8px; }
                TextBtn { label: "Name" + (root.sort-column == 0 ? (root.sort-descending ? " ↓" : " ↑") : ""); tooltip: "Sort by name · click again to reverse"; horizontal-stretch: 1; min-width: 0px; clicked => { root.activated(); root.sort-media(0); root.focus-editor(); } }
                if root.wide-bin: Text { text: "In"; width: 76px; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: left; vertical-alignment: center; }
                if root.wide-bin: Text { text: "Out"; width: 76px; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: left; vertical-alignment: center; }
                TextBtn { width: 100px; label: "Duration" + (root.sort-column == 1 ? (root.sort-descending ? " ↓" : " ↑") : ""); tooltip: "Sort by duration · click again to reverse"; clicked => { root.activated(); root.sort-media(1); root.focus-editor(); } }
                if root.wide-bin: Text { text: "FPS"; width: 36px; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
            }
        }
        Rectangle { vertical-stretch: 1; min-height: 110px; clip: true;
            if root.bin-tab == 0 && !root.has-media: VerticalLayout { padding: 16px; spacing: 8px; alignment: center;
                Text { text: root.query == "" && root.bin-filter == 0 ? "Your media starts here" : "No matching media"; color: Palette.text-primary; font-size: 13px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: root.query == "" && root.bin-filter == 0 ? "Drop files here or choose Import media." : "Try another search or media filter."; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout { alignment: center;
                    SecBtn { label: root.query == "" && root.bin-filter == 0 ? "Import media" : "Show all media"; clicked => { root.activated(); if (root.query == "" && root.bin-filter == 0) { root.command("import"); } else { root.query = ""; root.bin-filter = 0; root.command("filter"); } } }
                }
                Rectangle { vertical-stretch: 1; }
            }
            if root.bin-tab == 0 && root.has-media && !root.icon-view: Flickable {
                width: 100%; height: 100%;
                // Dragging a media row inserts it; wheel/trackpad gestures scroll.
                interactive: false;
                viewport-width: self.width;
                viewport-height: max(self.height, media-list.preferred-height);
                media-list := VerticalLayout { width: parent.width; alignment: start; spacing: 0;
                    for item in root.bin-items: Rectangle {
                        height: (root.bin-filter == 0 || (root.bin-filter == 1 && item.kind == "V") || (root.bin-filter == 2 && item.kind == "A") || (root.bin-filter == 3 && item.kind == "S")) ? (root.width >= 340px ? 30px : 44px) : 0px;
                        background: item.selected ? Palette.accent-muted : bin-row.has-hover ? Palette.bg3 : Palette.bg1;
                        clip: true;
                        border-radius: 0px;
                        bin-row := MediaDragArea { media-id: item.id; media-drag(id, phase, x, y) => { root.media-drag(id, phase, x, y); } selected(ctrl, shift) => { root.activated(); root.select-media(item.id, ctrl, shift); root.focus-editor(); } }
                        Rectangle { x: 0px; y: 0px; width: 2px; height: 100%; background: item.selected ? Palette.accent : Palette.bg1; }
                        HorizontalLayout { width: parent.width; padding-left: 8px; padding-right: 8px; spacing: 8px;
                            Rectangle { width: 8px; Rectangle { x: 0px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 0px; background: item.kind == "A" ? Palette.clip-audio : item.kind == "S" ? Palette.clip-still : Palette.clip-video; } }
                            VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 0; alignment: center;
                                Text { text: item.name; color: item.offline ? Palette.status-warning : Palette.text-primary; font-size: 12px; font-weight: 500; font-italic: item.offline; horizontal-alignment: left; vertical-alignment: center; overflow: elide; min-width: 0px; }
                                if root.width < 340px: Text { text: item.offline ? "Offline · relink media" : (item.fps == "" ? "" : item.fps + " fps"); color: item.offline ? Palette.status-warning : Palette.text-secondary; font-size: 11px; horizontal-alignment: left; overflow: elide; min-width: 0px; }
                            }
                            if root.wide-bin: Text { text: item.tc-in; width: 76px; color: Palette.text-secondary; font-size: 12px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; }
                            if root.wide-bin: Text { text: item.tc-out; width: 76px; color: Palette.text-secondary; font-size: 12px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; }
                            Text { text: item.duration; width: 100px; color: Palette.text-secondary; font-size: 12px; font-weight: 500; horizontal-alignment: right; vertical-alignment: center; }
                            if root.wide-bin: Text { text: item.fps; width: 36px; color: Palette.text-secondary; font-size: 12px; font-weight: 500; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
            }
            if root.bin-tab == 0 && root.has-media && root.icon-view: Flickable {
                width: 100%; height: 100%;
                interactive: false;
                viewport-width: self.width;
                viewport-height: max(self.height, media-cards.preferred-height);
                media-cards := VerticalLayout { width: parent.width; alignment: start; padding: 8px; spacing: 8px;
                    for item in root.bin-items: Rectangle {
                        height: (root.bin-filter == 0 || (root.bin-filter == 1 && item.kind == "V") || (root.bin-filter == 2 && item.kind == "A") || (root.bin-filter == 3 && item.kind == "S")) ? 76px : 0px; border-radius: 4px; clip: true; background: item.selected ? Palette.accent-muted : icon-row.has-hover ? Palette.bg3 : Palette.bg2;
                        icon-row := MediaDragArea { media-id: item.id; media-drag(id, phase, x, y) => { root.media-drag(id, phase, x, y); } selected(ctrl, shift) => { root.activated(); root.select-media(item.id, ctrl, shift); root.focus-editor(); } }
                        HorizontalLayout { padding: 8px; alignment: start; spacing: 10px;
                            Rectangle { width: 88px; height: 56px; border-radius: 4px; clip: true; background: item.kind == "A" ? Palette.clip-audio : Palette.bg0;
                                if !item.offline && item.kind != "A" && item.thumbnail.width > 0: Image { x: 0px; y: 0px; width: 100%; height: 100%; source: item.thumbnail; image-fit: contain; preferred-width: 0px; preferred-height: 0px; }
                                if item.offline || item.kind == "A" || item.thumbnail.width == 0: Text { text: item.kind == "A" ? "♫" : item.kind == "S" ? "▧" : "▶"; width: 100%; height: 100%; color: Palette.text-primary; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            VerticalLayout { horizontal-stretch: 1; min-width: 0px; alignment: center; spacing: 4px;
                                Text { text: item.name; color: item.offline ? Palette.status-warning : Palette.text-primary; font-size: 12px; font-weight: 500; font-italic: item.offline; horizontal-alignment: left; overflow: elide; min-width: 0px; }
                                Text { text: item.offline ? "Offline" : item.info; color: item.offline ? Palette.status-warning : Palette.text-secondary; font-size: 11px; horizontal-alignment: left; overflow: elide; min-width: 0px; }
                                Text { text: item.duration; color: Palette.text-secondary; font-size: 11px; horizontal-alignment: left; }
                            }
                        }
                    }
                }
            }
            if root.bin-tab == 1: Flickable {
                width: 100%; height: 100%;
                VerticalLayout { alignment: start; spacing: 0;
                    Rectangle { height: 22px; background: root.armed-kind == 0 ? Palette.accent-muted : t0.has-hover ? Palette.bg3 : Palette.bg1; t0 := LiveTouchArea { clicked => { root.activated(); root.pick("arm", 0); } } Rectangle { width: 2px; height: 100%; background: root.armed-kind == 0 ? Palette.accent : Palette.bg1; } HorizontalLayout { padding-left: 4px; spacing: 4px; Rectangle { width: 8px; height: 8px; background: Palette.trans-video; } Text { text: "Cross Dissolve"; color: Palette.text-primary; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; } } }
                    Rectangle { height: 22px; background: root.armed-kind == 1 ? Palette.accent-muted : t1.has-hover ? Palette.bg3 : Palette.bg1; t1 := LiveTouchArea { clicked => { root.activated(); root.pick("arm", 1); } } Rectangle { width: 2px; height: 100%; background: root.armed-kind == 1 ? Palette.accent : Palette.bg1; } HorizontalLayout { padding-left: 4px; spacing: 4px; Rectangle { width: 8px; height: 8px; background: Palette.trans-video; } Text { text: "Dip to Black"; color: Palette.text-primary; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; } } }
                    Rectangle { height: 22px; background: root.armed-kind == 2 ? Palette.accent-muted : t2.has-hover ? Palette.bg3 : Palette.bg1; t2 := LiveTouchArea { clicked => { root.activated(); root.pick("arm", 2); } } Rectangle { width: 2px; height: 100%; background: root.armed-kind == 2 ? Palette.accent : Palette.bg1; } HorizontalLayout { padding-left: 4px; spacing: 4px; Rectangle { width: 8px; height: 8px; background: Palette.trans-video; } Text { text: "Fade In"; color: Palette.text-primary; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; } } }
                    Rectangle { height: 22px; background: root.armed-kind == 3 ? Palette.accent-muted : t3.has-hover ? Palette.bg3 : Palette.bg1; t3 := LiveTouchArea { clicked => { root.activated(); root.pick("arm", 3); } } Rectangle { width: 2px; height: 100%; background: root.armed-kind == 3 ? Palette.accent : Palette.bg1; } HorizontalLayout { padding-left: 4px; spacing: 4px; Rectangle { width: 8px; height: 8px; background: Palette.trans-video; } Text { text: "Fade Out"; color: Palette.text-primary; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; } } }
                    Rectangle { height: 22px; background: root.armed-kind == 4 ? Palette.accent-muted : t4.has-hover ? Palette.bg3 : Palette.bg1; t4 := LiveTouchArea { clicked => { root.activated(); root.pick("arm", 4); } } Rectangle { width: 2px; height: 100%; background: root.armed-kind == 4 ? Palette.accent : Palette.bg1; } HorizontalLayout { padding-left: 4px; spacing: 4px; Rectangle { width: 8px; height: 8px; background: Palette.trans-audio; } Text { text: "Crossfade"; color: Palette.text-primary; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; } } }
                    Rectangle { height: 22px; background: root.armed-kind == 5 ? Palette.accent-muted : t5.has-hover ? Palette.bg3 : Palette.bg1; t5 := LiveTouchArea { clicked => { root.activated(); root.pick("arm", 5); } } Rectangle { width: 2px; height: 100%; background: root.armed-kind == 5 ? Palette.accent : Palette.bg1; } HorizontalLayout { padding-left: 4px; spacing: 4px; Rectangle { width: 8px; height: 8px; background: Palette.trans-audio; } Text { text: "Audio Fade In"; color: Palette.text-primary; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; } } }
                    Rectangle { height: 22px; background: root.armed-kind == 6 ? Palette.accent-muted : t6.has-hover ? Palette.bg3 : Palette.bg1; t6 := LiveTouchArea { clicked => { root.activated(); root.pick("arm", 6); } } Rectangle { width: 2px; height: 100%; background: root.armed-kind == 6 ? Palette.accent : Palette.bg1; } HorizontalLayout { padding-left: 4px; spacing: 4px; Rectangle { width: 8px; height: 8px; background: Palette.trans-audio; } Text { text: "Audio Fade Out"; color: Palette.text-primary; font-size: 11px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; } } }
                }
            }
        }
    }
}

component PreviewContext inherits Rectangle {
    in property <bool> preparing: false;
    in property <string> problem: "";
    in property <length> available-width;
    in property <length> available-height;
    height: min(52px, root.available-height); width: max(0px, root.available-width - 16px);
    x: 8px; y: max(0px, root.available-height - self.height - 8px);
    visible: root.preparing || root.problem != "";
    background: #171717e8; border-width: 1px; border-color: root.problem != "" ? #be8855 : Palette.bg3;
    Text { x: 8px; y: 4px; width: max(0px, parent.width - 16px); height: max(0px, parent.height - 8px);
        text: root.problem != "" ? root.problem : "Preparing preview…"; color: Palette.text-primary;
        font-size: 11px; wrap: word-wrap; overflow: elide; vertical-alignment: center; }
}

component SourcePane inherits Rectangle {
    in property <bool> preparing: false;
    in property <string> problem: "";
    in property <image> source-image;
    in property <bool> active: false;
    callback activated();
    in property <bool> dockable: false;
    callback dock-panel(float, float);
    in property <bool> show-picture: false;
    in property <bool> has-selected-media: false;
    in property <string> source-name;
    in property <[Glyph]> duration-tc;
    in property <[Glyph]> cursor-tc;
    in property <string> cursor-text;
    callback begin-timecode();
    callback seek-timecode(string) -> bool;
    in property <bool> usable: false;
    in property <bool> playing: false;
    in property <float> position: 0;
    in property <float> in-position: 0;
    in property <float> out-position: 1;
    in property <bool> range-on: false;
    in property <string> range-label;
    in property <string> placeholder;
    in property <string> play-hint;
    in property <string> in-hint;
    in property <string> out-hint;
    in property <string> back-hint;
    in property <string> forward-hint;
    in property <string> clear-hint;
    callback scrub(int, float);
    callback source-resized(float, float);
    callback command(string);
    callback focus-editor();
    background: Palette.bg0; clip: true;
    VerticalLayout { spacing: 0;
        Rectangle { height: 30px; background: Palette.bg2;
            PaneDragHeader { draggable: root.dockable; pane: 0; activated => { root.activated(); root.focus-editor(); } dock-panel(x, y) => { root.dock-panel(x, y); } }
            Rectangle { x: 0px; y: 28px; width: 100%; height: 2px; background: root.active ? Palette.accent : transparent; }
            HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px;
                Text { text: "Source"; color: Palette.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                Text { text: root.has-selected-media ? root.source-name : "No media selected"; color: Palette.text-secondary; font-size: 12px; horizontal-stretch: 1; min-width: 0px; overflow: elide; vertical-alignment: center; }
            }
        }
        Rectangle { vertical-stretch: 1; min-height: 32px; clip: true; background: Palette.bg0;
            changed width => { root.source-resized(self.width / 1px, self.height / 1px); }
            changed height => { root.source-resized(self.width / 1px, self.height / 1px); }
            LiveTouchArea { clicked => { root.activated(); root.focus-editor(); } }
            if root.show-picture: Image { width: 100%; height: 100%; source: root.source-image; image-fit: contain; horizontal-alignment: center; vertical-alignment: center; preferred-width: 0px; preferred-height: 0px; }
            if !root.show-picture: Text { text: root.placeholder; x: 16px; width: parent.width - 32px; height: 100%; wrap: word-wrap; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            PreviewContext { available-width: parent.width; available-height: parent.height; preparing: root.show-picture && root.preparing; problem: root.show-picture ? root.problem : ""; }
        }
        Rectangle { height: 24px; background: Palette.bg2;
            HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px;
                TimecodeEntry { cells: root.cursor-tc; value: root.cursor-text; enabled: root.usable; ink: root.active ? Palette.accent : Palette.text-primary; begin => { root.activated(); root.begin-timecode(); } seek(text) => { root.seek-timecode(text) } finished => { root.focus-editor(); } }
                Rectangle { horizontal-stretch: 1; }
                TcRun { cells: root.duration-tc; main: false; ink: Palette.text-secondary; }
            }
        }
        Rectangle { height: 16px; background: Palette.bg2;
            Rectangle { x: 8px; y: 7px; width: parent.width - 16px; height: 4px; background: Palette.bg3;
                Rectangle { x: max(0, min(1, root.in-position)) * parent.width; width: max(0, root.out-position - root.in-position) * parent.width; height: 4px; background: root.range-on ? Palette.accent-muted : transparent; }
                Rectangle { x: max(0, min(1, root.in-position)) * (parent.width - 2px); y: -3px; width: 2px; height: 10px; background: root.range-on ? Palette.text-primary : transparent; }
                Rectangle { x: max(0, min(1, root.out-position)) * (parent.width - 2px); y: -3px; width: 2px; height: 10px; background: root.range-on ? Palette.text-primary : transparent; }
                Rectangle { x: max(0, min(1, root.position)) * (parent.width - 2px); y: -4px; width: 2px; height: 12px; background: root.usable ? Palette.accent : Palette.text-disabled; }
            }
            seek := LiveTouchArea { enabled: root.usable; mouse-cursor: pointer;
                pointer-event(event) => {
                    root.activated(); root.focus-editor();
                    if (event.kind == PointerEventKind.down) { root.scrub(0, max(0, min(1, (self.mouse-x - 8px) / max(1px, self.width - 16px)))); }
                    if (event.kind == PointerEventKind.up) { root.scrub(2, max(0, min(1, (self.mouse-x - 8px) / max(1px, self.width - 16px)))); }
                    if (event.kind == PointerEventKind.cancel) { root.scrub(3, 0); }
                }
                moved => { if (self.pressed) { root.scrub(1, max(0, min(1, (self.mouse-x - 8px) / max(1px, self.width - 16px)))); } }
            }
        }
        Rectangle { height: 34px; background: Palette.bg2;
            HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 2px; alignment: center;
                IconBtn { icon: @image-url("icons/step-back.svg"); enabled: root.usable; tooltip: "Previous source frame · " + root.back-hint; clicked => { root.activated(); root.command("source-step-back"); root.focus-editor(); } }
                PlayBtn { enabled: root.usable; stopped: !root.playing; tooltip: "Source play / pause · " + root.play-hint; clicked => { root.activated(); root.command("source-play-toggle"); root.focus-editor(); } }
                IconBtn { icon: @image-url("icons/step-forward.svg"); enabled: root.usable; tooltip: "Next source frame · " + root.forward-hint; clicked => { root.activated(); root.command("source-step-fwd"); root.focus-editor(); } }
                IconBtn { icon: @image-url("icons/mark-in.svg"); enabled: root.usable; tooltip: "Mark source In · " + root.in-hint; clicked => { root.activated(); root.command("source-mark-in"); root.focus-editor(); } }
                IconBtn { icon: @image-url("icons/mark-out.svg"); enabled: root.usable; tooltip: "Mark source Out (includes this frame) · " + root.out-hint; clicked => { root.activated(); root.command("source-mark-out"); root.focus-editor(); } }
                IconBtn { icon: @image-url("icons/insert.svg"); enabled: root.has-selected-media; tooltip: "Insert marked source into the sequence"; clicked => { root.activated(); root.command("insert"); root.focus-editor(); } }
                IconBtn { icon: @image-url("icons/overwrite.svg"); enabled: root.has-selected-media; tooltip: "Overwrite sequence with marked source"; clicked => { root.activated(); root.command("overwrite"); root.focus-editor(); } }
            }
        }
        Rectangle { height: 22px; background: Palette.bg2;
            Text { x: 8px; width: parent.width - 44px; height: 100%; text: root.range-label; color: Palette.text-secondary; font-size: 10px; overflow: elide; vertical-alignment: center; }
            LiveTouchArea { changed has-hover => { if (self.has-hover) { ToolHints.text = root.range-label; ToolHints.x = self.absolute-position.x + self.width / 2; ToolHints.y = self.absolute-position.y + self.height + 4px; ToolHints.shown = true; } else if (ToolHints.text == root.range-label) { ToolHints.shown = false; } } }
            TextBtn { x: parent.width - 32px; width: 24px; height: 20px; label: "×"; enabled: root.usable && root.range-on; tooltip: "Clear source In/Out · " + root.clear-hint; clicked => { root.activated(); root.command("source-clear-io"); root.focus-editor(); } }
        }
    }
}

component ToolBtn inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> armed: false;
    in property <string> tooltip: "";
    callback clicked();
    horizontal-stretch: 0; height: 28px; border-radius: 4px;
    border-width: 0px; border-color: Palette.accent;
    background: root.armed ? Palette.accent-muted : touch.show-pressed ? Palette.row-pressed : touch.has-hover ? Palette.bg3 : Palette.bg2;
    touch := LiveTouchArea { mouse-cursor: pointer; clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                ToolHints.text = root.tooltip;
                ToolHints.x = self.absolute-position.x + self.width / 2;
                ToolHints.y = self.absolute-position.y + self.height + 5px;
                ToolHints.shown = true;
            } else if (ToolHints.text == root.tooltip) { ToolHints.shown = false; }
        }
    }
    HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 6px; alignment: start;
        Rectangle { width: 16px; Image { x: 0px; y: (parent.height - 16px) / 2; source: root.icon; width: 16px; height: 16px; image-fit: contain; colorize: root.armed ? Palette.accent : Palette.text-secondary; } }
        Text { text: root.label; color: root.armed ? Palette.accent : Palette.text-secondary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
    }
}

export component AppWindow inherits Window {
    title: root.window-title + (root.live-preview ? " · Live" : "");
    icon: @image-url("icons/quaternio.svg");
    in-out property <string> window-title: "Quaternio";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1120px;
    min-height: 720px;
    background: Palette.bg0;
    default-font-family: "Inter";
    default-font-size: 12px;
    default-font-weight: 400;
    forward-focus: keys;

    in-out property <int> page: 0;
    in-out property <int> active-panel: 1;
    in-out property <bool> show-command-palette: false;
    in-out property <string> command-query: "";
    in-out property <int> command-selection: 0;
    in property <[CommandItem]> command-items;
    changed show-command-palette => {
        if (root.show-command-palette) {
            root.open-menu = 0; root.filter-open = false; root.quality-open = false;
            ToolHints.shown = false;
            palette-input.focus();
        } else { keys.focus(); }
    }
    changed command-query => { root.command-selection = 0; palette-results.viewport-y = 0px; }
    changed command-selection => {
        if (root.command-selection >= 0) {
            if (root.command-selection * 42px + 8px + palette-results.viewport-y < 0px) {
                palette-results.viewport-y = -root.command-selection * 42px - 8px;
            } else if (root.command-selection * 42px + 48px + palette-results.viewport-y > palette-results.height) {
                palette-results.viewport-y = palette-results.height - root.command-selection * 42px - 48px;
            }
        }
    }
    in-out property <int> open-menu: 0;
    in property <string> profile-name: "Premiere";
    in property <string> timecode: "00:00:00:00";
    in property <string> source-timecode: "00:00:00:00";
    callback timecode-begin(bool);
    callback timecode-seek(bool, string) -> bool;
    in property <string> status-text: "Ready";
    in property <bool> import-busy: false;
    in property <float> import-progress: 0;
    in property <string> import-status: "";
    out property <bool> live-input-active: LiveFocus.active;
    in property <bool> live-preview: false;
    in property <bool> live-reloading: false;
    changed live-reloading => { KeyboardControls.blocked = root.live-reloading; if (root.live-reloading) { ToolHints.shown = false; keys.focus(); } }
    Timer { interval: 250ms; running: LiveFocus.active; triggered => { LiveFocus.sweep(); } }
    Timer { interval: 400ms; running: ToolHints.shown && !ToolHints.ready; triggered => { ToolHints.ready = true; } }
    in property <string> live-status: "";
    in property <bool> live-update-pending: false;
    in property <bool> live-update-blocked: false;
    in property <string> sequence-label: "1920×1080  24  Sequence 01";
    in property <string> project-name: "Untitled";
    in property <string> source-name: "No clip";
    in property <string> seq-name: "Sequence 01";
    in property <string> seq-fps: "24";
    in property <float> sequence-aspect: 1.7777778;
    in property <string> footer-mem: "—";
    in property <string> footer-scratch: "—";
    in property <bool> snap-on: true;
    in property <bool> tool-razor: false;
    in property <string> armed-label: "";
    in property <string> shuttle: "STOP";
    in property <bool> shuttle-silent: false;
    in property <string> playback-label: "Stopped";
    in property <string> cache-label: "Cached";
    in-out property <bool> preview-cache-auto: true;
    in-out property <bool> preview-cache-paused: false;
    in-out property <int> preview-cache-limit-gb: 10;
    in property <string> preview-cache-status: "";
    in property <string> preview-cache-label: "Previews auto";
    callback preview-cache-settings();
    callback preview-cache-clear();
    in property <string> save-label: "Unsaved";
    in property <string> zoom-label: "100%";
    in property <int> shortcut-revision: 0;
    pure callback shortcut-hint(string, int) -> string;
    in property <string> hint-insert: "Unassigned";
    in property <string> hint-overwrite: "Unassigned";
    in property <string> hint-razor: "Unassigned";
    in property <string> hint-split: "Unassigned";
    in property <string> hint-ripple: "Unassigned";
    in property <string> hint-lift: "Unassigned";
    in property <string> hint-snap: "Unassigned";
    in property <[BinItem]> bin-items;
    in property <[string]> bins;
    in property <string> current-bin: "";
    in property <[BinItem]> video-items;
    in property <int> project-selected-count: 0;
    in property <int> media-sort-column: 0;
    in property <bool> media-sort-descending: false;
    in property <[BinItem]> audio-items;
    in property <[TrackHead]> heads;
    in property <[MixerTrack]> mixer-tracks;
    in property <float> meter-left;
    in property <float> meter-right;
    in property <float> meter-hold-left;
    in property <float> meter-hold-right;
    in property <bool> meter-clip-left;
    in property <bool> meter-clip-right;
    in property <string> meter-read-left: "−∞";
    in property <string> meter-read-right: "−∞";
    in property <[ClipView]> clips;
    in property <[TransView]> trans;
    in property <[Tick]> ticks;
    in property <[Glyph]> program-tc;
    in property <[Glyph]> source-tc;
    in property <[Glyph]> duration-tc;
    in property <[Glyph]> source-dur-tc;
    in property <bool> source-usable: false;
    in property <bool> source-playing: false;
    in property <float> source-position: 0;
    in property <float> source-in-position: 0;
    in property <float> source-out-position: 1;
    in property <bool> source-range-on: false;
    in property <string> source-range-label: "Select media to preview and mark a range.";
    in property <string> source-placeholder: "Select a file in Media to preview it and mark In/Out.";
    in-out property <float> source-px-width: 340;
    in-out property <float> source-px-height: 240;
    in property <[Glyph]> bar-tc;
    in property <float> playhead-x: 0;
    in property <float> in-x: 0;
    in property <float> out-x: 0;
    in property <bool> in-on: false;
    in property <bool> out-on: false;
    in property <float> tracks-h: 140;
    in property <float> playhead-frame: 0;
    in property <float> seq-frames: 1;
    in property <float> in-frame: 0;
    in property <float> out-frame: 0;
    in property <float> scroll-frames: 0;
    in property <float> px: 8;
    in property <image> viewer-image;
    in property <image> source-image;
    in property <bool> show-picture: false;
    in property <bool> show-source-picture: false;
    in property <bool> program-preparing: false;
    in property <string> program-problem: "";
    in property <bool> source-preparing: false;
    in property <string> source-problem: "";
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in property <bool> has-selected-media: false;
    in property <int> inspector-mode: 0;
    in property <string> inspector-title: "No selection";
    in property <string> vid-count: "3";
    in property <string> aud-count: "2";
    in property <string> res-label: "1920×1080";
    in property <string> duration-label: "00:00:00:00";
    in property <string> read-seconds: "0.50";
    in property <[TrackHead]> lanes;
    in property <string> read-lift-m: "0.00";
    in property <string> read-lift-r: "0.00";
    in property <string> read-lift-g: "0.00";
    in property <string> read-lift-b: "0.00";
    in property <string> read-gamma-m: "0.00";
    in property <string> read-gamma-r: "0.00";
    in property <string> read-gamma-g: "0.00";
    in property <string> read-gamma-b: "0.00";
    in property <string> read-gain-m: "0.00";
    in property <string> read-gain-r: "0.00";
    in property <string> read-gain-g: "0.00";
    in property <string> read-gain-b: "0.00";
    in property <bool> has-media: false;
    in property <bool> has-clips: false;
    in-out property <float> pos-x: 0;
    in-out property <float> pos-y: 0;
    in-out property <float> scale-v: 1;
    in-out property <float> opacity-v: 1;
    in-out property <float> volume-v: 1;
    in-out property <float> exposure: 0;
    in-out property <float> contrast: 0;
    in-out property <float> highlights: 0;
    in-out property <float> shadows: 0;
    in-out property <float> temperature: 0;
    in-out property <float> tint: 0;
    in-out property <float> saturation: 0;
    in-out property <float> lift-m: 0;
    in-out property <float> lift-r: 0;
    in-out property <float> lift-g: 0;
    in-out property <float> lift-b: 0;
    in-out property <float> gamma-m: 0;
    in-out property <float> gamma-r: 0;
    in-out property <float> gamma-g: 0;
    in-out property <float> gamma-b: 0;
    in-out property <float> gain-m: 0;
    in-out property <float> gain-r: 0;
    in-out property <float> gain-g: 0;
    in-out property <float> gain-b: 0;
    in property <string> read-pos-x: "0";
    in property <string> read-pos-y: "0";
    in property <string> read-scale: "100%";
    in property <string> read-opacity: "100%";
    in property <string> read-volume: "100%";
    in property <string> read-exposure: "0.00";
    in property <string> read-contrast: "0";
    in property <string> read-highlights: "0";
    in property <string> read-shadows: "0";
    in property <string> read-temperature: "0";
    in property <string> read-tint: "0";
    in property <string> read-saturation: "0";
    in property <string> trans-name: "";
    in property <string> trans-anchor: "Cut";
    in-out property <float> trans-dur: 12;
    in property <string> read-trans: "12";
    in-out property <string> export-path: "";
    in-out property <string> export-width: "1920";
    in-out property <string> export-height: "1080";
    in-out property <int> export-fps: 1;
    in-out property <bool> export-initialized: false;
    in-out property <string> export-custom-rate: "";
    in property <[LabelItem]> export-rates: root.rates;
    in-out property <bool> export-inout: false;
    in-out property <float> export-crf: 21;
    in-out property <int> export-speed: 0;
    property <bool> export-speed-open: false;
    in-out property <int> export-encoder: 0;
    property <bool> export-encoder-open: false;
    in property <string> read-crf: "21";
    in property <float> export-progress: 0;
    in property <bool> export-preparing: false;
    in property <string> export-preparation-label: "Preparing";
    in property <float> export-preparation-progress: 0;
    property <float> export-shown-progress: root.export-preparing ? root.export-preparation-progress : root.export-progress;
    out property <float> export-percent: min(root.export-busy && !root.export-preparing ? 99 : 100, floor(min(1, max(0, root.export-shown-progress)) * 100 + 0.0001));
    in property <string> export-eta: "";
    in property <bool> export-cancelling: false;
    in property <string> export-message: "";
    in property <bool> export-busy: false;
    in property <[QueueItem]> queue-items;
    in property <bool> queue-pending: false;
    in property <bool> queue-has-finished: false;
    in-out property <bool> export-rate-open: false;
    in property <[LabelItem]> rates;
    in property <[LabelItem]> presets;
    in property <[ShortcutRow]> shortcuts;
    in-out property <bool> show-dialog: false;
    changed show-dialog => { if (!root.show-dialog) { keys.focus(); } }
    in-out property <bool> show-sequence-match: false;
    in-out property <string> sequence-match-description: "";
    callback sequence-match-choice(int);
    in property <bool> can-edit-selection: false;
    in property <bool> can-split: false;
    property <bool> export-presets-open: false;
    property <int> preferences-tab: 0;
    in property <string> dialog-title: "New project";
    in property <string> dialog-error: "";
    in property <bool> dialog-is-new: true;
    in-out property <string> dlg-name: "Untitled";
    in-out property <string> dlg-width: "1920";
    in-out property <string> dlg-height: "1080";
    in-out property <int> dlg-fps: 1;
    in-out property <bool> show-prefs: false;
    changed show-prefs => { keys.focus(); }
    in property <[KeyBindingRow]> keybinding-items;
    in-out property <string> keybinding-query: "";
    in-out property <string> binding-action: "";
    in-out property <string> binding-label: "";
    in property <string> binding-message: "";
    in property <bool> capturing-binding: false;
    in-out property <bool> vim-navigation: false;
    changed capturing-binding => {
        if (root.capturing-binding) { binding-capture.focus(); }
        else if (root.show-prefs) { keys.focus(); }
    }
    in-out property <string> query: "";
    in-out property <int> quality: 0;

    in-out property <int> workspace: 0;
    in-out property <int> grade-tab: 0;
    in property <int> armed-kind: -1;
    property <int> bin-tab: 0;
    property <bool> icon-view: false;
    in-out property <int> bin-filter: 0;
    property <bool> filter-open: false;
    property <length> filter-popup-x: 0px;
    property <length> filter-popup-y: 0px;
    property <bool> safe-margins: false;
    property <bool> show-source: false;
    property <bool> dual-view: false;
    in-out property <bool> basic-open: true;
    in-out property <bool> wheels-open: false;
    property <bool> motion-open: true;
    property <bool> opacity-open: true;
    in-out property <bool> linked-on: true;
    in-out property <bool> ripple-on: false;
    in-out property <bool> show-about: false;
    in-out property <bool> show-import-mode: false;
    in-out property <bool> show-import-report: false;
    in-out property <string> import-report-text: "";
    in property <bool> file-drop-hover: false;
    in-out property <bool> show-export-details: false;
    property <string> export-details: "";
    out property <bool> modal-open: root.show-dialog || root.show-prefs || root.show-about
        || root.show-import-mode || root.show-import-report || root.show-update-agree
        || root.show-sequence-match || root.capturing-binding || root.show-export-details;
    changed modal-open => { if (root.modal-open) { root.open-menu = 0; ToolHints.shown = false; } }
    in property <bool> update-available: false;
    in property <string> update-tooltip: "";
    in-out property <bool> show-update-agree: false;
    in property <string> update-agree-title: "";
    in property <string> update-agree-body: "";
    in property <string> app-version: "";
    in property <[VersionRow]> version-rows;
    in property <string> versions-status: "";
    in property <bool> versions-busy: false;
    callback version-install(string);
    callback version-open(string);
    property <bool> quality-open: false;
    property <length> view-w: 640px;
    property <length> view-h: 360px;
    property <length> time-w: 800px;
    property <length> time-body: max(140px, root.time-h - 80px);
    out property <float> body-px: root.time-body / 1px;
    out property <float> timeline-px: max(1px, root.width - (root.workspace == 0 ? root.bottom-bin-w + 5px : 0px) - 160px - root.track-scrollbar-width) / 1px;
    out property <float> preview-px-width: max(1px, root.workspace == 1 ? root.preview-w : root.view-region) / 1px;
    out property <float> preview-px-height: max(1px, root.upper-h - 126px) / 1px;
    in-out property <bool> project-top: false;
    // Zero keeps the two monitors balanced until the divider is dragged.
    in-out property <float> source-width: 0;
    in-out property <float> properties-width: 300;
    in-out property <float> project-width: 320;
    in-out property <float> upper-ratio: 0.55;
    out property <float> timeline-origin-x: ((root.workspace == 0 ? root.bottom-bin-w + 5px : 0px) + 160px) / 1px;
    out property <float> timeline-origin-y: (root.upper-h + 150px) / 1px;
    property <float> track-scroll-position: 0;
    property <float> track-scroll-max: max(0, root.tracks-h - root.body-px);
    property <length> track-scrollbar-width: root.track-scroll-max > 0.5 ? 14px : 0px;
    out property <float> timeline-scroll-y: max(0, min(root.track-scroll-position, root.track-scroll-max));
    changed tracks-h => { root.track-scroll-position = root.timeline-scroll-y; }
    changed body-px => { root.track-scroll-position = root.timeline-scroll-y; }
    public function scroll-tracks-to(offset: float) {
        root.track-scroll-position = max(0, min(root.track-scroll-max, offset));
    }
    function scroll-tracks(delta-y: float, delta-x: float, x: float, control: bool, shift: bool) {
        if (control || shift) {
            root.wheel(delta-y != 0 ? delta-y : delta-x, x, control);
        } else {
            root.track-scroll-position = max(0, min(root.track-scroll-max, root.timeline-scroll-y - delta-y));
            if (delta-x != 0) { root.wheel(delta-x, x, false); }
        }
    }
    in property <bool> media-drag-active: false;
    in property <bool> media-drop-valid: false;
    in property <[DropGhost]> media-drop-ghosts;
    in property <string> media-drop-hint: "Move to compatible, unlocked tracks";
    in property <float> media-drag-x: 0;
    in property <float> media-drag-y: 0;
    in property <string> media-drag-label: "";
    in property <float> media-drop-x: 0;
    in property <float> media-drop-y: 0;
    in property <float> media-drop-width: 0;
    in property <float> media-drop-height: 0;
    property <length> mid-h: root.height - 84px;
    property <length> upper-h: max(280px, min(root.mid-h - 288px, (root.mid-h - 8px) * root.upper-ratio));
    property <length> time-h: root.mid-h - root.upper-h - 8px;
    property <length> span: root.width - 10px;
    property <length> preview-w: 480px;
    property <length> bin-w: root.workspace == 2 ? 240px : root.workspace == 1 ? root.width - root.preview-w - 5px : max(240px, min(root.project-top ? root.project-width * 1px : root.source-width > 0 ? root.source-width * 1px : (root.width - root.insp-w - 10px) / 2, root.width - root.insp-w - 330px));
    property <length> bottom-bin-w: max(240px, min((root.project-top ? (root.source-width > 0 ? root.source-width : 320) : root.project-width) * 1px, root.width - 745px));
    property <length> insp-w: root.workspace == 1 ? 0px : max(260px, min(root.properties-width * 1px, root.width - 570px));
    property <length> view-region: root.span - root.bin-w - root.insp-w;
    property <bool> pair: false;
    property <bool> wide-bin: root.bin-w >= 520px;
    property <bool> show-status-extra: root.width >= 1440px;
    property <bool> stack-wheels: root.insp-w < 560px;
    property <string> quality-name: root.quality == 2 ? "Quarter" : root.quality == 1 ? "Half" : "Full";

    callback command(string);
    callback palette-run(string);
    callback select-media(int, bool, bool);
    callback sort-media(int);
    callback binding-edit(string);
    callback binding-reset(string);
    callback create-bin(string);
    callback choose-bin(string);
    callback move-to-bin(string);
    callback media-drag(int, int, float, float);
    callback adjust(string, float);
    callback mix-track(int, string, float);
    callback pick(string, int);
    callback timeline(int, int, float, float, bool, bool);
    callback razor-hover(bool, float, float);
    in property <[RazorGuide]> razor-guides;
    in property <string> razor-text;
    in property <bool> razor-valid;
    in property <float> razor-label-x;
    in property <float> razor-label-y;
    // Timeline lives inside a conditional component; retain only event-fed
    // interaction state here rather than reaching through that component's ID.
    property <bool> razor-track-hover: false;
    property <bool> razor-track-pressed: false;
    changed page => { root.razor-track-hover = false; root.razor-track-pressed = false; }
    changed workspace => { root.razor-track-hover = false; root.razor-track-pressed = false; }
    out property <bool> razor-hover-allowed: root.tool-razor && root.page == 0 && root.razor-track-hover && !root.razor-track-pressed
        && root.open-menu == 0 && !root.filter-open && !root.quality-open && !root.show-dialog && !root.show-prefs
        && !root.show-about && !root.show-command-palette && !root.show-sequence-match && !root.live-reloading && !LiveFocus.active;
    in property <[RazorGuide]> edit-guides;
    in property <string> edit-text;
    in property <bool> edit-valid: true;
    in property <int> edit-cursor: 0;
    in property <float> edit-label-x;
    in property <float> edit-label-y;
    out property <bool> edit-feedback-allowed: !root.tool-razor && root.page == 0 && root.razor-track-hover
        && root.open-menu == 0 && !root.filter-open && !root.quality-open && !root.show-dialog && !root.show-prefs
        && !root.show-about && !root.show-command-palette && !root.show-sequence-match && !root.live-reloading
        && (!LiveFocus.active || root.razor-track-pressed);
    callback wheel(float, float, bool);
    callback viewer(int, float, float);
    callback source-scrub(int, float);
    callback resized(float, float, float, float);
    callback key-cmd(string, bool, bool, bool);

    property <length> dock-target-y: root.project-top == (PaneDocking.pane == 0) ? 62px : root.upper-h + 70px;
    property <length> dock-target-width: root.project-top == (PaneDocking.pane == 0) ? root.bin-w : root.bottom-bin-w;
    property <bool> pane-drag-valid: root.page == 0 && root.workspace == 0 && PaneDocking.x >= 0px && PaneDocking.x <= root.dock-target-width && PaneDocking.y >= root.dock-target-y && PaneDocking.y <= root.dock-target-y + 32px;
    function dock-pane(source: bool, x: float, y: float) {
        if (root.page == 0 && root.workspace == 0) {
            if (root.project-top == source) {
                if (x >= 0 && x <= root.bin-w / 1px && y >= 62 && y <= 94) { root.command("toggle-project-dock"); }
            } else {
                if (x >= 0 && x <= root.bottom-bin-w / 1px && y >= (root.upper-h + 70px) / 1px && y <= (root.upper-h + 102px) / 1px) { root.command("toggle-project-dock"); }
            }
        }
    }

    public function focus-pane(pane: int) {
        keys.focus();
        root.active-panel = max(0, min(4, pane));
    }
    pure function normalized-key(text: string) -> string {
        if (text == Key.LeftArrow) { return "left"; }
        if (text == Key.RightArrow) { return "right"; }
        if (text == Key.UpArrow) { return "up"; }
        if (text == Key.DownArrow) { return "down"; }
        if (text == Key.Delete) { return "delete"; }
        if (text == Key.Backspace) { return "backspace"; }
        if (text == Key.Home) { return "home"; }
        if (text == Key.End) { return "end"; }
        if (text == Key.Escape) { return "escape"; }
        if (text == Key.Space) { return "space"; }
        if (text == Key.Return) { return "return"; }
        if (text == Key.Tab) { return "tab"; }
        if (text == Key.PageUp) { return "pageup"; }
        if (text == Key.PageDown) { return "pagedown"; }
        if (text == Key.Insert) { return "insert"; }
        if (text == Key.F1) { return "f1"; }
        if (text == Key.F2) { return "f2"; }
        if (text == Key.F3) { return "f3"; }
        if (text == Key.F4) { return "f4"; }
        if (text == Key.F5) { return "f5"; }
        if (text == Key.F6) { return "f6"; }
        if (text == Key.F7) { return "f7"; }
        if (text == Key.F8) { return "f8"; }
        if (text == Key.F9) { return "f9"; }
        if (text == Key.F10) { return "f10"; }
        if (text == Key.F11) { return "f11"; }
        if (text == Key.F12) { return "f12"; }
        return text;
    }

    public function focus-controls() { if (!root.live-reloading) { if (root.can-undo) { undo-control.focus(); } else { preferences-control.focus(); } } }
    public function focus-menu() { if (!root.live-reloading) { root.open-menu = 1; } }

    keys := FocusScope {
        width: 100%; height: 100%;
        changed has-focus => { if (self.has-focus) { KeyboardControls.navigating = false; } }
        key-pressed(event) => {
            if (root.live-reloading) { return accept; }
            if (root.modal-open && event.text != Key.Escape) { return reject; }
            if (KeyboardControls.navigating && (event.text == Key.Tab || event.text == Key.Backtab)) { return reject; }
            if (KeyboardControls.navigating && event.text == Key.Escape) { KeyboardControls.navigating = false; keys.focus(); return accept; }
            if (event.text == Key.Escape && PaneDocking.active) { PaneDocking.active = false; PaneDocking.cancelled = true; return accept; }
            root.key-cmd(root.normalized-key(event.text), event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
            accept
        }

        VerticalLayout {
            spacing: 0;
            Rectangle {
                height: 30px; background: Palette.bg2; border-radius: 0px;
                Rectangle { y: 29px; height: 1px; width: 100%; background: Palette.bg3; }
                HorizontalLayout { alignment: start; spacing: 0;
                    BarItem { label: "File"; w: 48px; on: root.open-menu == 1; clicked => { root.open-menu = root.open-menu == 1 ? 0 : 1; } }
                    BarItem { label: "Edit"; w: 46px; on: root.open-menu == 2; clicked => { root.open-menu = root.open-menu == 2 ? 0 : 2; } }
                    BarItem { label: "Clip"; w: 46px; on: root.open-menu == 3; clicked => { root.open-menu = root.open-menu == 3 ? 0 : 3; } }
                    BarItem { label: "Sequence"; w: 78px; on: root.open-menu == 4; clicked => { root.open-menu = root.open-menu == 4 ? 0 : 4; } }
                    BarItem { label: "Mark"; w: 48px; on: root.open-menu == 5; clicked => { root.open-menu = root.open-menu == 5 ? 0 : 5; } }
                    BarItem { label: "Color"; w: 52px; on: root.open-menu == 6; clicked => { root.open-menu = root.open-menu == 6 ? 0 : 6; } }
                    BarItem { label: "View"; w: 48px; on: root.open-menu == 7; clicked => { root.open-menu = root.open-menu == 7 ? 0 : 7; } }
                    BarItem { label: "Window"; w: 64px; on: root.open-menu == 8; clicked => { root.open-menu = root.open-menu == 8 ? 0 : 8; } }
                    BarItem { label: "Help"; w: 48px; on: root.open-menu == 9; clicked => { root.open-menu = root.open-menu == 9 ? 0 : 9; } }
                }
            }
            Rectangle {
                height: 32px; background: Palette.bg2; border-radius: 0px;
                Rectangle { y: 31px; height: 1px; width: 100%; background: Palette.bg3; }
                HorizontalLayout { spacing: 0; padding-right: 4px;
                    WsTab { label: "Media"; on: root.page == 0 && root.workspace == 1; clicked => { root.command("workspace-media"); } }
                    WsTab { label: "Edit"; on: root.page == 0 && root.workspace == 0; clicked => { root.command("workspace-edit"); } }
                    WsTab { label: "Color"; on: root.page == 0 && root.workspace == 2; clicked => { root.command("workspace-color"); } }
                    WsTab { label: "Export"; on: root.page == 1; clicked => { root.command("export-view"); } }
                    Rectangle { width: 8px; }
                    Rectangle { width: 1px; height: 32px;
                        Rectangle { y: 8px; width: 1px; height: 12px; background: Palette.bg3; }
                    }
                    Rectangle { width: 8px; }
                    Text { text: root.project-name; color: Palette.text-primary; font-size: 12px; font-weight: 500; horizontal-stretch: 1; min-width: 0px; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                    Rectangle { width: 8px; }
                    Text { text: root.save-label; color: Palette.text-secondary; font-size: 11px; font-weight: 400; horizontal-alignment: left; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    TextBtn { label: "Import…"; tooltip: "Add media · " + root.shortcut-hint("import", root.shortcut-revision); clicked => { root.command("import"); } }
                    TextBtn { label: "Save"; tooltip: "Save project · " + root.shortcut-hint("save", root.shortcut-revision); clicked => { root.command("save"); } }
                    IconBtn { icon: @image-url("icons/search.svg"); tooltip: "Search commands · " + root.shortcut-hint("commands", root.shortcut-revision); clicked => { root.command-query = ""; root.show-command-palette = true; } }
                    Rectangle { width: 8px; }
                    if root.update-available: IconBtn {
                        retain-keyboard-focus: false;
                        tooltip: root.update-tooltip;
                        icon: @image-url("icons/update.svg");
                        armed: true;
                        clicked => { root.command("update-badge"); }
                    }
                    if root.update-available: Rectangle { width: 8px; }
                    undo-control := IconBtn { enabled: root.can-undo; tooltip: "Undo · " + root.shortcut-hint("undo", root.shortcut-revision) + (root.can-undo ? "" : "\nNothing to undo."); icon: @image-url("icons/undo.svg"); clicked => { root.command("undo"); } }
                    Rectangle { width: 2px; }
                    IconBtn { enabled: root.can-redo; tooltip: "Redo · " + root.shortcut-hint("redo", root.shortcut-revision) + (root.can-redo ? "" : "\nNothing to redo."); icon: @image-url("icons/redo.svg"); clicked => { root.command("redo"); } }
                    Rectangle { width: 8px; }
                    preferences-control := IconBtn { retain-keyboard-focus: false; tooltip: "Preferences and keyboard shortcuts · " + root.shortcut-hint("preferences", root.shortcut-revision); icon: @image-url("icons/list.svg"); clicked => { root.show-prefs = true; } }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
                if root.page == 0: VerticalLayout {
                    spacing: 0;
                    width: parent.width;
                    height: parent.height;
            Rectangle {
                height: root.upper-h;
                vertical-stretch: 0;
                clip: true;
                HorizontalLayout { spacing: 0;
                    if root.workspace == 0 && !root.project-top: SourcePane { width: root.bin-w; active: root.active-panel == 0; activated => { root.active-panel = 0; } dockable: true; dock-panel(x, y) => { root.dock-pane(true, x, y); }
                        source-image: root.source-image; show-picture: root.show-source-picture; preparing: root.source-preparing; problem: root.source-problem; has-selected-media: root.has-selected-media; source-name: root.source-name; duration-tc: root.source-dur-tc;
                        cursor-tc: root.source-tc; cursor-text: root.source-timecode; usable: root.source-usable; playing: root.source-playing; position: root.source-position;
                        begin-timecode => { root.timecode-begin(true); } seek-timecode(text) => { root.timecode-seek(true, text) }
                        in-position: root.source-in-position; out-position: root.source-out-position; range-on: root.source-range-on; range-label: root.source-range-label; placeholder: root.source-placeholder;
                        play-hint: root.shortcut-hint("play-toggle", root.shortcut-revision); in-hint: root.shortcut-hint("mark-in", root.shortcut-revision); out-hint: root.shortcut-hint("mark-out", root.shortcut-revision);
                        back-hint: root.shortcut-hint("step-back", root.shortcut-revision); forward-hint: root.shortcut-hint("step-fwd", root.shortcut-revision); clear-hint: root.shortcut-hint("clear-io", root.shortcut-revision);
                        scrub(phase, position) => { root.source-scrub(phase, position); }
                        source-resized(w, h) => { if (w > 1 && h > 1) { root.source-px-width = w; root.source-px-height = h; } }
                        command(action) => { root.command(action); } focus-editor => { keys.focus(); }
                    }
                    if root.workspace != 0 || root.project-top: MediaBin { width: root.bin-w; active: root.active-panel == 2; activated => { root.active-panel = 2; } dockable: root.workspace == 0; dock-panel(x, y) => { root.dock-pane(false, x, y); }
                        selected-count: root.project-selected-count; sort-column: root.media-sort-column; sort-descending: root.media-sort-descending;
                        select-media(id, ctrl, shift) => { root.select-media(id, ctrl, shift); } sort-media(column) => { root.sort-media(column); }
                        bin-items: root.bin-items; has-media: root.has-media; armed-kind: root.armed-kind;
                        bins: root.bins; current-bin: root.current-bin; selected-media: root.has-selected-media;
                        create-bin(name) => { root.create-bin(name); } choose-bin(name) => { root.choose-bin(name); } move-to-bin(name) => { root.move-to-bin(name); }
                        query <=> root.query; bin-tab <=> root.bin-tab; icon-view <=> root.icon-view; bin-filter <=> root.bin-filter; filter-open <=> root.filter-open; filter-popup-x <=> root.filter-popup-x; filter-popup-y <=> root.filter-popup-y;
                        command(action) => { root.command(action); } pick(kind, id) => { root.pick(kind, id); } focus-editor => { keys.focus(); }
                        media-drag(id, phase, x, y) => { root.media-drag(id, phase, x, y); }
                    }
                    Rectangle { width: 5px; background: source-divider.pressed || source-divider.has-hover ? Palette.bg3 : Palette.bg0;
                        Rectangle { x: 2px; y: 0px; width: 1px; height: 100%; background: source-divider.pressed || source-divider.has-hover ? Palette.accent : Palette.bg3; }
                        source-divider := LiveTouchArea {
                            enabled: root.workspace == 0; mouse-cursor: ew-resize;
                            property <float> start-width;
                            property <length> start-x;
                            pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.start-width = root.bin-w / 1px; self.start-x = self.absolute-position.x + self.mouse-x; } }
                            moved => { if (self.pressed) { if (root.project-top) { root.project-width = max(240, min((root.width - root.insp-w - 330px) / 1px, self.start-width + (self.absolute-position.x + self.mouse-x - self.start-x) / 1px)); } else { root.source-width = max(240, min((root.width - root.insp-w - 330px) / 1px, self.start-width + (self.absolute-position.x + self.mouse-x - self.start-x) / 1px)); } } }
                        }
                    }
                    view-row := Rectangle {
                        width: parent.width - root.bin-w - root.insp-w - (root.workspace == 1 ? 5px : 10px);
                        background: Palette.bg0; clip: true;
                        if root.workspace == 1: SourcePane { width: 100%; height: 100%; active: root.active-panel == 0; activated => { root.active-panel = 0; }
                            source-image: root.source-image; show-picture: root.show-source-picture; preparing: root.source-preparing; problem: root.source-problem; has-selected-media: root.has-selected-media; source-name: root.source-name; duration-tc: root.source-dur-tc;
                            cursor-tc: root.source-tc; cursor-text: root.source-timecode; usable: root.source-usable; playing: root.source-playing; position: root.source-position;
                            begin-timecode => { root.timecode-begin(true); } seek-timecode(text) => { root.timecode-seek(true, text) }
                            in-position: root.source-in-position; out-position: root.source-out-position; range-on: root.source-range-on; range-label: root.source-range-label; placeholder: root.source-placeholder;
                            play-hint: root.shortcut-hint("play-toggle", root.shortcut-revision); in-hint: root.shortcut-hint("mark-in", root.shortcut-revision); out-hint: root.shortcut-hint("mark-out", root.shortcut-revision);
                            back-hint: root.shortcut-hint("step-back", root.shortcut-revision); forward-hint: root.shortcut-hint("step-fwd", root.shortcut-revision); clear-hint: root.shortcut-hint("clear-io", root.shortcut-revision);
                            scrub(phase, position) => { root.source-scrub(phase, position); }
                            source-resized(w, h) => { if (w > 1 && h > 1) { root.source-px-width = w; root.source-px-height = h; } }
                            command(action) => { root.command(action); } focus-editor => { keys.focus(); }
                        }
                        if root.workspace != 1: VerticalLayout { width: 100%; height: 100%; spacing: 0;
                            Rectangle { height: 30px; background: Palette.bg2;
                                LiveTouchArea { clicked => { root.active-panel = 1; keys.focus(); } }
                                Rectangle { x: 0px; y: 28px; width: 100%; height: 2px; background: root.active-panel == 1 ? Palette.accent : transparent; }
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px;
                                    Text { text: "Program"; color: Palette.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: root.seq-name; color: Palette.text-secondary; font-size: 12px; horizontal-stretch: 1; min-width: 0px; overflow: elide; vertical-alignment: center; }
                                }
                            }
                            view-frame := Rectangle { vertical-stretch: 1; min-height: 32px; background: Palette.bg0; clip: true;
                                changed width => { root.view-w = self.width; root.resized(self.width / 1px, self.height / 1px, root.timeline-px, root.body-px); }
                                changed height => { root.view-h = self.height; root.resized(self.width / 1px, self.height / 1px, root.timeline-px, root.body-px); }
                                property <length> picture-w: min(self.width, self.height * max(0.01, root.sequence-aspect));
                                property <length> picture-h: self.picture-w / max(0.01, root.sequence-aspect);
                                if root.show-picture && root.has-clips: Image { width: 100%; height: 100%; source: root.viewer-image; image-fit: contain; horizontal-alignment: center; vertical-alignment: center; preferred-width: 0px; preferred-height: 0px; }
                                PreviewContext { available-width: parent.width; available-height: parent.height; preparing: root.program-preparing; problem: root.program-problem; }
                                if root.has-clips && root.safe-margins: Rectangle { x: (parent.width - parent.picture-w) / 2 + parent.picture-w * 0.05; y: (parent.height - parent.picture-h) / 2 + parent.picture-h * 0.05; width: parent.picture-w * 0.90; height: parent.picture-h * 0.90; border-width: 1px; border-color: Palette.guide; }
                                if root.has-clips && root.safe-margins: Rectangle { x: (parent.width - parent.picture-w) / 2 + parent.picture-w * 0.10; y: (parent.height - parent.picture-h) / 2 + parent.picture-h * 0.10; width: parent.picture-w * 0.80; height: parent.picture-h * 0.80; border-width: 1px; border-color: Palette.guide; }
                                if !root.has-clips: VerticalLayout { padding: 24px; spacing: 10px; alignment: center;
                                    Rectangle { vertical-stretch: 1; }
                                    Text { text: "Sequence is empty"; color: Palette.text-primary; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
                                    Text { text: "Import media, then insert it into your timeline."; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                                    HorizontalLayout { alignment: center; PriBtn { label: "Import media"; clicked => { root.command("import"); keys.focus(); } } }
                                    Rectangle { vertical-stretch: 1; }
                                }
                                view-touch := LiveTouchArea { enabled: root.has-clips;
                                    pointer-event(event) => { root.active-panel = 1; keys.focus(); if (event.kind == PointerEventKind.down) { root.viewer(0, self.mouse-x / 1px, self.mouse-y / 1px); } if (event.kind == PointerEventKind.up) { root.viewer(2, self.mouse-x / 1px, self.mouse-y / 1px); } if (event.kind == PointerEventKind.cancel) { root.viewer(3, self.mouse-x / 1px, self.mouse-y / 1px); } }
                                    moved => { if (self.pressed) { root.viewer(1, self.mouse-x / 1px, self.mouse-y / 1px); } }
                                }
                            }
                            Rectangle { height: 24px; background: Palette.bg2;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px;
                                    TimecodeEntry { cells: root.program-tc; value: root.timecode; enabled: root.has-clips; ink: root.active-panel == 1 ? Palette.accent : Palette.text-primary; begin => { root.timecode-begin(false); } seek(text) => { root.timecode-seek(false, text) } finished => { keys.focus(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                    TcRun { cells: root.duration-tc; main: false; ink: Palette.text-secondary; }
                                }
                            }
                            Rectangle { height: 16px; background: Palette.bg2;
                                Rectangle { x: 8px; y: 7px; width: parent.width - 16px; height: 4px; background: Palette.bg3;
                                    Rectangle { x: max(0, min(1, root.in-frame / root.seq-frames)) * parent.width; width: max(0, min(1, (root.out-frame - root.in-frame) / root.seq-frames)) * parent.width; height: 4px; background: root.in-on && root.out-on ? Palette.accent-range : transparent; }
                                    Rectangle { x: max(0, min(1, root.playhead-frame / root.seq-frames)) * (parent.width - 2px); y: -4px; width: 2px; height: 12px; background: root.has-clips ? Palette.accent : Palette.text-disabled; }
                                }
                                program-seek := LiveTouchArea { enabled: root.has-clips; mouse-cursor: pointer;
                                    function seek(phase: int) {
                                        root.active-panel = 1; keys.focus();
                                        root.timeline(0, phase, (round(max(0, min(1, (self.mouse-x - 8px) / max(1px, self.width - 16px))) * max(0, root.seq-frames - 1)) + 0.5 - root.scroll-frames) * root.px, 0, false, false);
                                    }
                                    pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.seek(0); } if (event.kind == PointerEventKind.up) { self.seek(1); self.seek(2); } if (event.kind == PointerEventKind.cancel) { self.seek(3); } }
                                    moved => { if (self.pressed) { self.seek(1); } }
                                }
                            }
                            Rectangle { height: 34px; background: Palette.bg2;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 4px; alignment: center;
                                    IconBtn { enabled: root.has-clips; tooltip: "Previous frame · " + root.shortcut-hint("step-back", root.shortcut-revision); icon: @image-url("icons/step-back.svg"); clicked => { root.active-panel = 1; root.command("step-back"); keys.focus(); } }
                                    PlayBtn { enabled: root.has-clips; tooltip: "Play / pause · " + root.shortcut-hint("play-toggle", root.shortcut-revision); stopped: root.shuttle == "STOP"; clicked => { root.active-panel = 1; root.command("play-toggle"); keys.focus(); } }
                                    IconBtn { enabled: root.has-clips; tooltip: "Next frame · " + root.shortcut-hint("step-fwd", root.shortcut-revision); icon: @image-url("icons/step-forward.svg"); clicked => { root.active-panel = 1; root.command("step-fwd"); keys.focus(); } }
                                    IconBtn { enabled: root.has-clips; icon: @image-url("icons/mark-in.svg"); tooltip: "Mark sequence In · " + root.shortcut-hint("mark-in", root.shortcut-revision); clicked => { root.active-panel = 1; root.command("mark-in"); keys.focus(); } }
                                    IconBtn { enabled: root.has-clips; icon: @image-url("icons/mark-out.svg"); tooltip: "Mark sequence Out · " + root.shortcut-hint("mark-out", root.shortcut-revision); clicked => { root.active-panel = 1; root.command("mark-out"); keys.focus(); } }
                                }
                            }
                            Rectangle { height: 22px; background: Palette.bg2;
                                Text { x: 8px; width: parent.width - 132px; height: 100%; text: root.seq-fps + " fps · " + (root.in-on || root.out-on ? "Marked sequence" : "Entire sequence"); color: Palette.text-secondary; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                TextBtn { x: parent.width - 124px; width: 116px; height: 20px; label: "Preview: " + root.quality-name; tooltip: "Cycle preview resolution: Full / Half / Quarter. Export resolution is unchanged."; clicked => { root.quality = mod(root.quality + 1, 3); keys.focus(); } }
                            }
                        }
                    }
                    Rectangle { width: root.workspace == 1 ? 0px : 5px; clip: true; background: properties-divider.pressed || properties-divider.has-hover ? Palette.bg3 : Palette.bg0;
                        Rectangle { x: 2px; y: 0px; width: 1px; height: 100%; background: properties-divider.pressed || properties-divider.has-hover ? Palette.accent : Palette.bg3; }
                        properties-divider := LiveTouchArea {
                            enabled: root.workspace != 1; mouse-cursor: ew-resize;
                            property <float> start-width;
                            property <length> start-x;
                            pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.start-width = root.insp-w / 1px; self.start-x = self.absolute-position.x + self.mouse-x; } }
                            moved => { if (self.pressed) { root.properties-width = max(260, min((root.width - 570px) / 1px, self.start-width - (self.absolute-position.x + self.mouse-x - self.start-x) / 1px)); } }
                        }
                    }
                    Rectangle {
                        width: root.insp-w;
                        clip: true;
                        background: Palette.bg1;
                        VerticalLayout { spacing: 0;
                            Rectangle { height: 32px; background: Palette.bg2;
                                LiveTouchArea { clicked => { root.active-panel = 4; keys.focus(); } }
                                Rectangle { x: 0px; y: 30px; width: 100%; height: 2px; background: root.active-panel == 4 ? Palette.accent : transparent; }
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: start;
                                    Text { text: "Properties"; color: Palette.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: root.inspector-mode == 0 ? "Sequence" : root.inspector-title; color: Palette.text-secondary; font-size: 12px; horizontal-stretch: 1; min-width: 0px; overflow: elide; vertical-alignment: center; }
                                }
                            }
                            Rectangle { height: 30px; background: Palette.bg2;
                                    HorizontalLayout { spacing: 0px;
                                        InspectorTab { label: "Video"; on: root.grade-tab == 0; clicked => { root.active-panel = 4; root.grade-tab = 0; } }
                                        InspectorTab { label: "Audio"; on: root.grade-tab == 1; clicked => { root.active-panel = 4; root.grade-tab = 1; } }
                                        InspectorTab { label: "Color"; on: root.grade-tab == 2; clicked => { root.active-panel = 4; root.grade-tab = 2; } }
                                        InspectorTab { min-width: 68px; label: "Transition"; on: root.grade-tab == 4; clicked => { root.active-panel = 4; root.grade-tab = 4; } }
                                        InspectorTab { label: "Info"; on: root.grade-tab == 5; clicked => { root.active-panel = 4; root.grade-tab = 5; } }
                                    }
                            }
                            Rectangle { vertical-stretch: 1; min-height: 0px; clip: true;
                                insp-scroll := Flickable {
                                    width: parent.width - 8px;
                                    height: 100%;
                                    viewport-width: self.width;
                                    viewport-height: max(self.height, body.preferred-height);
                                    body := VerticalLayout { alignment: start; spacing: 0; padding-bottom: 8px; width: parent.width;
                                    if root.inspector-mode == 0 && root.grade-tab != 1: VerticalLayout { alignment: start; spacing: 0; padding-top: 8px;
                                        PropLine { label: "Name"; value: root.seq-name; }
                                        PropLine { label: "Resolution"; value: root.res-label; }
                                        PropLine { label: "Frame rate"; value: root.seq-fps; numeric: true; }
                                        PropLine { label: "Duration"; value: root.duration-label; }
                                        PropLine { label: "Video tracks"; value: root.vid-count; numeric: true; }
                                        PropLine { label: "Audio tracks"; value: root.aud-count; numeric: true; }
                                        HorizontalLayout { padding-left: 8px; padding-top: 4px; alignment: start;
                                            TextBtn { label: "Sequence settings"; clicked => { root.active-panel = 4; root.command("sequence"); } }
                                        }
                                    }
                                    if root.inspector-mode == 1 && root.grade-tab == 0: VerticalLayout { alignment: start; spacing: 0; padding-top: 8px;
                                        SectionHead { label: "Transform"; }
                                        NumRow { focused => { root.active-panel = 4; } label: "Position X"; read: root.read-pos-x; value <=> root.pos-x; minimum: -4096; maximum: 4096; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("pos-x", v); } }
                                        NumRow { focused => { root.active-panel = 4; } label: "Position Y"; read: root.read-pos-y; value <=> root.pos-y; minimum: -4096; maximum: 4096; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("pos-y", v); } }
                                        NumRow { focused => { root.active-panel = 4; } label: "Scale"; read: root.read-scale; value <=> root.scale-v; minimum: 0.01; maximum: 4; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("scale", v); } }
                                        NumRow { focused => { root.active-panel = 4; } label: "Opacity"; read: root.read-opacity; value <=> root.opacity-v; minimum: 0; maximum: 1; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("opacity", v); } }
                                        HorizontalLayout { padding: 8px; alignment: start;
                                            TextBtn { label: "Reset transform"; clicked => { root.active-panel = 4; root.pos-x = 0; root.pos-y = 0; root.scale-v = 1; root.opacity-v = 1; root.adjust("pos-x", 0); root.adjust("pos-y", 0); root.adjust("scale", 1); root.adjust("opacity", 1); } }
                                        }
                                    }
                                    if root.inspector-mode == 1 && root.grade-tab == 2: VerticalLayout { alignment: start; spacing: 0; padding-top: 8px;
                                        SectionHead { label: "Color correction"; }
                                        NumRow { focused => { root.active-panel = 4; } label: "Exposure"; read: root.read-exposure; value <=> root.exposure; minimum: -5; maximum: 5; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("exposure", v); } }
                                        NumRow { focused => { root.active-panel = 4; } label: "Contrast"; read: root.read-contrast; value <=> root.contrast; minimum: -100; maximum: 100; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("contrast", v); } }
                                        NumRow { focused => { root.active-panel = 4; } label: "Highlights"; read: root.read-highlights; value <=> root.highlights; minimum: -100; maximum: 100; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("highlights", v); } }
                                        NumRow { focused => { root.active-panel = 4; } label: "Shadows"; read: root.read-shadows; value <=> root.shadows; minimum: -100; maximum: 100; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("shadows", v); } }
                                        NumRow { focused => { root.active-panel = 4; } label: "Temperature"; read: root.read-temperature; value <=> root.temperature; minimum: -100; maximum: 100; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("temperature", v); } }
                                        NumRow { focused => { root.active-panel = 4; } label: "Tint"; read: root.read-tint; value <=> root.tint; minimum: -100; maximum: 100; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("tint", v); } }
                                        NumRow { focused => { root.active-panel = 4; } label: "Saturation"; read: root.read-saturation; value <=> root.saturation; minimum: -100; maximum: 100; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("saturation", v); } }
                                        HorizontalLayout { padding: 8px; alignment: start; TextBtn { label: "Reset all color"; clicked => { root.active-panel = 4; root.command("reset-grade"); } } }
                                        SectionHead { label: "Channel balance"; }
                                        GradeWheel { focused => { root.active-panel = 4; } title: "Lift · shadows"; read-m: root.read-lift-m; read-r: root.read-lift-r; read-g: root.read-lift-g; read-b: root.read-lift-b; master <=> root.lift-m; red <=> root.lift-r; green <=> root.lift-g; blue <=> root.lift-b; changed(channel, v) => { root.active-panel = 4; root.adjust("lift-" + channel, v); } }
                                        GradeWheel { focused => { root.active-panel = 4; } title: "Gamma · midtones"; read-m: root.read-gamma-m; read-r: root.read-gamma-r; read-g: root.read-gamma-g; read-b: root.read-gamma-b; master <=> root.gamma-m; red <=> root.gamma-r; green <=> root.gamma-g; blue <=> root.gamma-b; changed(channel, v) => { root.active-panel = 4; root.adjust("gamma-" + channel, v); } }
                                        GradeWheel { focused => { root.active-panel = 4; } title: "Gain · highlights"; read-m: root.read-gain-m; read-r: root.read-gain-r; read-g: root.read-gain-g; read-b: root.read-gain-b; master <=> root.gain-m; red <=> root.gain-r; green <=> root.gain-g; blue <=> root.gain-b; changed(channel, v) => { root.active-panel = 4; root.adjust("gain-" + channel, v); } }
                                    }
                                    if root.inspector-mode == 2 && (root.grade-tab == 0 || root.grade-tab == 2): Text { text: "Select a video or image clip to adjust its picture."; x: 12px; width: parent.width - 24px; height: 64px; wrap: word-wrap; color: Palette.text-secondary; font-size: 12px; vertical-alignment: center; }
                                    if root.grade-tab == 1: VerticalLayout { alignment: start; spacing: 0; padding-top: 8px;
                                        SectionHead { label: "Stereo output"; }
                                        Rectangle { height: 83px; background: Palette.bg1;
                                            VerticalLayout { padding-left: 10px; padding-right: 10px; padding-top: 5px; padding-bottom: 5px; spacing: 4px;
                                                HorizontalLayout { spacing: 6px;
                                                    Text { text: "L"; width: 10px; color: Palette.text-secondary; font-size: 10px; vertical-alignment: center; }
                                                    AudioMeterBar { level: root.meter-left; held: root.meter-hold-left; clipped: root.meter-clip-left; horizontal-stretch: 1; }
                                                    Text { text: root.meter-read-left; width: 33px; color: root.meter-clip-left ? Palette.status-error : Palette.text-secondary; font-size: 10px; horizontal-alignment: right; }
                                                }
                                                HorizontalLayout { spacing: 6px;
                                                    Text { text: "R"; width: 10px; color: Palette.text-secondary; font-size: 10px; vertical-alignment: center; }
                                                    AudioMeterBar { level: root.meter-right; held: root.meter-hold-right; clipped: root.meter-clip-right; horizontal-stretch: 1; }
                                                    Text { text: root.meter-read-right; width: 33px; color: root.meter-clip-right ? Palette.status-error : Palette.text-secondary; font-size: 10px; horizontal-alignment: right; }
                                                }
                                                HorizontalLayout { padding-left: 16px; padding-right: 39px;
                                                    Text { text: "−60"; color: Palette.text-disabled; font-size: 9px; }
                                                    Text { text: "−24"; color: Palette.text-disabled; font-size: 9px; horizontal-alignment: center; horizontal-stretch: 1; }
                                                    Text { text: "0 dBFS"; color: Palette.text-disabled; font-size: 9px; horizontal-alignment: right; }
                                                }
                                                HorizontalLayout { alignment: end;
                                                    TextBtn { label: root.meter-clip-left || root.meter-clip-right ? "CLIP · Reset peaks" : "Reset peaks"; tooltip: "Clear the stereo peak hold and clipping indicators"; height: 22px; clicked => { root.command("clear-meters"); } }
                                                }
                                            }
                                        }
                                        if root.inspector-mode != 0: VerticalLayout { spacing: 0; alignment: start;
                                            SectionHead { label: "Selected clip"; }
                                            NumRow { focused => { root.active-panel = 4; } label: "Volume"; read: root.read-volume; value <=> root.volume-v; minimum: 0; maximum: 2; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("volume", v); } }
                                            HorizontalLayout { padding: 8px; alignment: start; TextBtn { label: "Reset volume"; clicked => { root.active-panel = 4; root.volume-v = 1; root.adjust("volume", 1); } } }
                                        }
                                        SectionHead { label: "Audio tracks"; }
                                        for track in root.mixer-tracks: VerticalLayout { spacing: 0; alignment: start;
                                            Rectangle { height: 36px; background: Palette.bg1;
                                                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: start;
                                                    Text { text: track.name; color: track.muted ? Palette.text-secondary : Palette.text-primary; font-size: 12px; font-weight: 600; horizontal-stretch: 1; min-width: 0px; overflow: elide; vertical-alignment: center; }
                                                    TextBtn { label: track.muted ? "Unmute" : "Mute"; clicked => { root.active-panel = 4; root.pick("mute", track.index); keys.focus(); } }
                                                    TextBtn { label: "Solo"; tooltip: "Listen to soloed audio tracks; mute still applies"; background: track.solo ? Palette.accent-muted : Palette.bg2; clicked => { root.active-panel = 4; root.pick("solo", track.index); keys.focus(); } }
                                                }
                                            }
                                            NumRow { focused => { root.active-panel = 4; } label: "Gain"; read: track.read-gain; value: track.gain; follow-model: true; model-value: track.gain; minimum: 0; maximum: 2; display-scale: 100; changed(v) => { root.active-panel = 4; root.mix-track(track.index, "gain", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Balance"; read: track.read-pan; value: track.pan; follow-model: true; model-value: track.pan; minimum: -1; maximum: 1; bipolar: true; display-scale: 100; changed(v) => { root.active-panel = 4; root.mix-track(track.index, "pan", v); } }
                                            Rectangle { height: 8px; Rectangle { y: 7px; height: 1px; width: 100%; background: Palette.bg3; } }
                                        }
                                        if root.mixer-tracks.length == 0: Text { text: "Add an audio track to mix your sequence."; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; height: 56px; vertical-alignment: center; }
                                        HorizontalLayout { padding: 8px; alignment: start; TextBtn { label: "Add audio track"; clicked => { root.active-panel = 4; root.command("add-audio"); keys.focus(); } } }
                                    }
                                    if root.inspector-mode != 0 && root.grade-tab == 4: VerticalLayout { alignment: start; padding-top: 8px;
                                        if root.trans-name == "": Rectangle { height: 24px; Text { text: "Select a transition on the timeline."; x: 8px; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: left; vertical-alignment: center; } }
                                        if root.trans-name != "": PropLine { label: "Type"; value: root.trans-name; }
                                        if root.trans-name != "": NumRow { focused => { root.active-panel = 4; } label: "Duration"; read: root.read-trans; value <=> root.trans-dur; minimum: 2; maximum: 96; changed(v) => { root.active-panel = 4; root.adjust("trans-dur", v); } }
                                        if root.trans-name != "": PropLine { label: "Seconds"; value: root.read-seconds; }
                                        if root.trans-name != "": PropLine { label: "Anchor"; value: root.trans-anchor; }
                                        if root.trans-name != "": HorizontalLayout { padding-left: 8px; TextBtn { label: "Remove"; clicked => { root.active-panel = 4; root.command("remove-transition"); } } }
                                    }
                                    if root.inspector-mode != 0 && root.grade-tab == 5: VerticalLayout { alignment: start; padding-top: 8px;
                                        PropLine { label: "Name"; value: root.inspector-title; }
                                        PropLine { label: "Type"; value: root.inspector-mode == 2 ? "Audio" : "Video"; }
                                        PropLine { label: "Source"; value: root.source-name; }
                                    }
                                }
                                }
                                Rectangle {
                                    x: parent.width - 8px; y: 0px; width: 8px; height: 100%; background: Palette.bg0;
                                    Rectangle {
                                        x: 2px; width: 4px; background: Palette.bg3;
                                        height: insp-scroll.viewport-height <= insp-scroll.height ? parent.height : max(24px, parent.height * insp-scroll.height / insp-scroll.viewport-height);
                                        y: insp-scroll.viewport-height <= insp-scroll.height ? 0px : (parent.height - self.height) * -insp-scroll.viewport-y / (insp-scroll.viewport-height - insp-scroll.height);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 8px; background: divider.pressed || divider.has-hover ? Palette.bg3 : Palette.bg0;
                Rectangle { y: 3px; height: 1px; width: 100%; background: divider.pressed || divider.has-hover ? Palette.accent : Palette.bg3; }
                divider := LiveTouchArea {
                    mouse-cursor: ns-resize;
                    property <float> start-ratio;
                    property <length> start-y;
                    pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.start-ratio = root.upper-ratio; self.start-y = self.mouse-y + root.upper-h; } }
                    moved => { if (self.pressed) { root.upper-ratio = max(0.2, min(0.8, self.start-ratio + (self.mouse-y + root.upper-h - self.start-y) / max(1px, root.mid-h - 8px))); } }
                }
            }

            Rectangle { height: root.time-h; background: Palette.bg0; clip: true;
                HorizontalLayout { spacing: 0;
