                                    IconBtn { icon: @image-url("icons/next-edit.svg"); tooltip: "Next edit · " + root.shortcut-hint("next-edit", root.shortcut-revision) + "\nMove the playhead to the next clip edge." + (root.has-clips ? "" : "\nAdd clips to the timeline first."); enabled: root.has-clips; clicked => { root.active-panel = 3; keys.focus(); root.command("next-edit"); } }
                                    IconBtn { icon: @image-url("icons/zoom-out.svg"); tooltip: "Zoom out · " + root.shortcut-hint("zoom-out", root.shortcut-revision) + "\nShow more time in the timeline."; clicked => { root.active-panel = 3; keys.focus(); root.command("zoom-out"); } }
