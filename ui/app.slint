                                    IconBtn { icon: @image-url("icons/fit.svg"); tooltip: "Fit sequence · " + root.shortcut-hint("zoom-fit", root.shortcut-revision) + "\nShow the full sequence in the timeline."; clicked => { root.active-panel = 3; keys.focus(); root.command("zoom-fit"); } }
