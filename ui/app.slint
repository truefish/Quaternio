                                            background: clip.still ? (clip.selected ? Palette.clip-still-on : Palette.clip-still) : clip.video ? (clip.selected ? Palette.clip-video-on : Palette.clip-video) : (clip.selected ? Palette.clip-audio-on : Palette.clip-audio);
                                            border-width: 1px; border-color: clip.selected ? #C9C2E5 : #161618;
