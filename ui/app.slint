import { Palette, UiMetrics, KeyboardControls } from "style.slint";
import { LiveFocus, LiveTouchArea } from "live-focus.slint";
import { ProjectOrganizer } from "project-organizer.slint";
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Italic.ttf";



export struct TransferItem { id: string, name: string, percent: int, detail: string, state: string, cancellable: bool, }
export struct PeerItem { id: string, name: string, role: string, state: string, revocable: bool, }
export struct ReviewMarker { id: string, x: float, resolved: bool, }
export struct ReviewItem { id: string, timecode: string, author: string, text: string, resolved: bool, }
export struct BinItem { id: int, name: string, kind: string, info: string, selected: bool, tc-in: string, tc-out: string, duration: string, fps: string, offline: bool, thumbnail: image, }
export struct CommandItem { action: string, label: string, hint: string, enabled: bool, }
export struct KeyBindingRow { action: string, label: string, binding: string, modified: bool, }
export struct TrackHead { index: int, y: float, h: float, name: string, muted: bool, solo: bool, locked: bool, selected: bool, video: bool, }
export struct MixerTrack { index: int, name: string, gain: float, pan: float, read-gain: string, read-pan: string, muted: bool, solo: bool, }
export struct RazorGuide { x: float, y: float, h: float, }
export struct ClipView { waveform: image, waveform-x: float, waveform-width: float, filmstrip: image, filmstrip-x: float, filmstrip-width: float, id: int, x: float, y: float, w: float, h: float, name: string, selected: bool, video: bool, dim: bool, still: bool, offline: bool, }
export struct DropGhost { x: float, y: float, w: float, h: float, video: bool, }
export struct TransView { id: int, x: float, y: float, w: float, h: float, selected: bool, audio: bool, label: string, }
export struct Tick { x: float, label: string, major: bool, }
export struct QueueItem { id: int, name: string, output: string, status: string, state-label: string, removable: bool, retryable: bool, complete: bool, }
export struct MenuOption { label: string, hint: string, enabled: bool, divider: bool, }
export struct LabelItem { text: string, }
export struct ShortcutRow { keys: string, action: string, }
export struct Glyph { ch: string, sep: bool, }
export struct RecentProjectRow { key: string, name: string, path: string, details: string, age: string, pinned: bool, cover: image, }
export struct VersionRow { tag: string, date: string, prerelease: bool, current: bool, html-url: string, }


global ToolHints {
    in-out property <string> text: "";
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
    in-out property <bool> shown: false;
    in-out property <bool> ready: false;
    changed shown => { root.ready = false; }
    changed text => { root.ready = false; }
}

component Ico inherits Image {
    in property <image> icon;
    in property <color> ink: Palette.text-secondary;
    x: 6px; y: 6px; width: 16px; height: 16px;
    source: root.icon;
    colorize: root.ink;
    image-fit: contain;
}

component PlayBtn inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> stopped: true;
    in property <string> tooltip: "";
    callback clicked();
    forward-focus: button-focus;
    in property <bool> retain-keyboard-focus: true;
    property <bool> keyboard-held: false;
    function release-key() { if (root.keyboard-held) { root.keyboard-held = false; LiveFocus.input-lost(); } }
    function show-help() {
        if ((touch.has-hover || button-focus.has-focus) && root.tooltip != "") {
            ToolHints.text = root.tooltip; ToolHints.x = touch.absolute-position.x + root.width / 2;
            ToolHints.y = touch.absolute-position.y + root.height + 5px; ToolHints.shown = true;
        } else if (ToolHints.text == root.tooltip) { ToolHints.shown = false; }
    }
    button-focus := FocusScope {
        enabled: root.enabled && !KeyboardControls.blocked;
        changed has-focus => { if (!self.has-focus) { root.release-key(); } else { KeyboardControls.navigating = true; } root.show-help(); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (!root.keyboard-held && root.enabled && !KeyboardControls.blocked) { root.keyboard-held = true; LiveFocus.input-gained(); }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (root.keyboard-held && root.enabled && !KeyboardControls.blocked) { root.release-key(); root.clicked(); if (root.retain-keyboard-focus && !KeyboardControls.blocked) { button-focus.focus(); } } else { root.release-key(); } return accept;
            }
            return reject;
        }
        Timer { interval: 150ms; running: root.keyboard-held; triggered => { LiveFocus.heartbeat(); } }
    }
    width: 30px; height: 28px; border-radius: 2px;
    border-width: button-focus.has-focus ? 1px : 0px; border-color: Palette.accent;
    background: touch.show-pressed || touch.has-hover ? Palette.bg3 : transparent;
    touch := LiveTouchArea { mouse-cursor: root.enabled ? pointer : default; clicked => { if (root.enabled && !KeyboardControls.blocked) { button-focus.focus(); root.clicked(); } }
        changed has-hover => { root.show-help(); }
    }
    Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 16px; height: 16px; source: root.stopped ? @image-url("icons/play.svg") : @image-url("icons/pause.svg"); colorize: root.enabled ? Palette.text-primary : Palette.text-disabled; image-fit: contain; }
}

component IconBtn inherits Rectangle {
    accessible-role: button; accessible-label: root.tooltip; accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled && !KeyboardControls.blocked) { root.clicked(); } }
    in property <image> icon;
    in property <bool> armed: false;
    in property <bool> enabled: true;
    in property <string> tooltip: "";
    out property <length> popup-x: touch.absolute-position.x;
    out property <length> popup-y: touch.absolute-position.y + touch.height;
    callback clicked();
    forward-focus: button-focus;
    in property <bool> retain-keyboard-focus: true;
    property <bool> keyboard-held: false;
    function release-key() { if (root.keyboard-held) { root.keyboard-held = false; LiveFocus.input-lost(); } }
    function show-help() {
        if ((touch.has-hover || button-focus.has-focus) && root.tooltip != "") {
            ToolHints.text = root.tooltip; ToolHints.x = touch.absolute-position.x + root.width / 2;
            ToolHints.y = touch.absolute-position.y + root.height + 5px; ToolHints.shown = true;
        } else if (ToolHints.text == root.tooltip) { ToolHints.shown = false; }
    }
    button-focus := FocusScope {
        enabled: root.enabled && !KeyboardControls.blocked;
        changed has-focus => { if (!self.has-focus) { root.release-key(); } else { KeyboardControls.navigating = true; } root.show-help(); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (!root.keyboard-held && root.enabled && !KeyboardControls.blocked) { root.keyboard-held = true; LiveFocus.input-gained(); }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (root.keyboard-held && root.enabled && !KeyboardControls.blocked) { root.release-key(); root.clicked(); if (root.retain-keyboard-focus && !KeyboardControls.blocked) { button-focus.focus(); } } else { root.release-key(); } return accept;
            }
            return reject;
        }
        Timer { interval: 150ms; running: root.keyboard-held; triggered => { LiveFocus.heartbeat(); } }
    }
    width: 28px; height: 28px; border-radius: 2px;
    border-width: button-focus.has-focus ? 1px : 0px;
    border-color: Palette.accent;
    background: !root.enabled ? transparent : touch.show-pressed ? Palette.row-pressed : root.armed ? Palette.accent-muted : touch.has-hover ? Palette.bg3 : transparent;
    touch := LiveTouchArea { mouse-cursor: root.enabled ? pointer : default; clicked => { if (root.enabled && !KeyboardControls.blocked) { button-focus.focus(); root.clicked(); } }
        changed has-hover => { root.show-help(); }
    }
    Ico {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        icon: root.icon;
        ink: !root.enabled ? Palette.text-disabled : root.armed ? Palette.accent : touch.has-hover ? Palette.text-primary : Palette.text-secondary;
    }
}

global PopupBounds {
    in-out property <length> width: 1280px;
    in-out property <length> height: 800px;
}

component ChoiceButton inherits Rectangle {
    accessible-role: button; accessible-label: root.label != "" ? root.label : root.tooltip != "" ? root.tooltip : "Choose an option"; accessible-enabled: root.enabled;
    accessible-value: root.selected>=0 && root.selected<root.choices.length ? root.choices[root.selected].text : "";
    accessible-action-default => { root.open-choices(); }
    in property <[LabelItem]> choices;
    in property <int> selected: 0;
    in property <bool> enabled: true;
    in property <string> suffix: "";
    in property <image> icon;
    in property <string> tooltip: "";
    in property <string> label: "";
    in property <bool> armed: false;
    callback chosen(int);
    property <int> highlighted: 0;
    height: UiMetrics.control-height; vertical-stretch: 0; min-width: root.icon.width > 0 ? 28px : 100px; background: !root.enabled ? Palette.bg2 : choice-touch.has-hover ? Palette.bg3 : root.armed ? Palette.accent-muted : Palette.bg0;
    border-width: 1px; border-color: button-focus.has-focus ? Palette.accent : Palette.bg3; border-radius: UiMetrics.radius;
    forward-focus: button-focus;
    property <bool> choice-opening: false;
    function open-choices() {
        if (!root.enabled || root.choices.length == 0) { return; }
        root.highlighted = max(0, min(root.choices.length - 1, root.selected));
        ToolHints.shown = false;
        root.choice-opening = true;
        choice-popup.show();
    }
    function choose(index: int) {
        if (!root.enabled || index < 0 || index >= root.choices.length) { return; }
        choice-popup.close();
        button-focus.focus();
        root.chosen(index);
    }
    button-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " " || event.text == Key.DownArrow || event.text == Key.UpArrow) { root.open-choices(); return accept; }
            return reject;
        }
    }
    if root.icon.width == 0: Text { x: 10px; width: parent.width - 34px; height: 100%; text: root.selected >= 0 && root.selected < root.choices.length ? root.choices[root.selected].text + root.suffix : "Choose…"; color: root.enabled ? Palette.text-primary : Palette.text-disabled; font-size: 12px; overflow: elide; vertical-alignment: center; }
    Image { x: root.icon.width > 0 ? 6px : parent.width - 24px; y: (parent.height - self.height) / 2; width: 16px; height: 16px; source: root.icon.width > 0 ? root.icon : @image-url("icons/chevron-down.svg"); colorize: !root.enabled ? Palette.text-disabled : root.armed ? Palette.accent : Palette.text-secondary; }
    choice-touch := LiveTouchArea { mouse-cursor: root.enabled ? pointer : default; clicked => { button-focus.focus(); root.open-choices(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") { ToolHints.text = root.tooltip; ToolHints.x = self.absolute-position.x + self.width / 2; ToolHints.y = self.absolute-position.y + self.height + 5px; ToolHints.shown = true; }
            else if (ToolHints.text == root.tooltip) { ToolHints.shown = false; }
        }
    }
    choice-popup := PopupWindow {
        width: min(max(root.width, 180px), PopupBounds.width - 16px);
        height: min(min(252px, PopupBounds.height - 24px), root.choices.length * 28px + 8px);
        x: max(8px - choice-touch.absolute-position.x, min(0px, PopupBounds.width - choice-touch.absolute-position.x - self.width - 8px));
        y: choice-touch.absolute-position.y + root.height + self.height + 4px <= PopupBounds.height - 8px ? root.height + 4px : max(8px - choice-touch.absolute-position.y, -self.height - 4px);
        close-policy: close-on-click;
        forward-focus: choice-focus;
        Timer {
            interval: 1ms;
            running: root.choice-opening;
            triggered => { root.choice-opening = false; choice-focus.focus(); choice-focus.reveal-choice(); }
        }
        choice-focus := FocusScope {
                Timer { interval: 150ms; running: choice-focus.has-focus; triggered => { LiveFocus.heartbeat(); } }
            property <bool> live-focus-counted: false;
            changed has-focus => {
                if (self.has-focus != self.live-focus-counted) {
                    self.live-focus-counted = self.has-focus;
                    if (self.has-focus) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); }
                }
            }

    function reveal-choice() {
        choice-scroll.content-y = -max(0px, min(max(0px, choice-scroll.content-height - choice-scroll.height), max(root.highlighted * 28px + 28px - choice-scroll.height, min(-choice-scroll.content-y, root.highlighted * 28px))));
    }

            key-pressed(event) => {
                if (event.text == Key.Escape || event.text == Key.Tab || event.text == Key.Backtab) { choice-popup.close(); button-focus.focus(); return accept; }
                if (event.text == Key.UpArrow) { root.highlighted = max(0, root.highlighted - 1); choice-focus.reveal-choice(); return accept; }
                if (event.text == Key.DownArrow) { root.highlighted = min(root.choices.length - 1, root.highlighted + 1); choice-focus.reveal-choice(); return accept; }
                if (event.text == Key.Home) { root.highlighted = 0; choice-focus.reveal-choice(); return accept; }
                if (event.text == Key.End) { root.highlighted = root.choices.length - 1; choice-focus.reveal-choice(); return accept; }
                if (event.text == Key.Return) { root.choose(root.highlighted); return accept; }
                return accept;
            }
            Rectangle { background: Palette.bg2; border-width: 1px; border-color: Palette.bg3; border-radius: 4px; clip: true;
                choice-scroll := Flickable { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                    content-width: self.width; content-height: root.choices.length * 28px;
                    content-y: 0px;
                    VerticalLayout { width: parent.width; spacing: 0px;
                        for item[index] in root.choices: Rectangle { height: 28px; background: root.highlighted == index ? Palette.accent-muted : transparent;
                            Rectangle { x: 0px; y: 5px; width: 2px; height: 18px; background: root.selected == index ? Palette.accent : transparent; }
                            Text { x: 9px; width: parent.width - 18px; height: 100%; text: item.text + root.suffix; color: root.selected == index ? Palette.accent : Palette.text-primary; font-size: 12px; font-weight: root.selected == index ? 600 : 400; vertical-alignment: center; overflow: elide; }
                            row-touch := LiveTouchArea { mouse-cursor: pointer;
                                changed has-hover => { if (self.has-hover) { root.highlighted = index; } }
                                pointer-event(event) => { if (event.kind == PointerEventKind.move) { root.highlighted = index; } }
                                clicked => { root.choose(index); }
                            }
                        }
                    }
                }
                if choice-scroll.content-height > choice-scroll.height: Rectangle { x: parent.width - 5px; y: 4px; width: 3px; height: parent.height - 8px; background: Palette.bg0;
                    Rectangle { x: 0px; width: 3px; height: max(18px, parent.height * choice-scroll.height / choice-scroll.content-height); y: max(0px, min(parent.height - self.height, (parent.height - self.height) * -choice-scroll.content-y / max(1px, choice-scroll.content-height - choice-scroll.height))); background: Palette.text-disabled; }
                }
            }
        }
    }
}

component SecBtn inherits Rectangle {
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> dropdown: false;
    in property <bool> expanded: false;
    callback clicked();
    forward-focus: action-focus;
    action-focus := FocusScope {
        enabled: root.enabled;
        changed has-focus => { if (self.has-focus) { KeyboardControls.navigating = true; } }
        key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { return accept; } return reject; }
        key-released(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; }
    }
    min-width: button-label.preferred-width + 20px + (root.dropdown ? 18px : 0px);
    horizontal-stretch: 0; vertical-stretch: 0; height: UiMetrics.control-height; border-radius: UiMetrics.radius;
    border-width: 1px; border-color: action-focus.has-focus ? Palette.accent : Palette.bg3;
    background: !root.enabled ? Palette.bg2 : touch.show-pressed ? Palette.row-pressed : touch.has-hover ? Palette.bg3 : Palette.bg2;
    touch := LiveTouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { if (root.enabled) { action-focus.focus(); root.clicked(); } } }
    HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
        button-label := Text { text: root.label; color: root.enabled ? Palette.text-primary : Palette.text-disabled; font-size: UiMetrics.control-font; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
        if root.dropdown: Rectangle { width: 12px;
            Image { x: 0px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; source: root.expanded ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg"); colorize: root.enabled ? Palette.text-secondary : Palette.text-disabled; }
        }
    }
}

component PriBtn inherits Rectangle {
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    forward-focus: action-focus;
    action-focus := FocusScope {
        enabled: root.enabled;
        changed has-focus => { if (self.has-focus) { KeyboardControls.navigating = true; } }
        key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { return accept; } return reject; }
        key-released(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; }
    }
    min-width: button-label.preferred-width + 20px;
    horizontal-stretch: 0; vertical-stretch: 0; height: UiMetrics.control-height; border-radius: UiMetrics.radius; border-width: 1px; border-color: action-focus.has-focus ? Palette.accent : transparent;
    background: !root.enabled ? Palette.bg3 : touch.show-pressed ? Palette.accent-action-pressed : touch.has-hover ? Palette.accent-action-hover : Palette.accent-action;
    touch := LiveTouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { if (root.enabled) { action-focus.focus(); root.clicked(); } } }
    HorizontalLayout { padding-left: 10px; padding-right: 10px; alignment: center;
        button-label := Text { text: root.label; color: root.enabled ? Palette.text-on-action : Palette.text-disabled; font-size: UiMetrics.control-font; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    }
}

component TextBtn inherits Rectangle {
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    in property <string> label;
    in property <length> horizontal-padding: 10px;
    in property <TextHorizontalAlignment> label-alignment: center;
    in property <bool> enabled: true;
    in property <string> tooltip: "";
    in property <bool> dropdown: false;
    in property <bool> expanded: false;
    callback clicked();
    forward-focus: action-focus;
    action-focus := FocusScope {
        enabled: root.enabled;
        changed has-focus => { if (self.has-focus) { KeyboardControls.navigating = true; } }
        key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { return accept; } return reject; }
        key-released(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; }
    }
    border-width: 1px; border-color: action-focus.has-focus ? Palette.accent : transparent;
    min-width: button-label.preferred-width + 2 * root.horizontal-padding + (root.dropdown ? 18px : 0px);
    horizontal-stretch: 0; vertical-stretch: 0; height: UiMetrics.control-height; border-radius: UiMetrics.radius;
    background: !root.enabled ? Palette.bg2 : touch.show-pressed ? Palette.row-pressed : touch.has-hover ? Palette.bg3 : Palette.bg2;
    touch := LiveTouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { if (root.enabled) { action-focus.focus(); root.clicked(); } }
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                ToolHints.text = root.tooltip;
                ToolHints.x = self.absolute-position.x + self.width / 2;
                ToolHints.y = self.absolute-position.y + self.height + 5px;
                ToolHints.shown = true;
            } else if (ToolHints.text == root.tooltip) { ToolHints.shown = false; }
        }
    }
    HorizontalLayout { padding-left: root.horizontal-padding; padding-right: root.horizontal-padding; spacing: 6px; alignment: center;
        button-label := Text { text: root.label; color: root.enabled ? (touch.has-hover ? Palette.text-primary : Palette.text-secondary) : Palette.text-disabled; font-size: UiMetrics.control-font; font-weight: 500; horizontal-alignment: root.label-alignment; vertical-alignment: center; horizontal-stretch: 1; }
        if root.dropdown: Rectangle { width: 12px;
            Image { x: 0px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; source: root.expanded ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg"); colorize: root.enabled ? Palette.text-secondary : Palette.text-disabled; }
        }
    }
}

component AudioMeterBar inherits Rectangle {
    in property <float> level;
    in property <float> held;
    in property <bool> clipped;
    height: 11px; background: Palette.bg0; clip: true;
    Rectangle { width: 70%; height: 100%; background: #55AD77; }
    Rectangle { x: parent.width * 0.7; width: parent.width * 0.2; height: 100%; background: #D4B05C; }
    Rectangle { x: parent.width * 0.9; width: parent.width * 0.1; height: 100%; background: #D46B61; }
    Rectangle { x: parent.width * root.level; width: parent.width * (1 - root.level); height: 100%; background: Palette.bg0; }
    Rectangle { x: min(parent.width - 2px, max(0px, parent.width * root.held)); width: 2px; height: 100%; background: root.held > 0 ? Palette.text-primary : transparent; }
    Rectangle { x: parent.width - 3px; width: 3px; height: 100%; background: root.clipped ? #FF5F57 : transparent; }
}

// Same normalized live meter values as AudioMeterBar, oriented for the timeline.
component VerticalMeter inherits Rectangle {
    in property <float> level: 0;
    in property <float> held: 0;
    in property <bool> clipped: false;
    horizontal-stretch: 1; min-width: 8px; background: #101010; clip: true;
    Rectangle { x: 0px; y: parent.height * 0.3; width: 100%; height: parent.height * 0.7; background: #55AD77; }
    Rectangle { x: 0px; y: parent.height * 0.1; width: 100%; height: parent.height * 0.2; background: #D4B05C; }
    Rectangle { x: 0px; y: 0px; width: 100%; height: parent.height * 0.1; background: #D46B61; }
    Rectangle { x: 0px; y: 0px; width: 100%; height: parent.height * (1 - max(0, min(1, root.level))); background: #101010; }
    Rectangle { x: 0px; y: max(0px, min(parent.height - 2px, parent.height * (1 - root.held))); width: 100%; height: 2px; visible: root.held > 0; background: Palette.text-primary; }
    Rectangle { x: 0px; y: 0px; width: 100%; height: 3px; visible: root.clipped; background: #FF5F57; }
}

component Field inherits Rectangle {
    in property <string> field-label: root.placeholder != "" ? root.placeholder : "Text field";
    in property <bool> secret: false;
    in-out property <string> value;
    in property <string> placeholder: "";
    in property <bool> enabled: true;
    callback focused();
    callback edited();
    height: UiMetrics.control-height; vertical-stretch: 0; border-radius: UiMetrics.radius; background: root.enabled ? Palette.bg0 : Palette.bg2; border-width: 1px; border-color: input.has-focus ? Palette.accent : Palette.bg3;
    Text { text: root.value == "" ? root.placeholder : ""; x: 8px; width: parent.width - 16px; height: 100%; color: root.enabled ? Palette.text-secondary : Palette.text-disabled; font-size: UiMetrics.control-font; font-weight: 400; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
    input := TextInput {
                accessible-label: root.field-label;
                input-type: root.secret ? InputType.password : InputType.text;
                enabled: root.enabled; edited => { root.edited(); }
                Timer { interval: 150ms; running: input.has-focus; triggered => { LiveFocus.heartbeat(); } }
                property <bool> live-focus-counted: false; x: 8px; width: parent.width - 16px; height: 100%; text <=> root.value; color: root.enabled ? Palette.text-primary : Palette.text-disabled; font-size: UiMetrics.control-font; font-weight: 400; horizontal-alignment: left; vertical-alignment: center; single-line: true; changed has-focus => { if (self.has-focus != self.live-focus-counted) { self.live-focus-counted = self.has-focus; if (self.has-focus) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); } }  if (self.has-focus) { root.focused(); } } }
}

