        if root.show-session && !root.show-creator && !root.modal-open: Rectangle {
            x: parent.width - self.width - 8px; y: 70px; width: min(440px, parent.width - 16px); height: parent.height - 100px;
            z: 3; background: Palette.bg1; border-width: 1px; border-color: Palette.bg3; border-radius: 6px;
            LiveTouchArea { }
            VerticalLayout { padding: 16px; spacing: 10px;
                HorizontalLayout { height: UiMetrics.control-height; vertical-stretch: 0;
                    Text { text: "Collaborate"; color: Palette.text-primary; font-size: 16px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                    TextBtn { label: "Close"; clicked => { root.show-session = false; keys.focus(); } }
                }
                Flickable { vertical-stretch: 1; min-height: 0px; content-width: self.width; content-height: session-content.preferred-height;
                    Rectangle { x: 0px; y: 0px; width: parent.width; height: session-content.preferred-height;
                    session-content := VerticalLayout { spacing: 12px; alignment: start;
                        if root.session-phase != "": Text { text: root.session-phase; color: Palette.text-primary; font-size: 14px; font-weight: 600; }
                        if root.session-error != "": VerticalLayout { spacing: 4px;
                            Text { text: root.session-error; color: Palette.status-error; font-size: UiMetrics.body-font; wrap: word-wrap; }
                            TextBtn { label: "Dismiss"; clicked => { root.command("session-dismiss-error"); } }
                        }
                        if root.session-status != "": Text { text: root.session-status; color: Palette.text-secondary; font-size: UiMetrics.body-font; wrap: word-wrap; }
                        if !root.session-active: HorizontalLayout { spacing: 8px;
                            ChoiceButton { label: "Host or join"; choices: [{text: "Host a project"}, {text: "Join a project"}]; selected: root.session-show-codes ? 1 : 0; chosen(index) => { root.session-show-codes = index == 1; } }
                        }
                        if !root.session-active && !root.session-show-codes: VerticalLayout { spacing: 8px;
                            LabeledField { label: "Your name"; value <=> root.session-name; }
