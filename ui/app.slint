    property <length> dock-target-y: root.project-top == (PaneDocking.pane == 0) ? 62px : root.upper-h + 70px;
    property <length> dock-target-width: root.project-top == (PaneDocking.pane == 0) ? root.bin-w : root.bottom-bin-w;
    property <bool> pane-drag-valid: root.page == 0 && root.workspace == 0 && PaneDocking.x >= 0px && PaneDocking.x <= root.dock-target-width && PaneDocking.y >= root.dock-target-y && PaneDocking.y <= root.dock-target-y + 32px;
    function dock-pane(source: bool, x: float, y: float) {
        if (root.page == 0 && root.workspace == 0) {
            if (root.project-top == source) {
                if (x >= 0 && x <= root.bin-w / 1px && y >= 62 && y <= 94) { root.command("toggle-project-dock"); }
            } else {
                if (x >= 0 && x <= root.bottom-bin-w / 1px && y >= (root.upper-h + 70px) / 1px && y <= (root.upper-h + 102px) / 1px) { root.command("toggle-project-dock"); }
            }
        }
    }

    public function focus-pane(pane: int) {
        keys.focus();
        root.active-panel = max(0, min(4, pane));
        if (pane == 2) { root.bin-tab = 0; }
    }
    pure function normalized-key(text: string) -> string {
        if (text == Key.LeftArrow) { return "left"; }
        if (text == Key.RightArrow) { return "right"; }
        if (text == Key.UpArrow) { return "up"; }
        if (text == Key.DownArrow) { return "down"; }
        if (text == Key.Delete) { return "delete"; }
        if (text == Key.Backspace) { return "backspace"; }
        if (text == Key.Home) { return "home"; }
        if (text == Key.End) { return "end"; }
        if (text == Key.Escape) { return "escape"; }
        if (text == Key.Space) { return "space"; }
        if (text == Key.Return) { return "return"; }
        if (text == Key.Tab) { return "tab"; }
        if (text == Key.PageUp) { return "pageup"; }
        if (text == Key.PageDown) { return "pagedown"; }
        if (text == Key.Insert) { return "insert"; }
        if (text == Key.F1) { return "f1"; }
        if (text == Key.F2) { return "f2"; }
        if (text == Key.F3) { return "f3"; }
        if (text == Key.F4) { return "f4"; }
        if (text == Key.F5) { return "f5"; }
        if (text == Key.F6) { return "f6"; }
        if (text == Key.F7) { return "f7"; }
        if (text == Key.F8) { return "f8"; }
        if (text == Key.F9) { return "f9"; }
        if (text == Key.F10) { return "f10"; }
        if (text == Key.F11) { return "f11"; }
        if (text == Key.F12) { return "f12"; }
        return text;
    }

    public function focus-controls() { if (!root.live-reloading) { if (root.can-undo) { undo-control.focus(); } else { preferences-control.focus(); } } }
    public function focus-menu() { if (!root.live-reloading) { root.open-menu = 1; } }

    keys := FocusScope {
        width: parent.width; height: parent.height;
        changed has-focus => { if (self.has-focus) { KeyboardControls.navigating = false; } }
        key-pressed(event) => {
            if (root.live-reloading) { return accept; }
            if (root.save-problem-open && event.text == Key.Escape) { root.save-problem-open = false; keys.focus(); return accept; }
            if (root.modal-open && event.text != Key.Escape) { return reject; }
            if (KeyboardControls.navigating && (event.text == Key.Tab || event.text == Key.Backtab)) { return reject; }
            if (KeyboardControls.navigating && event.text == Key.Escape) { KeyboardControls.navigating = false; keys.focus(); return accept; }
            if (event.text == Key.Escape && PaneDocking.active) { PaneDocking.active = false; PaneDocking.cancelled = true; return accept; }
            root.key-cmd(root.normalized-key(event.text), event.modifiers.control, event.modifiers.shift, event.modifiers.alt);
            accept
        }

        Rectangle { width: 100%; height: 100%; visible: !root.show-project-manager;
        VerticalLayout {
            spacing: 0;
            Rectangle {
                height: 30px; background: Palette.bg2; border-radius: 0px;
                LiveTouchArea { clicked => { root.open-menu = 0; keys.focus(); } }
                HorizontalLayout { alignment: start; spacing: 0;
                    menu-trigger-1 := BarItem { label: "File"; w: 48px; on: root.open-menu == 1; hovered => { if (root.open-menu != 0) { root.open-menu = 1; } } clicked => { root.open-menu = root.open-menu == 1 ? 0 : 1; } }
                    menu-trigger-2 := BarItem { label: "Edit"; w: 46px; on: root.open-menu == 2; hovered => { if (root.open-menu != 0) { root.open-menu = 2; } } clicked => { root.open-menu = root.open-menu == 2 ? 0 : 2; } }
                    menu-trigger-3 := BarItem { label: "Clip"; w: 46px; on: root.open-menu == 3; hovered => { if (root.open-menu != 0) { root.open-menu = 3; } } clicked => { root.open-menu = root.open-menu == 3 ? 0 : 3; } }
                    menu-trigger-4 := BarItem { label: "Sequence"; w: 78px; on: root.open-menu == 4; hovered => { if (root.open-menu != 0) { root.open-menu = 4; } } clicked => { root.open-menu = root.open-menu == 4 ? 0 : 4; } }
                    menu-trigger-5 := BarItem { label: "Mark"; w: 48px; on: root.open-menu == 5; hovered => { if (root.open-menu != 0) { root.open-menu = 5; } } clicked => { root.open-menu = root.open-menu == 5 ? 0 : 5; } }
                    menu-trigger-6 := BarItem { label: "Color"; w: 52px; on: root.open-menu == 6; hovered => { if (root.open-menu != 0) { root.open-menu = 6; } } clicked => { root.open-menu = root.open-menu == 6 ? 0 : 6; } }
                    menu-trigger-7 := BarItem { label: "View"; w: 48px; on: root.open-menu == 7; hovered => { if (root.open-menu != 0) { root.open-menu = 7; } } clicked => { root.open-menu = root.open-menu == 7 ? 0 : 7; } }
                    menu-trigger-8 := BarItem { label: "Window"; w: 64px; on: root.open-menu == 8; hovered => { if (root.open-menu != 0) { root.open-menu = 8; } } clicked => { root.open-menu = root.open-menu == 8 ? 0 : 8; } }
                    menu-trigger-9 := BarItem { label: "Help"; w: 48px; on: root.open-menu == 9; hovered => { if (root.open-menu != 0) { root.open-menu = 9; } } clicked => { root.open-menu = root.open-menu == 9 ? 0 : 9; } }
                }
            }
            Rectangle {
                height: 32px; min-width: 0px; preferred-width: 0px; background: Palette.bg2; border-radius: 0px;
                HorizontalLayout { spacing: 0; padding-right: 4px;
                    IconBtn { icon: @image-url("icons/quaternio.svg"); tooltip: "Project manager"; clicked => { root.command("project-manager"); } }
                    WsTab { label: "Import"; on: root.page == 0 && root.workspace == 1; clicked => { root.command("workspace-media"); } }
                    WsTab { label: "Edit"; on: root.page == 0 && root.workspace == 0; clicked => { root.command("workspace-edit"); } }
                    WsTab { label: "Color"; on: root.page == 0 && root.workspace == 2; clicked => { root.command("workspace-color"); } }
                    WsTab { label: "Export"; on: root.page == 1; clicked => { root.command("export-view"); } }
                    Rectangle { width: 8px; }
                    Rectangle { width: 1px; height: 32px;
                        Rectangle { y: 8px; width: 1px; height: 12px; background: Palette.bg3; }
                    }
                    Rectangle { width: 8px; }
                    Text { text: root.project-name; color: Palette.text-primary; font-size: 12px; font-weight: 500; horizontal-stretch: 1; min-width: 0px; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                    Rectangle { width: 8px; }
                    Text { visible: root.autosave-problem == ""; text: root.save-label; color: Palette.text-secondary; font-size: 11px; font-weight: 400; horizontal-alignment: left; vertical-alignment: center; }
                    if root.autosave-problem != "": TextBtn { label: "Save needs attention"; tooltip: root.autosave-problem; background: Palette.accent-muted; clicked => { root.save-problem-open = true; } }
                    Rectangle { horizontal-stretch: 1; }
                    TextBtn { label: root.session-active ? "Session ●" : "Collaborate"; tooltip: "Host or join a live peer session"; clicked => { root.command("session"); } }
                    if !root.compact-toolbar: TextBtn { label: "Activity"; tooltip: "Imports, exports, previews and media setup"; clicked => { root.command("activity"); } }
                    TextBtn { label: "Create"; tooltip: "Titles, captions and animation"; clicked => { root.command("creator"); } }
                    if !root.compact-toolbar: TextBtn { label: "Review"; tooltip: "Timecoded notes and review"; clicked => { root.command("review"); } }
                    TextBtn { label: "Import…"; tooltip: "Add media · " + root.shortcut-hint("import", root.shortcut-revision); clicked => { root.command("import"); } }
                    TextBtn { label: "Save"; tooltip: "Save project · " + root.shortcut-hint("save", root.shortcut-revision); clicked => { root.command("save"); } }
                    IconBtn { icon: @image-url("icons/search.svg"); tooltip: "Search commands · " + root.shortcut-hint("commands", root.shortcut-revision); clicked => { root.command-query = ""; root.show-command-palette = true; } }
                    Rectangle { width: 8px; }
                    if root.update-available: IconBtn {
                        retain-keyboard-focus: false;
                        tooltip: root.update-tooltip;
                        icon: @image-url("icons/update.svg");
                        armed: true;
                        clicked => { root.command("update-badge"); }
                    }
                    if root.update-available: Rectangle { width: 8px; }
                    undo-control := IconBtn { enabled: root.can-undo; tooltip: "Undo · " + root.shortcut-hint("undo", root.shortcut-revision) + (root.can-undo ? "" : "\nNothing to undo."); icon: @image-url("icons/undo.svg"); clicked => { root.command("undo"); } }
                    Rectangle { width: 2px; }
                    IconBtn { enabled: root.can-redo; tooltip: "Redo · " + root.shortcut-hint("redo", root.shortcut-revision) + (root.can-redo ? "" : "\nNothing to redo."); icon: @image-url("icons/redo.svg"); clicked => { root.command("redo"); } }
                    Rectangle { width: 8px; }
                    preferences-control := IconBtn { retain-keyboard-focus: false; tooltip: "Preferences and keyboard shortcuts · " + root.shortcut-hint("preferences", root.shortcut-revision); icon: @image-url("icons/list.svg"); clicked => { root.show-prefs = true; } }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
                if root.page == 0: VerticalLayout {
                    spacing: 0;
                    width: parent.width;
                    height: parent.height;
            if root.expanded-panel != 3: Rectangle {
                height: root.upper-h;
                vertical-stretch: 0;
                clip: true;
                HorizontalLayout { spacing: 0;
                    if root.workspace == 0 && !root.project-top && root.expanded-panel != 1: SourcePane { width: root.bin-w; active: root.active-panel == 0; activated => { root.active-panel = 0; } dockable: true; dock-panel(x, y) => { root.dock-pane(true, x, y); }
                        source-image: root.source-image; show-picture: root.show-source-picture; preparing: root.source-preparing; problem: root.source-problem; has-selected-media: root.has-selected-media; source-name: root.source-name; duration-tc: root.source-dur-tc;
                        cursor-tc: root.source-tc; cursor-text: root.source-timecode; usable: root.source-usable; playing: root.source-playing; position: root.source-position;
                        begin-timecode => { root.timecode-begin(true); } seek-timecode(text) => { root.timecode-seek(true, text) }
                        in-position: root.source-in-position; out-position: root.source-out-position; range-on: root.source-range-on; range-label: root.source-range-label; placeholder: root.source-placeholder;
                        play-hint: root.shortcut-hint("play-toggle", root.shortcut-revision); in-hint: root.shortcut-hint("mark-in", root.shortcut-revision); out-hint: root.shortcut-hint("mark-out", root.shortcut-revision);
                        back-hint: root.shortcut-hint("step-back", root.shortcut-revision); forward-hint: root.shortcut-hint("step-fwd", root.shortcut-revision); clear-hint: root.shortcut-hint("clear-io", root.shortcut-revision);
                        scrub(phase, position) => { root.source-scrub(phase, position); }
                        source-resized(w, h) => { if (w > 1 && h > 1) { root.source-px-width = w; root.source-px-height = h; } }
                        command(action) => { root.command(action); } focus-editor => { keys.focus(); }
                    }
                    if (root.workspace != 0 || root.project-top) && root.expanded-panel != 1: MediaBin { width: root.bin-w; active: root.active-panel == 2; activated => { root.active-panel = 2; } dockable: root.workspace == 0; dock-panel(x, y) => { root.dock-pane(false, x, y); }
                        selected-count: root.project-selected-count; sort-column: root.media-sort-column; sort-descending: root.media-sort-descending;
                        select-media(id, ctrl, shift) => { root.select-media(id, ctrl, shift); } sort-media(column) => { root.sort-media(column); }
                        bin-items: root.bin-items; has-media: root.has-media; armed-kind: root.armed-kind;
                        bins: root.bins; current-bin: root.current-bin; selected-media: root.has-selected-media;
                        create-bin(name) => { root.create-bin(name); } choose-bin(name) => { root.choose-bin(name); } move-to-bin(name) => { root.move-to-bin(name); }
                        query <=> root.query; bin-tab <=> root.bin-tab; icon-view <=> root.icon-view; bin-filter <=> root.bin-filter; filter-open <=> root.filter-open; filter-popup-x <=> root.filter-popup-x; filter-popup-y <=> root.filter-popup-y;
                        command(action) => { root.command(action); } pick(kind, id) => { root.pick(kind, id); } focus-editor => { keys.focus(); }
                        media-drag(id, phase, x, y) => { root.media-drag(id, phase, x, y); }
                    }
                    Rectangle { width: root.expanded-panel == 1 ? 0px : 5px; clip: true; background: source-divider.pressed || source-divider.has-hover ? Palette.bg3 : Palette.bg0;
                        Rectangle { x: 2px; y: 0px; width: 1px; height: 100%; background: source-divider.pressed || source-divider.has-hover ? Palette.accent : Palette.bg3; }
                        source-divider := LiveTouchArea {
                            enabled: root.workspace == 0 && root.expanded-panel < 0; mouse-cursor: ew-resize;
                            property <float> start-width;
                            property <length> start-x;
                            pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.start-width = root.bin-w / 1px; self.start-x = self.absolute-position.x + self.mouse-x; } }
                            moved => { if (self.pressed) { if (root.project-top) { root.project-width = max(240, min((root.width - root.insp-w - 330px) / 1px, self.start-width + (self.absolute-position.x + self.mouse-x - self.start-x) / 1px)); } else { root.source-width = max(240, min((root.width - root.insp-w - 330px) / 1px, self.start-width + (self.absolute-position.x + self.mouse-x - self.start-x) / 1px)); } } }
                        }
                    }
                    view-row := Rectangle {
                        width: parent.width - root.bin-w - root.insp-w - (root.expanded-panel == 1 ? 0px : root.workspace == 1 ? 5px : 10px);
                        background: Palette.bg0; clip: true;
                        if root.workspace == 1: SourcePane { width: 100%; height: 100%; active: root.active-panel == 0; activated => { root.active-panel = 0; }
                            source-image: root.source-image; show-picture: root.show-source-picture; preparing: root.source-preparing; problem: root.source-problem; has-selected-media: root.has-selected-media; source-name: root.source-name; duration-tc: root.source-dur-tc;
                            cursor-tc: root.source-tc; cursor-text: root.source-timecode; usable: root.source-usable; playing: root.source-playing; position: root.source-position;
                            begin-timecode => { root.timecode-begin(true); } seek-timecode(text) => { root.timecode-seek(true, text) }
                            in-position: root.source-in-position; out-position: root.source-out-position; range-on: root.source-range-on; range-label: root.source-range-label; placeholder: root.source-placeholder;
                            play-hint: root.shortcut-hint("play-toggle", root.shortcut-revision); in-hint: root.shortcut-hint("mark-in", root.shortcut-revision); out-hint: root.shortcut-hint("mark-out", root.shortcut-revision);
                            back-hint: root.shortcut-hint("step-back", root.shortcut-revision); forward-hint: root.shortcut-hint("step-fwd", root.shortcut-revision); clear-hint: root.shortcut-hint("clear-io", root.shortcut-revision);
                            scrub(phase, position) => { root.source-scrub(phase, position); }
                            source-resized(w, h) => { if (w > 1 && h > 1) { root.source-px-width = w; root.source-px-height = h; } }
                            command(action) => { root.command(action); } focus-editor => { keys.focus(); }
                        }
                        if root.workspace != 1: VerticalLayout { width: 100%; height: 100%; spacing: 0;
                            Rectangle { height: 30px; background: Palette.bg2;
                                LiveTouchArea { clicked => { root.active-panel = 1; keys.focus(); } }
                                Rectangle { x: 0px; y: 28px; width: 100%; height: 2px; background: root.active-panel == 1 ? Palette.accent : transparent; }
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px;
                                    Text { text: "Program"; color: Palette.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: root.seq-name; color: Palette.text-secondary; font-size: 12px; horizontal-stretch: 1; min-width: 0px; overflow: elide; vertical-alignment: center; }
                                    IconBtn { icon: root.expanded-panel == 1 ? @image-url("icons/restore-panel.svg") : @image-url("icons/expand-panel.svg"); tooltip: (root.expanded-panel == 1 ? "Restore workspace" : "Expand Program monitor") + " · " + root.shortcut-hint("toggle-panel-expand", root.shortcut-revision); retain-keyboard-focus: false; clicked => { root.active-panel = 1; keys.focus(); root.command("toggle-panel-expand"); } }
                                }
                            }
                            view-frame := Rectangle { vertical-stretch: 1; min-height: 32px; background: Palette.bg0; clip: true;
                                changed width => { root.view-w = self.width; root.resized(self.width / 1px, self.height / 1px, root.timeline-px, root.body-px); }
                                changed height => { root.view-h = self.height; root.resized(self.width / 1px, self.height / 1px, root.timeline-px, root.body-px); }
                                property <length> picture-w: min(self.width, self.height * max(0.01, root.sequence-aspect));
                                property <length> picture-h: self.picture-w / max(0.01, root.sequence-aspect);
                                if root.show-picture && root.has-clips: Image { width: 100%; height: 100%; source: root.viewer-image; image-fit: contain; horizontal-alignment: center; vertical-alignment: center; preferred-width: 0px; preferred-height: 0px; }
                                if root.creator-safe-guides && root.page==0: SafeGuides { width: 100%; height: 100%; ratio: root.canvas-ratio; }
                                PreviewContext { available-width: parent.width; available-height: parent.height; preparing: root.program-preparing; problem: root.program-problem; }
                                if root.has-clips && root.safe-margins: Rectangle { x: (parent.width - parent.picture-w) / 2 + parent.picture-w * 0.05; y: (parent.height - parent.picture-h) / 2 + parent.picture-h * 0.05; width: parent.picture-w * 0.90; height: parent.picture-h * 0.90; border-width: 1px; border-color: Palette.guide; }
                                if root.has-clips && root.safe-margins: Rectangle { x: (parent.width - parent.picture-w) / 2 + parent.picture-w * 0.10; y: (parent.height - parent.picture-h) / 2 + parent.picture-h * 0.10; width: parent.picture-w * 0.80; height: parent.picture-h * 0.80; border-width: 1px; border-color: Palette.guide; }
                                if !root.has-clips: VerticalLayout { padding: 24px; spacing: 10px; alignment: center;
                                    Rectangle { vertical-stretch: 1; }
                                    Text { text: "Sequence is empty"; color: Palette.text-primary; font-size: UiMetrics.title-font; font-weight: 600; horizontal-alignment: center; }
                                    Text { text: "Import media, then insert it into your timeline."; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                                    HorizontalLayout { alignment: center; PriBtn { label: "Import media"; clicked => { root.command("import"); keys.focus(); } } }
                                    Rectangle { vertical-stretch: 1; }
                                }
                                view-touch := LiveTouchArea { enabled: root.has-clips;
                                    pointer-event(event) => { root.active-panel = 1; keys.focus(); if (event.kind == PointerEventKind.down) { root.viewer(0, self.mouse-x / 1px, self.mouse-y / 1px); } if (event.kind == PointerEventKind.up) { root.viewer(2, self.mouse-x / 1px, self.mouse-y / 1px); } if (event.kind == PointerEventKind.cancel) { root.viewer(3, self.mouse-x / 1px, self.mouse-y / 1px); } }
                                    moved => { if (self.pressed) { root.viewer(1, self.mouse-x / 1px, self.mouse-y / 1px); } }
                                }
                            }
                            Rectangle { height: 24px; background: Palette.bg2;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px;
                                    TimecodeEntry { cells: root.program-tc; value: root.timecode; enabled: root.has-clips; ink: root.active-panel == 1 ? Palette.accent : Palette.text-primary; begin => { root.timecode-begin(false); } seek(text) => { root.timecode-seek(false, text) } finished => { keys.focus(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                    TcRun { cells: root.duration-tc; main: false; ink: Palette.text-secondary; }
                                }
                            }
                            Rectangle { height: 16px; background: Palette.bg2;
                                Rectangle { visible: root.has-clips; x: 8px; y: 7px; width: parent.width - 16px; height: 4px; background: Palette.bg3;
                                    Rectangle { x: max(0, min(1, root.in-frame / root.seq-frames)) * parent.width; width: max(0, min(1, (root.out-frame - root.in-frame) / root.seq-frames)) * parent.width; height: 4px; background: root.in-on && root.out-on ? Palette.accent-range : transparent; }
                                    Rectangle { x: max(0, min(1, root.playhead-frame / root.seq-frames)) * (parent.width - 2px); y: -4px; width: 2px; height: 12px; background: root.has-clips ? Palette.accent : Palette.text-disabled; }
                                }
                                program-seek := LiveTouchArea { enabled: root.has-clips; mouse-cursor: pointer;
                                    function seek(phase: int) {
                                        root.active-panel = 1; keys.focus();
                                        root.timeline(0, phase, (round(max(0, min(1, (self.mouse-x - 8px) / max(1px, self.width - 16px))) * max(0, root.seq-frames - 1)) + 0.5 - root.scroll-frames) * root.px, 0, false, false);
                                    }
                                    pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.seek(0); } if (event.kind == PointerEventKind.up) { self.seek(1); self.seek(2); } if (event.kind == PointerEventKind.cancel) { self.seek(3); } }
                                    moved => { if (self.pressed) { self.seek(1); } }
                                }
                            }
                            Rectangle { height: 34px; background: Palette.bg2;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 4px; alignment: center;
                                    IconBtn { enabled: root.has-clips; tooltip: "Previous frame · " + root.shortcut-hint("step-back", root.shortcut-revision); icon: @image-url("icons/step-back.svg"); clicked => { root.active-panel = 1; root.command("step-back"); keys.focus(); } }
                                    PlayBtn { enabled: root.has-clips; tooltip: "Play / pause · " + root.shortcut-hint("play-toggle", root.shortcut-revision); stopped: root.shuttle == "STOP"; clicked => { root.active-panel = 1; root.command("play-toggle"); keys.focus(); } }
                                    IconBtn { enabled: root.has-clips; tooltip: "Next frame · " + root.shortcut-hint("step-fwd", root.shortcut-revision); icon: @image-url("icons/step-forward.svg"); clicked => { root.active-panel = 1; root.command("step-fwd"); keys.focus(); } }
                                    IconBtn { enabled: root.has-clips; icon: @image-url("icons/mark-in.svg"); tooltip: "Mark sequence In · " + root.shortcut-hint("mark-in", root.shortcut-revision); clicked => { root.active-panel = 1; root.command("mark-in"); keys.focus(); } }
                                    IconBtn { enabled: root.has-clips; icon: @image-url("icons/mark-out.svg"); tooltip: "Mark sequence Out · " + root.shortcut-hint("mark-out", root.shortcut-revision); clicked => { root.active-panel = 1; root.command("mark-out"); keys.focus(); } }
                                }
                            }
                            Rectangle { height: 30px; background: Palette.bg2;
                                Text { x: 8px; width: parent.width - 162px; height: 100%; text: root.seq-fps + " fps · " + (root.in-on || root.out-on ? "Marked sequence" : "Entire sequence"); color: Palette.text-secondary; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                ChoiceButton { label: "Preview resolution"; x: parent.width - 154px; y: 1px; width: 146px; height: 28px; choices: [{text: "Full"}, {text: "Half"}, {text: "Quarter"}]; selected: root.quality; suffix: " resolution"; tooltip: "Playback resolution · lower it for smoother editing. Export quality is unchanged."; chosen(index) => { root.quality = index; keys.focus(); } }
                            }
                        }
                    }
                    Rectangle { width: root.workspace == 1 || root.expanded-panel == 1 ? 0px : 5px; clip: true; background: properties-divider.pressed || properties-divider.has-hover ? Palette.bg3 : Palette.bg0;
                        Rectangle { x: 2px; y: 0px; width: 1px; height: 100%; background: properties-divider.pressed || properties-divider.has-hover ? Palette.accent : Palette.bg3; }
                        properties-divider := LiveTouchArea {
                            enabled: root.workspace != 1 && root.expanded-panel < 0; mouse-cursor: ew-resize;
                            property <float> start-width;
                            property <length> start-x;
                            pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.start-width = root.insp-w / 1px; self.start-x = self.absolute-position.x + self.mouse-x; } }
                            moved => { if (self.pressed) { root.properties-width = max(260, min((root.width - 570px) / 1px, self.start-width - (self.absolute-position.x + self.mouse-x - self.start-x) / 1px)); } }
                        }
                    }
                    if root.expanded-panel != 1 && root.workspace != 1: Rectangle {
                        width: root.insp-w;
                        clip: true;
                        background: Palette.bg1;
                        VerticalLayout { spacing: 0;
                            Rectangle { height: 32px; background: Palette.bg2;
                                LiveTouchArea { clicked => { root.active-panel = 4; keys.focus(); } }
                                Rectangle { x: 0px; y: 30px; width: 100%; height: 2px; background: root.active-panel == 4 ? Palette.accent : transparent; }
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: start;
                                    Text { text: "Effect Controls"; color: Palette.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: root.inspector-mode == 0 ? "Sequence" : root.inspector-title; color: Palette.text-secondary; font-size: 12px; horizontal-stretch: 1; min-width: 0px; overflow: elide; vertical-alignment: center; }
                                }
                            }
                            Rectangle { height: 30px; background: Palette.bg2;
                                    HorizontalLayout { spacing: 0px;
                                        InspectorTab { label: "Video"; on: root.grade-tab == 0; clicked => { root.active-panel = 4; root.grade-tab = 0; } }
                                        InspectorTab { label: "Audio"; on: root.grade-tab == 1; clicked => { root.active-panel = 4; root.grade-tab = 1; } }
                                        InspectorTab { label: "Color"; on: root.grade-tab == 2; clicked => { root.active-panel = 4; root.grade-tab = 2; } }
                                        InspectorTab { min-width: 68px; label: "Transition"; on: root.grade-tab == 4; clicked => { root.active-panel = 4; root.grade-tab = 4; } }
                                        InspectorTab { label: "Info"; on: root.grade-tab == 5; clicked => { root.active-panel = 4; root.grade-tab = 5; } }
                                    }
                            }
                            Rectangle { vertical-stretch: 1; min-height: 0px; clip: true;
                                insp-scroll := Flickable {
                                    width: parent.width - 8px;
                                    height: 100%;
                                    content-width: self.width;
                                    content-height: max(self.height, body.preferred-height);
                                    body := VerticalLayout { alignment: start; spacing: 0; padding-bottom: 8px; width: parent.width;
                                    if root.inspector-mode == 0 && root.grade-tab != 1: VerticalLayout { alignment: start; spacing: 0; padding-top: 8px;
                                        PropLine { label: "Name"; value: root.seq-name; }
                                        PropLine { label: "Resolution"; value: root.res-label; }
                                        PropLine { label: "Frame rate"; value: root.seq-fps; numeric: true; }
                                        PropLine { label: "Duration"; value: root.duration-label; }
                                        PropLine { label: "Video tracks"; value: root.vid-count; numeric: true; }
                                        PropLine { label: "Audio tracks"; value: root.aud-count; numeric: true; }
                                        HorizontalLayout { padding-left: 8px; padding-top: 4px; alignment: start;
                                            TextBtn { label: "Sequence settings"; clicked => { root.active-panel = 4; root.command("sequence"); } }
                                        }
                                    }
                                    if root.inspector-mode == 1 && root.grade-tab == 0: VerticalLayout { alignment: start; spacing: 0; padding-top: 8px;
                                        FoldHead { label: "Motion"; open: root.motion-open; focused => { root.active-panel = 4; } toggled => { root.motion-open = !root.motion-open; } }
                                        if root.motion-open: VerticalLayout { spacing: 0; alignment: start;
                                            NumRow { focused => { root.active-panel = 4; } label: "Position X"; read: root.read-pos-x; value <=> root.pos-x; minimum: -4096; maximum: 4096; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("pos-x", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Position Y"; read: root.read-pos-y; value <=> root.pos-y; minimum: -4096; maximum: 4096; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("pos-y", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Scale"; read: root.read-scale; value <=> root.scale-v; minimum: 0.01; maximum: 4; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("scale", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Rotation"; read: "" + (round(root.motion-rotation * 1 * 100) / 100) + "°"; value <=> root.motion-rotation; minimum: -360; maximum: 360; display-scale: 1; changed(v) => { root.active-panel = 4; root.adjust("rotation", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Scale X"; read: "" + (round(root.motion-scale-x * 100 * 100) / 100) + "%"; value <=> root.motion-scale-x; minimum: 0.01; maximum: 10; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("scale-x", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Scale Y"; read: "" + (round(root.motion-scale-y * 100 * 100) / 100) + "%"; value <=> root.motion-scale-y; minimum: 0.01; maximum: 10; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("scale-y", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Anchor X"; read: "" + (round(root.motion-anchor-x * 100 * 100) / 100) + "%"; value <=> root.motion-anchor-x; minimum: 0; maximum: 1; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("anchor-x", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Anchor Y"; read: "" + (round(root.motion-anchor-y * 100 * 100) / 100) + "%"; value <=> root.motion-anchor-y; minimum: 0; maximum: 1; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("anchor-y", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Crop left"; read: "" + (round(root.motion-crop-left * 100 * 100) / 100) + "%"; value <=> root.motion-crop-left; minimum: 0; maximum: 1; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("crop-left", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Crop right"; read: "" + (round(root.motion-crop-right * 100 * 100) / 100) + "%"; value <=> root.motion-crop-right; minimum: 0; maximum: 1; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("crop-right", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Crop top"; read: "" + (round(root.motion-crop-top * 100 * 100) / 100) + "%"; value <=> root.motion-crop-top; minimum: 0; maximum: 1; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("crop-top", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Crop bottom"; read: "" + (round(root.motion-crop-bottom * 100 * 100) / 100) + "%"; value <=> root.motion-crop-bottom; minimum: 0; maximum: 1; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("crop-bottom", v); } }
                                            HorizontalLayout { padding: 8px; spacing: 8px;
                                                SecBtn { label: root.motion-flip-x ? "Unflip horizontal" : "Flip horizontal"; clicked => { root.adjust("flip-x", root.motion-flip-x ? 0 : 1); } }
                                                SecBtn { label: root.motion-flip-y ? "Unflip vertical" : "Flip vertical"; clicked => { root.adjust("flip-y", root.motion-flip-y ? 0 : 1); } }
                                            }
                                            HorizontalLayout { padding: 8px; alignment: start;
                                                TextBtn { label: "Reset motion"; tooltip: "Reset position, scale, rotation, anchor, crop and flips as one undoable edit"; clicked => { root.active-panel = 4; root.command("reset-motion"); } }
                                            }
                                        }
                                        FoldHead { label: "Opacity"; open: root.opacity-open; focused => { root.active-panel = 4; } toggled => { root.opacity-open = !root.opacity-open; } }
                                        if root.opacity-open: VerticalLayout { spacing: 0; alignment: start;
                                            NumRow { focused => { root.active-panel = 4; } label: "Opacity"; read: root.read-opacity; value <=> root.opacity-v; minimum: 0; maximum: 1; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("opacity", v); } }
                                            HorizontalLayout { padding: 8px; alignment: start;
                                                TextBtn { label: "Reset opacity"; clicked => { root.active-panel = 4; root.command("reset-opacity"); } }
                                            }
                                            }
                                    }
                                    if root.inspector-mode == 1 && root.grade-tab == 2: VerticalLayout { alignment: start; spacing: 0; padding-top: 8px;
                                        FoldHead { label: "Basic Correction"; open: root.basic-open; focused => { root.active-panel = 4; } toggled => { root.basic-open = !root.basic-open; } }
                                        if root.basic-open: VerticalLayout { spacing: 0; alignment: start;
                                            NumRow { focused => { root.active-panel = 4; } label: "Temperature"; read: root.read-temperature; value <=> root.temperature; minimum: -100; maximum: 100; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("temperature", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Tint"; read: root.read-tint; value <=> root.tint; minimum: -100; maximum: 100; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("tint", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Saturation"; read: root.read-saturation; value <=> root.saturation; minimum: -100; maximum: 100; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("saturation", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Exposure"; read: root.read-exposure; value <=> root.exposure; minimum: -5; maximum: 5; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("exposure", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Contrast"; read: root.read-contrast; value <=> root.contrast; minimum: -100; maximum: 100; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("contrast", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Highlights"; read: root.read-highlights; value <=> root.highlights; minimum: -100; maximum: 100; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("highlights", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Shadows"; read: root.read-shadows; value <=> root.shadows; minimum: -100; maximum: 100; bipolar: true; changed(v) => { root.active-panel = 4; root.adjust("shadows", v); } }
                                            HorizontalLayout { padding: 8px; alignment: start; TextBtn { label: "Reset all color"; clicked => { root.active-panel = 4; root.command("reset-grade"); } } }
                                        }
                                        FoldHead { label: "Color Wheels"; open: root.wheels-open; focused => { root.active-panel = 4; } toggled => { root.wheels-open = !root.wheels-open; } }
                                        if root.wheels-open: VerticalLayout { spacing: 0; alignment: start;
                                            GradeWheel { focused => { root.active-panel = 4; } title: "Lift · shadows"; read-m: root.read-lift-m; read-r: root.read-lift-r; read-g: root.read-lift-g; read-b: root.read-lift-b; master <=> root.lift-m; red <=> root.lift-r; green <=> root.lift-g; blue <=> root.lift-b; changed(channel, v) => { root.active-panel = 4; root.adjust("lift-" + channel, v); } }
                                            GradeWheel { focused => { root.active-panel = 4; } title: "Gamma · midtones"; read-m: root.read-gamma-m; read-r: root.read-gamma-r; read-g: root.read-gamma-g; read-b: root.read-gamma-b; master <=> root.gamma-m; red <=> root.gamma-r; green <=> root.gamma-g; blue <=> root.gamma-b; changed(channel, v) => { root.active-panel = 4; root.adjust("gamma-" + channel, v); } }
                                            GradeWheel { focused => { root.active-panel = 4; } title: "Gain · highlights"; read-m: root.read-gain-m; read-r: root.read-gain-r; read-g: root.read-gain-g; read-b: root.read-gain-b; master <=> root.gain-m; red <=> root.gain-r; green <=> root.gain-g; blue <=> root.gain-b; changed(channel, v) => { root.active-panel = 4; root.adjust("gain-" + channel, v); } }
                                        }
                                    }
                                    if root.inspector-mode == 2 && (root.grade-tab == 0 || root.grade-tab == 2): Text { text: "Select a video or image clip to adjust its picture."; x: 12px; width: parent.width - 24px; height: 64px; wrap: word-wrap; color: Palette.text-secondary; font-size: 12px; vertical-alignment: center; }
                                    if root.grade-tab == 1: VerticalLayout { alignment: start; spacing: 0; padding-top: 8px;
                                        SectionHead { label: "Stereo output"; }
                                        Rectangle { height: 83px; background: Palette.bg1;
                                            VerticalLayout { padding-left: 10px; padding-right: 10px; padding-top: 5px; padding-bottom: 5px; spacing: 4px;
                                                HorizontalLayout { spacing: 6px;
                                                    Text { text: "L"; width: 10px; color: Palette.text-secondary; font-size: 10px; vertical-alignment: center; }
                                                    AudioMeterBar { level: root.meter-left; held: root.meter-hold-left; clipped: root.meter-clip-left; horizontal-stretch: 1; }
                                                    Text { text: root.meter-read-left; width: 33px; color: root.meter-clip-left ? Palette.status-error : Palette.text-secondary; font-size: 10px; horizontal-alignment: right; }
                                                }
                                                HorizontalLayout { spacing: 6px;
                                                    Text { text: "R"; width: 10px; color: Palette.text-secondary; font-size: 10px; vertical-alignment: center; }
                                                    AudioMeterBar { level: root.meter-right; held: root.meter-hold-right; clipped: root.meter-clip-right; horizontal-stretch: 1; }
                                                    Text { text: root.meter-read-right; width: 33px; color: root.meter-clip-right ? Palette.status-error : Palette.text-secondary; font-size: 10px; horizontal-alignment: right; }
                                                }
                                                HorizontalLayout { padding-left: 16px; padding-right: 39px;
                                                    Text { text: "−60"; color: Palette.text-disabled; font-size: 9px; }
                                                    Text { text: "−24"; color: Palette.text-disabled; font-size: 9px; horizontal-alignment: center; horizontal-stretch: 1; }
                                                    Text { text: "0 dBFS"; color: Palette.text-disabled; font-size: 9px; horizontal-alignment: right; }
                                                }
                                                HorizontalLayout { alignment: end;
                                                    TextBtn { label: root.meter-clip-left || root.meter-clip-right ? "CLIP · Reset peaks" : "Reset peaks"; tooltip: "Clear the stereo peak hold and clipping indicators"; height: 22px; clicked => { root.command("clear-meters"); } }
                                                }
                                            }
                                        }
                                        if root.inspector-mode != 0: VerticalLayout { spacing: 0; alignment: start;
                                            SectionHead { label: "Selected clip"; }
                                            NumRow { focused => { root.active-panel = 4; } label: "Volume"; read: root.read-volume; value <=> root.volume-v; minimum: 0; maximum: 2; display-scale: 100; changed(v) => { root.active-panel = 4; root.adjust("volume", v); } }
                                            HorizontalLayout { padding: 8px; alignment: start; TextBtn { label: "Reset volume"; clicked => { root.active-panel = 4; root.volume-v = 1; root.adjust("volume", 1); } } }
                                        }
                                        SectionHead { label: "Audio tracks"; }
                                        for track in root.mixer-tracks: VerticalLayout { spacing: 0; alignment: start;
                                            Rectangle { height: 36px; background: Palette.bg1;
                                                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: start;
                                                    Text { text: track.name; color: track.muted ? Palette.text-secondary : Palette.text-primary; font-size: 12px; font-weight: 600; horizontal-stretch: 1; min-width: 0px; overflow: elide; vertical-alignment: center; }
                                                    TextBtn { label: track.muted ? "Unmute" : "Mute"; clicked => { root.active-panel = 4; root.pick("mute", track.index); keys.focus(); } }
                                                    TextBtn { label: "Solo"; tooltip: "Listen to soloed audio tracks; mute still applies"; background: track.solo ? Palette.accent-muted : Palette.bg2; clicked => { root.active-panel = 4; root.pick("solo", track.index); keys.focus(); } }
                                                }
                                            }
                                            NumRow { focused => { root.active-panel = 4; } label: "Gain"; read: track.read-gain; value: track.gain; follow-model: true; model-value: track.gain; minimum: 0; maximum: 2; display-scale: 100; changed(v) => { root.active-panel = 4; root.mix-track(track.index, "gain", v); } }
                                            NumRow { focused => { root.active-panel = 4; } label: "Balance"; read: track.read-pan; value: track.pan; follow-model: true; model-value: track.pan; minimum: -1; maximum: 1; bipolar: true; display-scale: 100; changed(v) => { root.active-panel = 4; root.mix-track(track.index, "pan", v); } }
                                            Rectangle { height: 8px; }
                                        }
                                        if root.mixer-tracks.length == 0: Text { text: "Add an audio track to mix your sequence."; color: Palette.text-secondary; font-size: 12px; wrap: word-wrap; height: 56px; vertical-alignment: center; }
                                        HorizontalLayout { padding: 8px; alignment: start; TextBtn { label: "Add audio track"; clicked => { root.active-panel = 4; root.command("add-audio"); keys.focus(); } } }
                                    }
                                    if root.inspector-mode != 0 && root.grade-tab == 4: VerticalLayout { alignment: start; padding-top: 8px;
                                        if root.trans-name == "": Rectangle { height: 24px; Text { text: "Select a transition on the timeline."; x: 8px; color: Palette.text-secondary; font-size: 12px; horizontal-alignment: left; vertical-alignment: center; } }
                                        if root.trans-name != "": PropLine { label: "Type"; value: root.trans-name; }
                                        if root.trans-name != "": NumRow { focused => { root.active-panel = 4; } label: "Duration"; read: root.read-trans; value <=> root.trans-dur; minimum: 2; maximum: 96; changed(v) => { root.active-panel = 4; root.adjust("trans-dur", v); } }
                                        if root.trans-name != "": PropLine { label: "Seconds"; value: root.read-seconds; }
                                        if root.trans-name != "": PropLine { label: "Anchor"; value: root.trans-anchor; }
                                        if root.trans-name != "": HorizontalLayout { padding-left: 8px; TextBtn { label: "Remove"; clicked => { root.active-panel = 4; root.command("remove-transition"); } } }
                                    }
                                    if root.inspector-mode != 0 && root.grade-tab == 5: VerticalLayout { alignment: start; padding-top: 8px;
                                        PropLine { label: "Name"; value: root.inspector-title; }
