}

component StripFrame inherits Rectangle {
    in property <bool> aerial: false;
    horizontal-stretch: 1;
    min-width: 4px;
    background: root.aerial ? #3a4434 : #2c2826;
    border-width: 1px;
    border-color: Palette.bg0;
    if !root.aerial: Rectangle { x: parent.width * 0.30; y: parent.height * 0.18; width: parent.width * 0.40; height: parent.height * 0.22; background: #241c18; }
    if !root.aerial: Rectangle { x: parent.width * 0.34; y: parent.height * 0.28; width: parent.width * 0.32; height: parent.height * 0.26; background: #bc9276; }
    if !root.aerial: Rectangle { x: parent.width * 0.16; y: parent.height * 0.58; width: parent.width * 0.68; height: parent.height * 0.42; background: #1c222e; }
    if root.aerial: Rectangle { y: 0px; height: 42%; width: 100%; background: #749ab6; }
    if root.aerial: Rectangle { y: parent.height * 0.42; height: 58%; width: 100%; background: #546844; }
    if root.aerial: Rectangle { x: parent.width * 0.22; y: parent.height * 0.48; width: parent.width * 0.08; height: 52%; background: #3a6880; }
}

