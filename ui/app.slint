import { LiveFocus, LiveTouchArea } from "live-focus.slint";
import { ProjectOrganizer } from "project-organizer.slint";
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Italic.ttf";

global Palette {
    out property <color> bg0: #171719;
    out property <color> bg1: #222224;
    out property <color> bg2: #29292C;
    out property <color> bg3: #3B3B40;
    out property <color> accent: #64B5F6;
    out property <color> text-primary: #E8E8EB;
    out property <color> text-secondary: #B3B3BC;
    out property <color> text-disabled: #747474;
    out property <color> text-on-action: #FFFFFF;
    out property <color> accent-muted: #293B4D;
    out property <color> accent-range: #244463;
    out property <color> accent-action: #2169A7;
    out property <color> accent-action-hover: #2C7BBC;
    out property <color> accent-action-pressed: #19588F;
    out property <color> row-pressed: #303030;
    out property <color> status-error: #D47870;
    out property <color> status-warning: #D4B06A;
    out property <color> status-ok: #7DCA9A;
    out property <color> danger: #9C4A4A;
    out property <color> danger-hover: #8E3E3E;
    out property <color> danger-pressed: #7A3434;
    out property <color> clip-video: #575078;
    out property <color> clip-video-on: #756896;
    out property <color> clip-audio: #355B4D;
    out property <color> clip-audio-on: #4C7766;
    out property <color> clip-still: #665039;
    out property <color> clip-still-on: #826649;
    out property <color> trans-video: #496B83;
    out property <color> trans-audio: #347A6A;
    out property <color> guide: #C8CDD6;
}

export struct BinItem { id: int, name: string, kind: string, info: string, selected: bool, tc-in: string, tc-out: string, duration: string, fps: string, offline: bool, thumbnail: image, }
export struct CommandItem { action: string, label: string, hint: string, enabled: bool, }
export struct KeyBindingRow { action: string, label: string, binding: string, modified: bool, }
export struct TrackHead { index: int, y: float, h: float, name: string, muted: bool, solo: bool, locked: bool, selected: bool, video: bool, }
export struct MixerTrack { index: int, name: string, gain: float, pan: float, read-gain: string, read-pan: string, muted: bool, solo: bool, }
export struct RazorGuide { x: float, y: float, h: float, }
export struct ClipView { waveform: image, waveform-x: float, waveform-width: float, filmstrip: image, filmstrip-x: float, filmstrip-width: float, id: int, x: float, y: float, w: float, h: float, name: string, selected: bool, video: bool, dim: bool, still: bool, offline: bool, }
export struct DropGhost { x: float, y: float, w: float, h: float, video: bool, }
export struct TransView { id: int, x: float, y: float, w: float, h: float, selected: bool, audio: bool, label: string, }
export struct Tick { x: float, label: string, major: bool, }
export struct QueueItem { id: int, name: string, output: string, status: string, removable: bool, retryable: bool, complete: bool, }
export struct MenuOption { label: string, hint: string, enabled: bool, divider: bool, }
export struct LabelItem { text: string, }
export struct ShortcutRow { keys: string, action: string, }
export struct Glyph { ch: string, sep: bool, }
export struct VersionRow { tag: string, date: string, prerelease: bool, current: bool, html-url: string, }

global KeyboardControls { in-out property <bool> blocked: false; in-out property <bool> navigating: false; }

global ToolHints {
    in-out property <string> text: "";
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
    in-out property <bool> shown: false;
    in-out property <bool> ready: false;
    changed shown => { root.ready = false; }
    changed text => { root.ready = false; }
}

component Ico inherits Image {
    in property <image> icon;
    in property <color> ink: Palette.text-secondary;
    x: 6px; y: 6px; width: 16px; height: 16px;
    source: root.icon;
    colorize: root.ink;
    image-fit: contain;
}

component PlayBtn inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> stopped: true;
    in property <string> tooltip: "";
    callback clicked();
    forward-focus: button-focus;
    in property <bool> retain-keyboard-focus: true;
    property <bool> keyboard-held: false;
    function release-key() { if (root.keyboard-held) { root.keyboard-held = false; LiveFocus.input-lost(); } }
    function show-help() {
        if ((touch.has-hover || button-focus.has-focus) && root.tooltip != "") {
            ToolHints.text = root.tooltip; ToolHints.x = touch.absolute-position.x + root.width / 2;
            ToolHints.y = touch.absolute-position.y + root.height + 5px; ToolHints.shown = true;
        } else if (ToolHints.text == root.tooltip) { ToolHints.shown = false; }
    }
    button-focus := FocusScope {
        enabled: root.enabled && !KeyboardControls.blocked;
        changed has-focus => { if (!self.has-focus) { root.release-key(); } else { KeyboardControls.navigating = true; } root.show-help(); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (!root.keyboard-held && root.enabled && !KeyboardControls.blocked) { root.keyboard-held = true; LiveFocus.input-gained(); }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (root.keyboard-held && root.enabled && !KeyboardControls.blocked) { root.release-key(); root.clicked(); if (root.retain-keyboard-focus && !KeyboardControls.blocked) { button-focus.focus(); } } else { root.release-key(); } return accept;
            }
            return reject;
        }
        Timer { interval: 150ms; running: root.keyboard-held; triggered => { LiveFocus.heartbeat(); } }
    }
    width: 30px; height: 28px; border-radius: 2px;
    border-width: button-focus.has-focus ? 1px : 0px; border-color: Palette.accent;
    background: touch.show-pressed || touch.has-hover ? Palette.bg3 : transparent;
    touch := LiveTouchArea { mouse-cursor: root.enabled ? pointer : default; clicked => { if (root.enabled && !KeyboardControls.blocked) { button-focus.focus(); root.clicked(); } }
        changed has-hover => { root.show-help(); }
    }
    Image { x: 7px; y: 6px; width: 16px; height: 16px; source: root.stopped ? @image-url("icons/play.svg") : @image-url("icons/pause.svg"); colorize: root.enabled ? Palette.text-primary : Palette.text-disabled; image-fit: contain; }
}

component IconBtn inherits Rectangle {
    in property <image> icon;
    in property <bool> armed: false;
    in property <bool> enabled: true;
    in property <string> tooltip: "";
    out property <length> popup-x: touch.absolute-position.x;
    out property <length> popup-y: touch.absolute-position.y + touch.height;
    callback clicked();
    forward-focus: button-focus;
    in property <bool> retain-keyboard-focus: true;
    property <bool> keyboard-held: false;
    function release-key() { if (root.keyboard-held) { root.keyboard-held = false; LiveFocus.input-lost(); } }
    function show-help() {
        if ((touch.has-hover || button-focus.has-focus) && root.tooltip != "") {
            ToolHints.text = root.tooltip; ToolHints.x = touch.absolute-position.x + root.width / 2;
            ToolHints.y = touch.absolute-position.y + root.height + 5px; ToolHints.shown = true;
        } else if (ToolHints.text == root.tooltip) { ToolHints.shown = false; }
    }
    button-focus := FocusScope {
        enabled: root.enabled && !KeyboardControls.blocked;
        changed has-focus => { if (!self.has-focus) { root.release-key(); } else { KeyboardControls.navigating = true; } root.show-help(); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (!root.keyboard-held && root.enabled && !KeyboardControls.blocked) { root.keyboard-held = true; LiveFocus.input-gained(); }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (root.keyboard-held && root.enabled && !KeyboardControls.blocked) { root.release-key(); root.clicked(); if (root.retain-keyboard-focus && !KeyboardControls.blocked) { button-focus.focus(); } } else { root.release-key(); } return accept;
            }
            return reject;
        }
        Timer { interval: 150ms; running: root.keyboard-held; triggered => { LiveFocus.heartbeat(); } }
    }
    width: 28px; height: 28px; border-radius: 2px;
    border-width: button-focus.has-focus ? 1px : 0px;
    border-color: Palette.accent;
    background: !root.enabled ? transparent : touch.show-pressed ? Palette.row-pressed : root.armed ? Palette.accent-muted : touch.has-hover ? Palette.bg3 : transparent;
    touch := LiveTouchArea { mouse-cursor: root.enabled ? pointer : default; clicked => { if (root.enabled && !KeyboardControls.blocked) { button-focus.focus(); root.clicked(); } }
        changed has-hover => { root.show-help(); }
    }
    Ico {
        icon: root.icon;
        ink: !root.enabled ? Palette.text-disabled : root.armed ? Palette.accent : touch.has-hover ? Palette.text-primary : Palette.text-secondary;
    }
}

global PopupBounds {
    in-out property <length> width: 1280px;
    in-out property <length> height: 800px;
}

component ChoiceButton inherits Rectangle {
    in property <[LabelItem]> choices;
    in property <int> selected: 0;
    in property <bool> enabled: true;
    in property <string> suffix: "";
    in property <image> icon;
    in property <string> tooltip: "";
    in property <bool> armed: false;
    callback chosen(int);
    property <int> highlighted: 0;
    height: 28px; min-width: root.icon.width > 0 ? 28px : 100px; background: !root.enabled ? Palette.bg2 : choice-touch.has-hover ? Palette.bg3 : root.armed ? Palette.accent-muted : Palette.bg0;
    border-width: 1px; border-color: button-focus.has-focus ? Palette.accent : Palette.bg3; border-radius: 3px;
    forward-focus: button-focus;
    property <bool> choice-opening: false;
    function open-choices() {
        if (!root.enabled || root.choices.length == 0) { return; }
        root.highlighted = max(0, min(root.choices.length - 1, root.selected));
        ToolHints.shown = false;
        root.choice-opening = true;
        choice-popup.show();
    }
    function choose(index: int) {
        if (!root.enabled || index < 0 || index >= root.choices.length) { return; }
        choice-popup.close();
        button-focus.focus();
        root.chosen(index);
    }
    button-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " " || event.text == Key.DownArrow || event.text == Key.UpArrow) { root.open-choices(); return accept; }
            return reject;
        }
    }
    if root.icon.width == 0: Text { x: 10px; width: parent.width - 34px; height: 100%; text: root.selected >= 0 && root.selected < root.choices.length ? root.choices[root.selected].text + root.suffix : "Choose…"; color: root.enabled ? Palette.text-primary : Palette.text-disabled; font-size: 12px; overflow: elide; vertical-alignment: center; }
    Image { x: root.icon.width > 0 ? 6px : parent.width - 24px; y: 6px; width: 16px; height: 16px; source: root.icon.width > 0 ? root.icon : @image-url("icons/chevron-down.svg"); colorize: !root.enabled ? Palette.text-disabled : root.armed ? Palette.accent : Palette.text-secondary; }
    choice-touch := LiveTouchArea { mouse-cursor: root.enabled ? pointer : default; clicked => { button-focus.focus(); root.open-choices(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") { ToolHints.text = root.tooltip; ToolHints.x = self.absolute-position.x + self.width / 2; ToolHints.y = self.absolute-position.y + self.height + 5px; ToolHints.shown = true; }
            else if (ToolHints.text == root.tooltip) { ToolHints.shown = false; }
        }
    }
    choice-popup := PopupWindow {
        width: min(max(root.width, 180px), PopupBounds.width - 16px);
        height: min(min(252px, PopupBounds.height - 24px), root.choices.length * 28px + 8px);
        x: max(8px - choice-touch.absolute-position.x, min(0px, PopupBounds.width - choice-touch.absolute-position.x - self.width - 8px));
        y: choice-touch.absolute-position.y + root.height + self.height + 4px <= PopupBounds.height - 8px ? root.height + 4px : max(8px - choice-touch.absolute-position.y, -self.height - 4px);
        close-on-click: true;
        forward-focus: choice-focus;
        Timer {
            interval: 1ms;
            running: root.choice-opening;
            triggered => { root.choice-opening = false; choice-focus.focus(); choice-focus.reveal-choice(); }
        }
        choice-focus := FocusScope {
                Timer { interval: 150ms; running: choice-focus.has-focus; triggered => { LiveFocus.heartbeat(); } }
            property <bool> live-focus-counted: false;
            changed has-focus => {
                if (self.has-focus != self.live-focus-counted) {
                    self.live-focus-counted = self.has-focus;
                    if (self.has-focus) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); }
                }
            }

    function reveal-choice() {
        choice-scroll.viewport-y = -max(0px, min(max(0px, choice-scroll.viewport-height - choice-scroll.height), max(root.highlighted * 28px + 28px - choice-scroll.height, min(-choice-scroll.viewport-y, root.highlighted * 28px))));
    }

            key-pressed(event) => {
                if (event.text == Key.Escape || event.text == Key.Tab || event.text == Key.Backtab) { choice-popup.close(); button-focus.focus(); return accept; }
                if (event.text == Key.UpArrow) { root.highlighted = max(0, root.highlighted - 1); choice-focus.reveal-choice(); return accept; }
                if (event.text == Key.DownArrow) { root.highlighted = min(root.choices.length - 1, root.highlighted + 1); choice-focus.reveal-choice(); return accept; }
                if (event.text == Key.Home) { root.highlighted = 0; choice-focus.reveal-choice(); return accept; }
                if (event.text == Key.End) { root.highlighted = root.choices.length - 1; choice-focus.reveal-choice(); return accept; }
                if (event.text == Key.Return) { root.choose(root.highlighted); return accept; }
                return accept;
            }
            Rectangle { background: Palette.bg2; border-width: 1px; border-color: #454545; border-radius: 4px; clip: true;
                choice-scroll := Flickable { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                    viewport-width: self.width; viewport-height: root.choices.length * 28px;
                    viewport-y: 0px;
                    VerticalLayout { width: parent.width; spacing: 0px;
                        for item[index] in root.choices: Rectangle { height: 28px; background: root.highlighted == index || row-touch.has-hover ? Palette.accent-muted : transparent;
                            Rectangle { x: 0px; y: 5px; width: 2px; height: 18px; background: root.selected == index ? Palette.accent : transparent; }
                            Text { x: 9px; width: parent.width - 18px; height: 100%; text: item.text + root.suffix; color: root.selected == index ? Palette.accent : Palette.text-primary; font-size: 12px; font-weight: root.selected == index ? 600 : 400; vertical-alignment: center; overflow: elide; }
                            row-touch := LiveTouchArea { mouse-cursor: pointer; clicked => { root.choose(index); } }
                        }
                    }
                }
                if choice-scroll.viewport-height > choice-scroll.height: Rectangle { x: parent.width - 5px; y: 4px; width: 3px; height: parent.height - 8px; background: Palette.bg0;
                    Rectangle { x: 0px; width: 3px; height: max(18px, parent.height * choice-scroll.height / choice-scroll.viewport-height); y: max(0px, min(parent.height - self.height, (parent.height - self.height) * -choice-scroll.viewport-y / max(1px, choice-scroll.viewport-height - choice-scroll.height))); background: Palette.text-disabled; }
                }
            }
        }
    }
}

component SecBtn inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> dropdown: false;
    in property <bool> expanded: false;
    callback clicked();
    forward-focus: action-focus;
    action-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { return accept; } return reject; }
        key-released(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; }
    }
    horizontal-stretch: 0; height: 28px; border-radius: 4px;
    border-width: 1px; border-color: action-focus.has-focus ? Palette.accent : Palette.bg3;
    background: !root.enabled ? Palette.bg2 : touch.show-pressed ? Palette.row-pressed : touch.has-hover ? Palette.bg3 : Palette.bg2;
    touch := LiveTouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { if (root.enabled) { root.clicked(); } } }
    HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: start;
        Text { text: root.label; color: root.enabled ? Palette.text-primary : Palette.text-disabled; font-size: 12px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
        if root.dropdown: Rectangle { width: 12px;
            Image { x: 0px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; source: root.expanded ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg"); colorize: root.enabled ? Palette.text-secondary : Palette.text-disabled; }
        }
    }
}

component PriBtn inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    forward-focus: action-focus;
    action-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { return accept; } return reject; }
        key-released(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; }
    }
    horizontal-stretch: 0; height: 28px; border-radius: 4px; border-width: action-focus.has-focus ? 1px : 0px; border-color: Palette.accent;
    background: !root.enabled ? Palette.bg3 : touch.show-pressed ? Palette.accent-action-pressed : touch.has-hover ? Palette.accent-action-hover : Palette.accent-action;
    touch := LiveTouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { if (root.enabled) { root.clicked(); } } }
    HorizontalLayout { padding-left: 10px; padding-right: 10px; alignment: start;
        Text { text: root.label; color: root.enabled ? Palette.text-on-action : Palette.text-disabled; font-size: 12px; font-weight: 600; horizontal-alignment: left; vertical-alignment: center; }
    }
}

component TextBtn inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <string> tooltip: "";
    in property <bool> dropdown: false;
    in property <bool> expanded: false;
    callback clicked();
    forward-focus: action-focus;
    action-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { return accept; } return reject; }
        key-released(event) => { if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; } return reject; }
    }
    border-width: action-focus.has-focus ? 1px : 0px; border-color: Palette.accent;
    horizontal-stretch: 0; height: 26px; border-radius: 4px;
    background: !root.enabled ? Palette.bg2 : touch.show-pressed ? Palette.row-pressed : touch.has-hover ? Palette.bg3 : Palette.bg2;
    touch := LiveTouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { if (root.enabled) { root.clicked(); } }
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                ToolHints.text = root.tooltip;
                ToolHints.x = self.absolute-position.x + self.width / 2;
                ToolHints.y = self.absolute-position.y + self.height + 5px;
                ToolHints.shown = true;
            } else if (ToolHints.text == root.tooltip) { ToolHints.shown = false; }
        }
    }
    HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 6px; alignment: start;
        Text { text: root.label; color: root.enabled ? (touch.has-hover ? Palette.text-primary : Palette.text-secondary) : Palette.text-disabled; font-size: 12px; font-weight: 500; horizontal-alignment: left; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
        if root.dropdown: Rectangle { width: 12px;
            Image { x: 0px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; source: root.expanded ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg"); colorize: root.enabled ? Palette.text-secondary : Palette.text-disabled; }
        }
    }
}

component AudioMeterBar inherits Rectangle {
    in property <float> level;
    in property <float> held;
    in property <bool> clipped;
    height: 11px; background: Palette.bg0; clip: true;
    Rectangle { width: 70%; height: 100%; background: #55AD77; }
    Rectangle { x: parent.width * 0.7; width: parent.width * 0.2; height: 100%; background: #D4B05C; }
    Rectangle { x: parent.width * 0.9; width: parent.width * 0.1; height: 100%; background: #D46B61; }
    Rectangle { x: parent.width * root.level; width: parent.width * (1 - root.level); height: 100%; background: Palette.bg0; }
    Rectangle { x: min(parent.width - 2px, max(0px, parent.width * root.held)); width: 2px; height: 100%; background: root.held > 0 ? Palette.text-primary : transparent; }
    Rectangle { x: parent.width - 3px; width: 3px; height: 100%; background: root.clipped ? #FF5F57 : transparent; }
}

component Field inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder: "";
    callback focused();
    height: 28px; border-radius: 3px; background: Palette.bg0; border-width: 1px; border-color: input.has-focus ? Palette.accent : Palette.bg3;
    Text { text: root.value == "" ? root.placeholder : ""; x: 7px; width: parent.width - 14px; height: 100%; color: Palette.text-secondary; font-size: 12px; font-weight: 400; horizontal-alignment: left; vertical-alignment: center; }
    input := TextInput {
                Timer { interval: 150ms; running: input.has-focus; triggered => { LiveFocus.heartbeat(); } }
                property <bool> live-focus-counted: false; x: 7px; width: parent.width - 14px; height: 100%; text <=> root.value; color: Palette.text-primary; font-size: 12px; font-weight: 400; horizontal-alignment: left; vertical-alignment: center; single-line: true; changed has-focus => { if (self.has-focus != self.live-focus-counted) { self.live-focus-counted = self.has-focus; if (self.has-focus) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); } }  if (self.has-focus) { root.focused(); } } }
}

component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in property <bool> enabled: true;
    callback clicked();
    height: 28px; border-radius: 3px;
    background: !root.enabled ? Palette.bg2 : touch.show-pressed ? Palette.row-pressed : touch.has-hover ? Palette.bg3 : Palette.bg2;
    touch := LiveTouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { if (root.enabled) { root.clicked(); } } }
    HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 12px;
        Text { text: root.label; color: root.enabled ? Palette.text-primary : Palette.text-disabled; font-size: 12px; font-weight: 400; horizontal-alignment: left; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
        Text { text: root.hint; color: root.enabled ? Palette.text-secondary : Palette.text-disabled; font-size: 11px; font-weight: 400; horizontal-alignment: right; vertical-alignment: center; horizontal-stretch: 0; min-width: 0px; max-width: max(48px, (root.width - 32px) / 2); overflow: elide; }
    }
}

component KeyboardMenu inherits Rectangle {
    in property <[MenuOption]> items;
    in property <int> menu-id;
    callback activated(int);
    callback dismissed();
    callback adjacent(int);
    property <int> highlighted: -1;
    property <bool> opening: true;
    changed menu-id => { root.opening = true; }
    background: Palette.bg2; border-width: 1px; border-color: Palette.bg3; border-radius: 3px;
    height: min(root.items.length * 28px + 8px, PopupBounds.height - 48px);
    forward-focus: menu-focus;
    property <int> scan-index: 0;
    function next-enabled(start: int, direction: int) -> int {
        if (root.items.length == 0) { return -1; }
        root.scan-index = start < 0 ? root.items.length - 1 : start >= root.items.length ? 0 : start;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        if (root.items[root.scan-index].enabled) { return root.scan-index; }
        root.scan-index = root.scan-index + direction < 0 ? root.items.length - 1 : root.scan-index + direction >= root.items.length ? 0 : root.scan-index + direction;
        return -1;
    }

    Timer { interval: 1ms; running: root.opening; triggered => { root.opening = false; root.highlighted = root.next-enabled(0, 1); menu-focus.focus(); menu-focus.reveal(); } }
    menu-focus := FocusScope {
        property <bool> counted: false;
        changed has-focus => {
            if (self.has-focus != self.counted) { self.counted = self.has-focus; if (self.counted) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); } }
        }
        Timer { interval: 150ms; running: menu-focus.has-focus; triggered => { LiveFocus.heartbeat(); } }
        function reveal() {
            menu-scroll.viewport-y = -max(0px, min(max(0px, menu-scroll.viewport-height - menu-scroll.height), max(root.highlighted * 28px + 28px - menu-scroll.height, min(-menu-scroll.viewport-y, root.highlighted * 28px))));
        }
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Tab || event.text == Key.Backtab) { root.dismissed(); return accept; }
            if (event.text == Key.LeftArrow || event.text == Key.RightArrow) { root.adjacent(event.text == Key.LeftArrow ? -1 : 1); return accept; }
            if (event.text == Key.UpArrow || event.text == Key.DownArrow) { root.highlighted = root.next-enabled(root.highlighted + (event.text == Key.UpArrow ? -1 : 1), event.text == Key.UpArrow ? -1 : 1); self.reveal(); return accept; }
            if (event.text == Key.Home || event.text == Key.End) { root.highlighted = root.next-enabled(event.text == Key.Home ? 0 : root.items.length - 1, event.text == Key.Home ? 1 : -1); self.reveal(); return accept; }
            if (event.text == Key.Return || event.text == " ") { if (root.highlighted >= 0 && root.items[root.highlighted].enabled) { root.activated(root.highlighted); } return accept; }
            return accept;
        }
        key-released(event) => { accept }
        menu-scroll := Flickable { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
            viewport-height: root.items.length * 28px; viewport-width: self.width;
            for item[index] in root.items: Rectangle { y: index * 28px; height: 28px; width: menu-scroll.width;
                background: item.enabled && root.highlighted == index ? Palette.accent-muted : Palette.bg2;
                if item.divider: Rectangle { x: 4px; width: parent.width - 8px; height: 1px; background: Palette.bg3; }
                Text { x: 8px; width: max(0px, parent.width - 100px); height: 100%; text: item.label; color: item.enabled ? Palette.text-primary : Palette.text-disabled; font-size: 12px; vertical-alignment: center; overflow: elide; }
                Text { x: max(0px, parent.width - 92px); width: 84px; height: 100%; text: item.hint; color: item.enabled ? Palette.text-secondary : Palette.text-disabled; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                LiveTouchArea { mouse-cursor: item.enabled ? pointer : default;
                    moved => { if (item.enabled) { root.highlighted = index; } }
                    clicked => { if (item.enabled) { root.activated(index); } }
                }
            }
        }
    }
}

component BarItem inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    in property <length> w: 48px;
    callback clicked();
    width: root.w; height: 28px; border-radius: 3px;
    background: root.on || touch.has-hover ? Palette.bg3 : Palette.bg2;
    touch := LiveTouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout { padding-left: 8px; padding-right: 8px; alignment: start;
        Text { text: root.label; color: Palette.text-primary; font-size: 11px; font-weight: 400; horizontal-alignment: left; vertical-alignment: center; }
    }
}

component WsTab inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    callback clicked();
    horizontal-stretch: 0; height: 32px; border-radius: 0px;
    touch := LiveTouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    VerticalLayout { alignment: end; spacing: 0;
        HorizontalLayout { padding-left: 12px; padding-right: 12px; height: 29px; alignment: start;
            Text { text: root.label; color: root.on || touch.has-hover ? Palette.text-primary : Palette.text-secondary; font-size: 12px; font-weight: root.on ? 600 : 400; horizontal-alignment: left; vertical-alignment: center; }
        }
        Rectangle { height: 2px; background: root.on ? Palette.accent : Palette.bg2; }
    }
}

component InspectorTab inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    callback clicked();
    horizontal-stretch: 1; min-width: 0px; height: 30px;
    background: root.on ? Palette.accent-muted : touch.has-hover ? Palette.bg3 : Palette.bg2;
    touch := LiveTouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text { text: root.label; width: 100%; height: 100%; color: root.on ? Palette.accent : Palette.text-secondary; font-size: 12px; font-weight: root.on ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    Rectangle { y: parent.height - 2px; width: 100%; height: 2px; background: root.on ? Palette.accent : transparent; }
}

component TcRun inherits HorizontalLayout {
    in property <[Glyph]> cells;
    in property <bool> main: false;
    in property <color> ink: Palette.text-primary;
    height: root.main ? 24px : 16px;
    spacing: 0; alignment: start;
    for g in root.cells: Text {
        text: g.ch;
        width: g.sep ? (root.main ? 6px : 4px) : (root.main ? 13px : 8px);
        height: root.main ? 24px : 16px;
        font-size: root.main ? 18px : 11px;
        font-weight: 500;
        color: root.ink;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
}

component TimecodeEntry inherits Rectangle {
    in property <[Glyph]> cells;
    in property <string> value;
    in property <color> ink: Palette.text-primary;
    in property <bool> enabled: true;
    property <bool> editing: false;
    property <bool> invalid: false;
    callback begin();
    callback seek(string) -> bool;
    callback finished();
    width: 108px; height: 22px;
    background: root.editing ? Palette.bg0 : hit.has-hover && root.enabled ? Palette.bg3 : transparent;
    border-width: root.editing ? 1px : 0px;
    border-color: root.invalid ? Palette.status-error : Palette.accent;
    border-radius: 2px;
    if !root.editing: TcRun { x: 2px; y: 4px; cells: root.cells; ink: root.ink; }
    hit := LiveTouchArea {
        enabled: root.enabled && !root.editing; mouse-cursor: text;
        clicked => { root.begin(); input.text = root.value; root.invalid = false; root.editing = true; input.focus(); input.select-all(); }
        changed has-hover => {
            if (self.has-hover && root.enabled && !root.editing) {
                ToolHints.text = "Jump to timecode or frame\nEnter to jump · Esc to cancel";
                ToolHints.x = self.absolute-position.x + root.width / 2; ToolHints.y = self.absolute-position.y + root.height + 5px; ToolHints.shown = true;
            } else if (ToolHints.text == "Jump to timecode or frame\nEnter to jump · Esc to cancel") { ToolHints.shown = false; }
        }
    }
    FocusScope {
        visible: root.editing;
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.editing = false; root.invalid = false; root.finished(); return accept; }
            return reject;
        }
        input := TextInput {
            x: 4px; width: parent.width - 8px; height: 100%;
            enabled: root.editing; single-line: true; color: Palette.text-primary; font-size: 11px;
            vertical-alignment: center;
            property <bool> counted: false;
            Timer { interval: 150ms; running: input.has-focus; triggered => { LiveFocus.heartbeat(); } }
            changed has-focus => {
                if (self.has-focus != self.counted) { self.counted = self.has-focus; if (self.has-focus) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); root.editing = false; root.invalid = false; } }
            }
            edited => { root.invalid = false; }
            accepted => {
                if (root.seek(self.text)) { root.editing = false; root.finished(); }
                else { root.invalid = true; self.select-all(); }
            }
        }
    }
}

component FoldHead inherits Rectangle {
    in property <string> label;
    in property <bool> open: false;
    in property <bool> enabled: true;
    callback toggled();
    height: 22px; border-radius: 0px; background: Palette.bg1; border-width: 0px;
    Rectangle { height: 1px; background: Palette.bg3; }
    touch := LiveTouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { if (root.enabled) { root.toggled(); } } }
    HorizontalLayout { padding-left: 8px; spacing: 4px; alignment: start; y: 1px; height: 21px;
        Rectangle { width: 12px;
            Image { x: 0px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; source: root.open ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg"); colorize: root.enabled ? Palette.text-secondary : Palette.text-disabled; }
        }
        Text { text: root.label; color: root.enabled ? Palette.text-primary : Palette.text-disabled; font-size: 11px; font-weight: 600; horizontal-alignment: left; vertical-alignment: center; }
    }
}

