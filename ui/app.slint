                                            if clip.video && clip.filmstrip.width > 0: Image { x: clip.filmstrip-x * 1px; y: 20px; width: max(0px, clip.filmstrip-width * 1px); height: max(0px, parent.height - 20px); source: clip.filmstrip; image-fit: fill; preferred-width: 0px; preferred-height: 0px; opacity: clip.dim ? 0.5 : 1; }
                                            // Bound text to the viewport: Slint software text sizes are i16
