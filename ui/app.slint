            Rectangle { height: root.panel-split-h; clip: true; background: divider.pressed || divider.has-hover ? Palette.bg3 : Palette.bg0;
                Rectangle { y: 3px; height: 1px; width: 100%; background: divider.pressed || divider.has-hover ? Palette.accent : transparent; }
                divider := LiveTouchArea {
