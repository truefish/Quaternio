                                    IconBtn { icon: @image-url("icons/link.svg"); tooltip: "Linked selection · " + root.shortcut-hint("linked-selection", root.shortcut-revision) + "\nSelect linked video and audio together; does not create links."; armed: root.linked-on; clicked => { root.active-panel = 3; keys.focus(); root.command("linked-selection"); } }
