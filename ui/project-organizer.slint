import { Palette, UiMetrics, KeyboardControls } from "style.slint";
import { LiveFocus, LiveTouchArea } from "live-focus.slint";
component OrganizerButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: button-focus;
    button-focus := FocusScope {
        enabled: root.enabled && !KeyboardControls.blocked;
        changed has-focus => { if (self.has-focus) { KeyboardControls.navigating = true; } }
        key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { return accept; } return reject; }
        key-released(event) => { if (event.text == Key.Return || event.text == " ") { if (root.enabled && !KeyboardControls.blocked) { root.clicked(); } return accept; } return reject; }
    }
    height: UiMetrics.control-height;
    border-radius: UiMetrics.radius;
    border-width: 1px;
    border-color: button-focus.has-focus ? Palette.accent : Palette.bg3;
    background: !root.enabled ? Palette.bg2 : touch.pressed ? Palette.row-pressed : touch.has-hover ? Palette.bg3 : Palette.bg2;
    Text {
        text: root.label;
        width: 100%; height: 100%;
        color: root.enabled ? Palette.text-primary : Palette.text-disabled;
        font-size: UiMetrics.control-font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := LiveTouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { button-focus.focus(); root.clicked(); }
    }
}

export component ProjectOrganizer inherits Rectangle {
    in property <length> window-width: 1280px;
    in property <length> window-height: 800px;
    in property <[string]> bins;
    in property <string> current-bin;
    in property <bool> selected-media;
    callback create-bin(string);
    callback choose-bin(string);
    callback move-to-bin(string);

    private property <bool> moving: false;
    private property <int> highlighted: 0;
    private property <string> new-name: "";
    height: 32px;
    min-width: 200px;

    forward-focus: organizer-focus;
    property <bool> bins-opening: false;
    property <length> anchor-x: filter-touch.absolute-position.x;
    property <length> anchor-y: filter-touch.absolute-position.y;
    organizer-focus := FocusScope {
        changed has-focus => { if (self.has-focus) { KeyboardControls.navigating = true; } }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " " || event.text == Key.DownArrow) {
                root.moving = false;
                root.highlighted = max(0, min(root.bins.length, root.highlighted));
                root.anchor-x = filter-touch.absolute-position.x; root.anchor-y = filter-touch.absolute-position.y; new-bin-menu.close(); root.bins-opening = true; bins-menu.show();
                return accept;
            }
            return reject;
        }
    }

    function choose-target(index: int) {
        if (index < 0 || index > root.bins.length) { return; }
        root.highlighted = index;
        bins-menu.close();
        organizer-focus.focus();
        if (root.moving) {
            root.move-to-bin(index == 0 ? "" : root.bins[index - 1]);
        } else {
            root.choose-bin(index == 0 ? "" : root.bins[index - 1]);
        }
    }

    function submit-new-bin() {
        if (root.new-name == "") { return; }
        root.create-bin(root.new-name);
        new-bin-menu.close();
        root.new-name = "";
    }

    HorizontalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: UiMetrics.space-xs;
        Rectangle {
            min-width: 70px;
            horizontal-stretch: 1;
            border-radius: UiMetrics.radius;
            border-width: 1px;
            border-color: Palette.bg3;
            background: filter-touch.has-hover ? Palette.bg2 : Palette.bg0;
            Text {
                x: 8px;
                width: parent.width - UiMetrics.control-height;
                height: 100%;
                text: root.current-bin == "" ? "All media" : root.current-bin;
                color: Palette.text-primary;
                font-size: UiMetrics.control-font;
                vertical-alignment: center;
                overflow: elide;
            }
            Image {
                x: parent.width - 20px;
                y: (parent.height - 16px) / 2;
                width: 16px;
                height: 16px;
                source: @image-url("icons/chevron-down.svg");
                colorize: Palette.text-secondary;
                image-fit: contain;
            }
            filter-touch := LiveTouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.anchor-x = filter-touch.absolute-position.x; root.anchor-y = filter-touch.absolute-position.y;
                    root.moving = false;
                    root.highlighted = max(0, min(root.bins.length, root.highlighted));
                    new-bin-menu.close();
                    root.bins-opening = true; bins-menu.show();
                }
            }
        }
        move-button := OrganizerButton {
            width: 82px;
            label: "Move to…";
            enabled: root.selected-media;
            clicked => {
                root.anchor-x = move-button.absolute-position.x; root.anchor-y = move-button.absolute-position.y;
                root.moving = true;
                root.highlighted = max(0, min(root.bins.length, root.highlighted));
                new-bin-menu.close();
                root.bins-opening = true; bins-menu.show();
            }
        }
        new-button := OrganizerButton {
            width: 60px;
            label: "+ Bin";
            clicked => { root.anchor-x = new-button.absolute-position.x; root.anchor-y = new-button.absolute-position.y; bins-menu.close(); new-bin-menu.show(); }
        }
    }

    bins-menu := PopupWindow {
        x: max(8px - root.absolute-position.x, min(root.anchor-x - root.absolute-position.x, root.window-width - root.absolute-position.x - self.width - 8px));
        y: root.anchor-y + UiMetrics.control-height + self.height + 4px <= root.window-height - 8px ? root.anchor-y - root.absolute-position.y + UiMetrics.control-height + 4px : max(8px - root.absolute-position.y, root.anchor-y - root.absolute-position.y - self.height - 4px);
        width: min(max(root.width, 240px), root.window-width - 16px);
        height: min(min(252px, root.window-height - 24px), (root.bins.length + 1) * UiMetrics.control-height + 8px);
        close-policy: close-on-click;
        forward-focus: menu-focus;
        Timer {
            interval: 1ms;
            running: root.bins-opening;
            triggered => { root.bins-opening = false; menu-focus.focus(); menu-focus.reveal-bin(); }
        }
        menu-focus := FocusScope {
                Timer { interval: 150ms; running: menu-focus.has-focus; triggered => { LiveFocus.heartbeat(); } }
            property <bool> live-focus-counted: false;
            changed has-focus => {
                if (self.has-focus != self.live-focus-counted) {
                    self.live-focus-counted = self.has-focus;
                    if (self.has-focus) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); }
                }
            }

    function reveal-bin() {
        bin-scroll.content-y = -max(0px, min(max(0px, bin-scroll.content-height - bin-scroll.height), max(root.highlighted * UiMetrics.control-height + UiMetrics.control-height - bin-scroll.height, min(-bin-scroll.content-y, root.highlighted * UiMetrics.control-height))));
    }

            key-pressed(event) => {
                if (event.text == Key.Escape || event.text == Key.Tab || event.text == Key.Backtab) { bins-menu.close(); organizer-focus.focus(); return accept; }
                if (event.text == Key.UpArrow) { root.highlighted = max(0, root.highlighted - 1); menu-focus.reveal-bin(); return accept; }
                if (event.text == Key.DownArrow) { root.highlighted = min(root.bins.length, root.highlighted + 1); menu-focus.reveal-bin(); return accept; }
                if (event.text == Key.Return) { root.choose-target(root.highlighted); return accept; }
                return accept;
            }
            Rectangle {
                background: Palette.bg2;
                border-width: 1px;
                border-color: Palette.bg3;
                border-radius: UiMetrics.radius;
                bin-scroll := Flickable {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    content-height: (root.bins.length + 1) * UiMetrics.control-height;
                    content-width: self.width;
                    content-y: 0px;
                    interactive: true;
                    VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: UiMetrics.control-height;
                            border-radius: 3px;
                            background: root.highlighted == 0 || all-touch.has-hover ? Palette.accent-muted : transparent;
                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                text: root.moving ? "Unsorted" : "All media";
                                color: root.current-bin == "" ? Palette.accent : Palette.text-primary;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            all-touch := LiveTouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.choose-target(0); }
                            }
                        }
                        for bin[index] in root.bins: Rectangle {
                            height: UiMetrics.control-height;
                            border-radius: 3px;
                            background: root.highlighted == index + 1 || bin-touch.has-hover ? Palette.accent-muted : transparent;
                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                text: bin;
                                color: root.current-bin == bin ? Palette.accent : Palette.text-primary;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            bin-touch := LiveTouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.choose-target(index + 1); }
                            }
                        }
                    }
                }
            }
        }
    }

    new-bin-menu := PopupWindow {
        x: max(8px - root.absolute-position.x, min(root.anchor-x - root.absolute-position.x, root.window-width - root.absolute-position.x - self.width - 8px));
        y: root.anchor-y + UiMetrics.control-height + self.height + 4px <= root.window-height - 8px ? root.anchor-y - root.absolute-position.y + UiMetrics.control-height + 4px : max(8px - root.absolute-position.y, root.anchor-y - root.absolute-position.y - self.height - 4px);
        width: min(max(root.width, 270px), root.window-width - 16px);
        height: 124px;
        close-policy: no-auto-close;
        forward-focus: new-name-input;
        Timer {
            interval: 1ms;
            triggered => { self.running = false; new-name-input.focus(); }
        }
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) { new-bin-menu.close(); return accept; }
                return reject;
            }
        Rectangle {
            background: Palette.bg2;
            border-width: 1px;
            border-color: Palette.bg3;
            border-radius: UiMetrics.radius;
            VerticalLayout {
                padding: 10px;
                spacing: UiMetrics.space-sm;
                HorizontalLayout {
                    spacing: UiMetrics.space-sm;
                    Text {
                        text: "New bin · use / for a folder path";
                        color: Palette.text-secondary;
                        font-size: UiMetrics.control-font;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    OrganizerButton {
                        width: UiMetrics.control-height;
                        height: UiMetrics.control-height;
                        label: "×";
                        clicked => { new-bin-menu.close(); }
                    }
                }
                HorizontalLayout {
                    spacing: UiMetrics.space-sm;
                    Rectangle {
                        horizontal-stretch: 1;
                        border-width: 1px;
                        border-color: new-name-input.has-focus ? Palette.accent : Palette.bg3;
                        border-radius: UiMetrics.radius;
                        background: Palette.bg0;
                        new-name-input := TextInput {
                Timer { interval: 150ms; running: new-name-input.has-focus; triggered => { LiveFocus.heartbeat(); } }
                property <bool> live-focus-counted: false;
                            changed has-focus => { if (self.has-focus != self.live-focus-counted) { self.live-focus-counted = self.has-focus; if (self.has-focus) { LiveFocus.input-gained(); } else { LiveFocus.input-lost(); } } }
                            x: 7px;
                            width: parent.width - 14px;
                            height: 100%;
                            text <=> root.new-name;
                            color: Palette.text-primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.submit-new-bin(); }
                        }
                    }
                    OrganizerButton {
                        width: 70px;
                        label: "Create";
                        enabled: root.new-name != "";
                        clicked => { root.submit-new-bin(); }
                    }
                }
                Text {
                    text: "Esc cancels";
                    color: Palette.text-secondary;
                    font-size: 10px;
                }
            }
        }
        }
    }
}
