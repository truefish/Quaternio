// FocusOut is not guaranteed when Slint 1.8 destroys a popup/subtree.
// Focused controls renew a short lease; destroyed controls stop renewing it.
export global LiveFocus {
    out property <int> input-count: 0;
    out property <int> lease-ticks: 0;
    out property <bool> active: self.input-count > 0 || self.lease-ticks > 0;
    public function heartbeat() { self.lease-ticks = 4; self.input-count = max(1, self.input-count); }
    public function input-gained() { self.input-count += 1; self.lease-ticks = 4; }
    public function input-lost() { self.input-count = max(0, self.input-count - 1); }
    public function sweep() {
        self.lease-ticks = max(0, self.lease-ticks - 1);
        if (self.lease-ticks == 0) { self.input-count = 0; }
    }
}

// A stationary held pointer remains an interaction even without move events.
// On Wayland + software renderer, pointer-up can be delayed or dropped; keep a
// short stuck-press watchdog so LiveFocus / button chrome recover quickly.
export component LiveTouchArea inherits TouchArea {
    // Prefer this for button backgrounds — clears even when TouchArea.pressed sticks.
    out property <bool> show-pressed: root.pressed && !root.force-cleared;
    property <bool> live-press-counted: false;
    property <int> stuck-ticks: 0;
    property <bool> force-cleared: false;
    changed pressed => {
        if (self.pressed != self.live-press-counted) {
            self.live-press-counted = self.pressed;
            self.stuck-ticks = 0;
            if (self.pressed) {
                self.force-cleared = false;
                LiveFocus.input-gained();
            } else {
                self.force-cleared = false;
                LiveFocus.input-lost();
            }
        }
    }
    pointer-event(event) => {
        if (event.kind == PointerEventKind.cancel && root.live-press-counted) {
            root.live-press-counted = false;
            root.stuck-ticks = 0;
            root.force-cleared = true;
            LiveFocus.input-lost();
        }
    }
    // ~1.2s stuck watchdog (8 × 150ms). Longer holds keep the lease via heartbeat.
    Timer { interval: 150ms; running: root.pressed && !root.force-cleared; triggered => {
        LiveFocus.heartbeat();
        root.stuck-ticks += 1;
        if (root.stuck-ticks >= 8) {
            root.live-press-counted = false;
            root.stuck-ticks = 0;
            root.force-cleared = true;
            LiveFocus.input-lost();
        }
    } }
}
